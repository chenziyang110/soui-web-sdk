'use strict';
// Filesystem-only checks. Original native records are read; no native execution.
const fs=require('node:fs'),path=require('node:path'),assert=require('node:assert/strict'),crypto=require('node:crypto');
const e=require('./toolchain-evidence.cjs'),sha=b=>crypto.createHash('sha256').update(b).digest('hex');
const frozen=JSON.parse(fs.readFileSync(path.join(__dirname,'frozen-inputs-final.json'))),results=[];
const check=(name,body)=>{body();results.push({name,passed:true});console.log('PASS '+name);};
check('all473 prior indexed payloads remain byte exact',()=>{
  assert.equal(frozen.prior.payloadFiles.length,473);for(const row of frozen.prior.payloadFiles)e.verify(row);
});
check('source16 and copied reviewed snapshots remain unchanged',()=>{
  const reviewed=JSON.parse(fs.readFileSync(path.join(__dirname,'reviewed-inputs.json')));
  assert.equal(reviewed.files.length,16);
  for(const row of reviewed.files){assert.equal(e.record(row.original).sha256,row.sha256);
    assert.equal(e.record(path.join(__dirname,row.snapshot)).sha256,row.sha256);}
});
check('two prior compiler roots remain genericfalse124 with exact identities',()=>{
  assert.equal(frozen.prior.phases.length,2);
  for(const p of frozen.prior.phases){e.assertContinuation(p,frozen,true);assert.equal(p.summary.passed,false);assert.equal(p.summary.supervisorExitCode,124);}
});
check('old tails cannot be accepted as naturally closed evaluations or tests',()=>{
  for(const p of frozen.prior.phases)assert.throws(()=>e.assertContinuation(p,frozen,false));
});
const cls=JSON.parse(fs.readFileSync(path.join(__dirname,'prior-read-classification.json')));
check('all41 read tlogs and585 unique reads are explicitly classified',()=>{
  assert.equal(cls.readTlogs.length,41);assert.equal(cls.readReferences,6586);assert.equal(cls.uniqueReads,585);
  assert.equal(cls.actualReadFiles.filter(r=>r.classification==='prelaunch-bound').length,527);
  assert.equal(cls.actualReadFiles.filter(r=>r.classification==='generated-in-owned-attempt').length,41);
  assert.equal(cls.postObservedInputs.length,17);
});
check('wke header binds its actual original whole-raw-source pin',()=>{
  const row=cls.actualReadFiles.find(r=>/miniblink[\\/]wke\.h$/i.test(r.path));assert(row);
  assert.equal(row.classification,'prelaunch-bound');
  const pin=frozen.prior.prelaunchRows.find(p=>e.canonical(p.path)===e.canonical(row.path));assert(pin);
  assert.equal(pin.sha256,'8b090aafeee71f1571f3c07b7d8625570506720dabc20abaf4faf607166bcd54');
});
check('four selected external inputs stay post-observed despite future pins',()=>{
  assert.equal(cls.selectedProjectPostObservedInputs.length,4);
  for(const row of cls.selectedProjectPostObservedInputs){assert.equal(row.prelaunchBound,false);
    assert(frozen.futureReadPins.some(pin=>e.canonical(pin.path)===e.canonical(row.path)));}
  assert.equal(cls.allReadInputsPrelaunchBound,false);assert.equal(cls.sourceReadFullyPrelaunchBound,false);
});
check('thirteen VCPKG libraries are configure-probe-only observations',()=>{
  assert.equal(cls.configureProbeOnlyPostObservedInputs.length,13);
  for(const row of cls.configureProbeOnlyPostObservedInputs){assert(/vcpkg[\\/]installed/i.test(row.path));
    assert(row.referencedBy.every(p=>p.scope==='configure-probe'));assert.equal(row.prelaunchBound,false);}
});
check('nineteen future pins are finite exact files without folder admission',()=>{
  assert.equal(frozen.futureReadPins.length,19);
  for(const row of frozen.futureReadPins){assert(fs.statSync(row.path).isFile());e.verify(row);assert(row.purpose);}
});
check('all12 actual x64 projects and11PE plus staticSDK were only read',()=>{
  const p=JSON.parse(fs.readFileSync(path.join(__dirname,'prior-x64-output-toolchain-readonly.json')));
  assert.equal(p.projects.length,12);assert.equal(p.projects.filter(r=>r.output.coffMachine===0x8664).length,11);
  for(const row of p.generated)e.verify(row);
});
check('qualification and source/tool closure cannot turn green',()=>{
  assert.equal(frozen.qualificationPassed,false);assert.equal(frozen.sourceReadFullyPrelaunchBound,false);
  assert.equal(frozen.compilerTailAcceptance,false);assert.equal(frozen.prior.priorValidationPassed,false);
  const driver=fs.readFileSync(path.join(__dirname,'driver.cjs'),'utf8');
  assert(driver.includes('qualificationPassed:false,sourceReadFullyPrelaunchBound:false'));
  assert(driver.includes("records = prepared.prior.phases.map"));
  assert(driver.includes('copyCtestDefinitions(build,testDirectory)'));
});
check('timeout STOP and numericFILETIME cannot be accepted by continuation',()=>{
  for(const update of [p=>p.summary.stopRequested=true,p=>p.summary.exitCode=124,
      p=>p.summary.creationFileTime=Number(p.summary.creationFileTime)]){
    const p=structuredClone(frozen.prior.phases[0]);update(p);assert.throws(()=>e.assertContinuation(p,frozen,true));}
});
const result={schema:'soui.family-compact-preparation-check/v1',checks:results.length,passed:results.length,results,
  priorIndexSha256:frozen.prior.originalIndexSha256,oldPayloadUnchanged:473,source16Unchanged:true,
  newBuildExecuted:false,newNativeExecuted:false,qualificationPassed:false,sourceReadFullyPrelaunchBound:false,
  originalFalseResultsNotRewritten:true};
fs.writeFileSync(path.join(__dirname,'check-preparation-results.json'),JSON.stringify(result,null,2)+'\n',{flag:'wx'});
console.log(JSON.stringify(result));
