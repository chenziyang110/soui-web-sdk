}
const mappings = [];
function copy(file, relativeName, category) {
  const b = read(file), privateBinlog = /\.binlog(?:\.inert\.snapshot)?$/i.test(relativeName);
  const compiledName = /^b-(?:x64|x86)\//.test(relativeName) && /\.(?:exe|dll|obj|lib|pdb|pch|idb|ilk|res|bin|ipdb|iobj|exp)(?:\.inert\.snapshot)?$/i.test(relativeName);
  const magic = binaryMagic(b);
  const item = {originalPath: file, originalRelativePath: relativeName, bytes: b.length, sha256: hash(b), category};
  if (privateBinlog || compiledName || magic) {
    mappings.push({...item, disposition: privateBinlog ? 'private-msbuild-binlog-hash-only' : 'private-compiled-or-binary-hash-only',
      ...(magic ? {binaryMagic: magic} : {})}); return;
  }
  const inert = /^b-(?:x64|x86)\//.test(relativeName) || /\.(?:cjs|js|ps1|cmd|bat|cpp|h|hpp|cmake|vcxproj|filters|tlog)$/i.test(relativeName);
  const name = 'raw/' + String(mappings.length).padStart(5, '0') + '-' + path.basename(relativeName) +
    (inert && !relativeName.endsWith('.inert.snapshot') ? '.inert.snapshot' : '');
  write(bounded(archive, name), b); mappings.push({...item, archivePath: name, disposition: 'byte-exact-copy'});
}
async function main() {
  assert(!fs.existsSync(archive), 'Archive already exists; no overwrite');
  const verified = verifyOriginal(); write(path.join(__dirname, 'original-review.json'), verified.proof);
  const auditResult = await audit(); verifyOriginal();
  fs.mkdirSync(archive); safe(archive);
  for (const item of verified.index.files) copy(bounded(original, item.path), item.path, 'original-native-evidence');
  copy(path.join(original, 'index.json'), 'index.json', 'original-complete-index');
  copy(rootProof, path.basename(rootProof), 'Root-independent-execution-proof');
  for (const item of scan(auditResult.directory)) copy(bounded(auditResult.directory, item.path), 'audit/' + item.path, 'actual-sdk-web-dependency-audit');
  copy(path.join(__dirname, 'original-review.json'), 'original-review.json', 'archivist-byte-execution-proof');
  copy(__filename, 'archive.cjs', 'archive-driver-source');
  copy(path.join(__dirname, 'verify.cjs'), 'verify.cjs', 'archive-readonly-verifier-source');
  write(path.join(archive, 'byte-exact-map.json'), {schema: 'soui.local-dispatch-byte-exact-map/v1', originalDirectory: original,
    originalIndexSha256: expected.index, records: mappings, releaseReady: false});
  const omitted = mappings.filter(x => x.disposition !== 'byte-exact-copy');
  write(path.join(archive, 'private-artifacts.json'), {schema: 'soui.local-dispatch-private-artifacts/v1', files: omitted,
    actualOutputs: verified.results.outputs, externalToolInputs: verified.frozen.tools, compiledBytesPublished: false,
    externalVendorPePublished: false, binlogBodyPublished: false, binlogCredentialScanClaimed: false, releaseReady: false});
  const summary = {...verified.proof, schema: 'soui.local-dispatch-persistent-archive/v1', frozenInputsSha256: expected.frozen,
    resultsSha256: expected.results, allOriginalJobsNatural: true, audit: auditResult.summary,
    copiedOriginalFiles: mappings.filter(x => x.category === 'original-native-evidence' && x.archivePath).length,
    hashOnlyPrivateFiles: omitted.length, architectures: ['x64', 'x86'], configuration: 'Release',
    noPipeValidation: true, noGuiValidation: true, noOsIdentityValidation: true, noEightHourValidation: true,
    noFullCollectValidation: true, noNewOsMatrixValidation: true, releaseReady: false};
  write(path.join(archive, 'archive-summary.json'), summary);
  const readme = `# 0.5 本地 typed action 派发：本机双架构证据\n\n本目录记录当前 Windows 11 主机的 Release x64/x86 静态 SDK 与所选原生回归。它验证 C++ 派发边界，不表示 pipe/gateway、Windows 主体认证、GUI/UIA、Win7/PE、8 小时运行、完整 Test/Collect 或正式发布完成，releaseReady=false。\n\n原始目录为 out/dispatch-native-2358a5e1-49f1-420b-bac4-adff8aead6e0。原始索引 ${expected.index} 包含 ${verified.index.files.length} 项；冻结输入 SHA ${expected.frozen}，${verified.frozen.actualInputs.files.length} 项实际输入指纹 ${expected.nativeInputs}，规范化源码 ${expected.source}，原始源码 ${expected.raw}。${verified.proof.jobs.length} 次 configure/compile/CTest/direct-cases Job 均 root/supervisor exit 0、generic=true、natural completed、closureConfirmed=true、activeProcesses=0，没有套用尾进程例外。每架构实际 CTest ${verified.results.selectedTestsPerArchitecture}/${verified.results.selectedTestsPerArchitecture}，直接派发 ${verified.results.localDispatchCasesPerArchitecture}/${verified.results.localDispatchCasesPerArchitecture} 个命名 case；${verified.results.outputs.length} 项实际产物由路径/大小/SHA绑定，其中 ${verified.proof.peFiles} EXE 已核对 COFF，${verified.proof.staticLibraries} 项为静态 SDK LIB。实际 SDK19041/v143 14.44.35207 编译路径保留在 cache/vcxproj/compiler/tlog 原件中。\n\n默认所有动作不向本地开放；只有应用明确审核的 typed action 能被原生标记，实际连接的 method 与 capability 均须允许。发现先过滤再分页，保留 canonical bridge.describe 的固定只读路径；内建 plain task.start/query/cancel 不能标记或转换，renew/subscribe 控制不开放。真实 binding 和 scope 对象不能由 wire 字符串替代，gesture=false，业务错误文本不向本地返回。关闭/撤销/过期后丢弃迟到结果不表示 handler 副作用回滚或 I/O 屏障；实际端点仍须 owner executor/generation/发送边界重验和精确资源清理。受控时钟与 TEST_ONLY 固定熵只证明策略和 bearer 复用边界，不证明长期运行或 OS 连接身份。\n\n额外一次真正 Node npm CLI 执行 npm --prefix sdk/web audit --json，显式公共 registry、ignore-scripts、空 user/global npm config、子环境 allowlist 并移除 credential-like 名称，未安装/更新依赖，没有 Node/TypeScript 编译声明。实际审计 root=${auditResult.summary.rootExitCode}、supervisor=${auditResult.summary.supervisorExitCode}、generic=${auditResult.summary.genericPassed}、natural=${auditResult.summary.naturalClosure}、vulnerabilities.total=${auditResult.summary.vulnerabilities?.total ?? 'unavailable'}、auditAccepted=${auditResult.summary.auditAccepted}；完整输入/锁/工具散列、原始输出与独立 Job 在 byte-exact-map 中的 audit 类别。没有把失败审计改写为成功。\n\nbyte-exact-map.json 逐项记录原路径、大小、SHA、复制路径或 hash-only 处置；index.json 只索引此公开目录实际文件，不含自身。归档中的完整原 index 仍包含未复制的私有路径，不能将它们误认为公开载荷。所有脚本、源码与生成 CMake/cache/vcxproj/tlog 均为 inert 快照，原字节和换行未改；flat raw 编号防止 Windows 长路径。EXE/DLL/COFF/OBJ/LIB/PDB 等、外部真实 vendor PE 与 MSBuild binlog 正文只留私有原路径/大小/SHA，见 private-artifacts.json；重命名为 inert 也不能绕过二进制 magic 检查。未声称重复扫描 binlog 中的凭据。\n\n原14组测试由归档者编写，Root 与 Deps 已独立复核其设计；本目录归档者结论针对实际执行、输入输出身份和归档字节，不作自我批准。SHA/路径绑定只发现意外不一致，不认证可重写整包的同权限用户。原件不覆盖，canonical acceptance 未写。\n`;
  write(path.join(archive, 'README.md'), Buffer.from(readme)); verifyOriginal();
  const files = scan(archive); assert(files.every(x => !binaryMagic(check(bounded(archive, x.path), x))));
  write(path.join(archive, 'index.json'), {schema: 'soui.local-dispatch-persistent-file-index/v1', files,
    bytes: files.reduce((n, f) => n + f.bytes, 0), releaseReady: false});
  const completion = {archive, indexSha256: hash(read(path.join(archive, 'index.json'))), indexedFiles: files.length,
    indexedBytes: files.reduce((n, f) => n + f.bytes, 0), mappingRecords: mappings.length, hashOnlyPrivateFiles: omitted.length,
    originalIndexSha256: expected.index, sourceUnchanged: true, originalAllIndexedFilesUnchanged: true, audit: auditResult.summary};
  write(path.join(__dirname, 'completion.json'), completion); console.log(JSON.stringify(completion, null, 2));
}
module.exports = {root, original, archive, expected, hash, read, json, check, bounded, scan, binaryMagic, verifyOriginal, native};
if (require.main === module) main().catch(e => { console.error(e.stack); process.exitCode = 1; });
