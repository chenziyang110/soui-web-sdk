function verifyOriginal() {
  const indexBytes = read(path.join(original, 'index.json')), frozenBytes = read(path.join(original, 'frozen-inputs.json')),
    resultBytes = read(path.join(original, 'results.json'));
  assert.equal(hash(indexBytes), expected.index); assert.equal(hash(frozenBytes), expected.frozen); assert.equal(hash(resultBytes), expected.results);
  const index = JSON.parse(indexBytes), frozen = JSON.parse(frozenBytes), results = JSON.parse(resultBytes);
  const paths = new Set(); for (const item of index.files) {
    assert(!paths.has(item.path.toLowerCase()), 'Duplicate original'); paths.add(item.path.toLowerCase());
    const file = bounded(original, item.path); assert(same(fs.realpathSync.native(file), item.resolvedPath)); check(file, item);
  }
  const identity = require(path.join(root, 'tools/internal/delivery-identity.cjs'));
