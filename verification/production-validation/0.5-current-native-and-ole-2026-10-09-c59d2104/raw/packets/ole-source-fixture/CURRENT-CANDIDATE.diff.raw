@@ -158,6 +158,17 @@ struct application final {
             if (diagnostics_before_close.size() > 4096) diagnostics_before_close.resize(4096);
           }
         } catch (...) { diagnostics_before_close = "diagnostic-call-threw"; }
+      } else {
+        char diagnostic_option[2]{};
+        if (GetEnvironmentVariableA("SOUI_DIAGNOSTIC_SCRIPT", diagnostic_option,
+            sizeof(diagnostic_option)) == 1 && diagnostic_option[0] == '1') {
+          // Successful opt-in subjects observe the real OLE/vendor ledger before teardown too.
+          try {
+            document_before_close = host && host->document_ready();
+            diagnostics_before_close = host ? host->application_diagnostics() : "host-absent";
+            if (diagnostics_before_close.size() > 4096) diagnostics_before_close.resize(4096);
+          } catch (...) { diagnostics_before_close = "diagnostic-call-threw"; }
+        }
       }
       close();
     }
