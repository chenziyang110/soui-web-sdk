cmake_minimum_required(VERSION 3.24)
project(TaskOperationQueryValidation LANGUAGES C CXX)
add_subdirectory("F:/work/sm05-query/sdk" sdk)
add_executable(task_operation_query_tests "F:/work/sm05-query/tests/native/task_operation_query_tests.cpp")
target_link_libraries(task_operation_query_tests PRIVATE Soui::Sdk)
target_compile_features(task_operation_query_tests PRIVATE cxx_std_17)
target_include_directories(task_operation_query_tests PRIVATE "F:/work/sm05-query/third_party/include/json")
target_compile_options(task_operation_query_tests PRIVATE /utf-8 /W4 /U_DEBUG)
set_property(TARGET task_operation_query_tests PROPERTY MSVC_RUNTIME_LIBRARY MultiThreadedDLL)
