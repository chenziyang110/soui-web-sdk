const archive = path.join(root, 'verification/production-validation/0.5-engine-startup-2026-10-09');
const early = path.join(root, 'out/engine-startup-validation-51a281f5-10ee-4e7a-a94d-166228f6f709');
const prepared = path.join(root, 'out/engine-startup-sdk-validation-b5312436-e181-415a-8b79-f22ca568d329');
const continuation = path.join(root, 'out/engine-startup-continuation-7e151d3f-4976-49af-a4cc-e68831db35c6');
const first = path.join(prepared, 'actual-3e8b84ec-c0cd-427c-8a54-e1a79fdfb6ed');
