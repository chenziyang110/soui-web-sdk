   const linkText=linkCommands[0].text,sdkArchive=contract.producer.archive,sdkTokens=[...linkText.matchAll(/"([^"]+\.lib)"|(?:^|\s)([A-Za-z]:[\\/][^\s"]+\.lib)(?=\s|$)/gi)].map(value=>value[1]||value[2]).filter(value=>path.basename(value).toLowerCase()==='soui_sdk.lib');
   const mapFile=path.join(build,'reference-agent-Release.map'),mapTokens=[...linkText.matchAll(/\/map:(?:"([^"]+)"|([^\s"]+))/gi)].map(value=>value[1]||value[2]);
   if(sdkTokens.length!==1||normalize(sdkTokens[0])!==normalize(sdkArchive.path)||mapTokens.length!==1||normalize(mapTokens[0])!==normalize(mapFile))throw Error('Unique actual pinned SDK LINK input/fresh MAP path missing');
   pin(sdkArchive);for(const object of contract.producer.sdkObjects)pin(object);
   const mapPin={path:mapFile,bytes:fs.statSync(mapFile).size,sha256:digest(mapFile)},mapText=fs.readFileSync(mapFile,'utf8'),mapLines=mapText.split(/\r?\n/),sdkObjects=new Map(contract.producer.sdkObjects.map(object=>[path.basename(object.path).toLowerCase(),object]));
   const headers=mapLines.flatMap((line,index)=>/^\s*Address\s+Publics by Value\s+Rva\+Base\s+Lib:Object\s*$/.test(line)?[index]:[]);
   if(headers.length!==1)throw Error('Unique actual MAP Publics header missing');
   const members=new Set(),required=new Map();let sdkPublicRowCount=0;
   for(let index=headers[0]+1;index<mapLines.length;index++){
    const line=mapLines[index];if(/^\s*(?:entry point at|Static symbols)\b/i.test(line))break;
    const row=/^\s*([0-9a-f]{4}):([0-9a-f]{8,16})\s+(\S+)\s+([0-9a-f]{8,16})(?:\s+[fi])*\s+(\S+)\s*$/i.exec(line);if(!row)continue;
    const module=/^soui_sdk(?:\.lib)?:([^:\s]+\.obj)$/i.exec(row[5]);if(!module)continue;
    const member=module[1].toLowerCase(),object=sdkObjects.get(member);if(!object)throw Error('MAP SDK member does not match a pinned normal producer object');
    ++sdkPublicRowCount;members.add(member);
    const type=member==='json_bridge.obj'?'json_bridge':member==='windows_local_endpoint.obj'?'windows_local_endpoint':null;
    if(type&&row[3].includes(type)&&!required.has(type))required.set(type,{line,index,section:row[1],offset:row[2],symbol:row[3],rvaPlusBase:row[4],module:row[5],producerObject:object});
   }
   if(required.size!==2)throw Error('Actual MAP did not define both Bridge and endpoint symbols from pinned SDK members');
   pin(sdkArchive);for(const object of contract.producer.sdkObjects)pin(object);pin(mapPin);
   const sdkMapObservation={map:mapPin,linkCommand:path.join(path.dirname(linkReads[0]),path.basename(linkCommands[0].path)),sdkArchive,normalProducerObjects:24,sdkPublicRowCount,members:[...members].sort(),requiredDefinitions:[...required.values()],wholeSdkArchiveReadByTlog:linkInputs.includes(normalize(sdkArchive.path)),finiteContributionOnly:true,completeCompilerInputBinding:false};
   const executable=exes[0],pe=require('./pe-exports.cjs').inspect(executable);
   if(pe.dll||pe.machine!==(a['--arch']==='x64'?0x8664:0x14c))throw Error('Actual EXE machine mismatch');
   const artifacts=files.filter(file=>/\.(obj|pch|lib|exe|pdb|tlog|vcxproj|cmake|txt|map)$/i.test(file)).map(file=>({path:file,bytes:fs.statSync(file).size,sha256:digest(file)}));
   json(path.join(output,'actual-build-bindings.json'),{artifacts,commands,linkCommands,linkReads,linkInputs,builtArchives,builtAgentArchives,sdkMapObservation,installedSdk:contract.producer.archive,producer:contract.producer,pe,normalSdkCppCount:24,normalSdkRecompiled:false,completeCompilerInputBinding:false,qualificationPassed:false});
   await run('registry',tools.ctest.path,['--test-dir',build,'-C','Release','--show-only=json-v1'],45000);
   const registry=JSON.parse(fs.readFileSync(path.join(output,'registry.stdout.raw'),'utf8'));
   if(JSON.stringify(registry.tests.map(p=>p.name).sort())!==JSON.stringify(packet.cases.map(p=>'reference.agent.'+p).sort()))throw Error('Exact CTest8 set changed');
   for(const test of registry.tests){const name=test.name.slice('reference.agent.'.length);if(!Array.isArray(test.command)||test.command.length!==3||normalize(test.command[0])!==normalize(executable)||test.command[1]!==name||typeof test.command[2]!=='string'||normalize(test.command[2])!==normalize(path.join(reference,'common/fixture.json'))||test.properties.find(p=>p.name==='TIMEOUT')?.value!==20||test.properties.some(p=>p.name==='WILL_FAIL'&&p.value===true))throw Error('Registry exact args/timeout changed');}
   const receipts=[];
   for(const name of ['selected-peer']){
    for(const p of artifacts)pin(p);
    const identity=await run('case-'+name,executable,[name,path.join(reference,'common/fixture.json')],20000);
    const text=fs.readFileSync(path.join(output,'case-'+name+'.stdout.raw'),'utf8');if(!text.endsWith('\n')||text.trimEnd().split(/\r?\n/).length!==1||identity.stderr.bytes!==0)throw Error('Unique native receipt required');
    const receipt=JSON.parse(text.trim());if(JSON.stringify(Object.keys(receipt).sort())!==JSON.stringify(['case','children','creationFileTime','guiReadyVerified','passed','pid','qualificationPassed','releaseReady','schema'].sort())||receipt.schema!=='soui.reference-agent-native/1'||receipt.case!==name||receipt.passed!==true||typeof receipt.pid!=='string'||receipt.pid!==String(identity.pid)||typeof receipt.creationFileTime!=='string'||receipt.creationFileTime!==identity.creationFileTime||receipt.guiReadyVerified!==false||receipt.qualificationPassed!==false||receipt.releaseReady!==false)throw Error('Actual post-join receipt/Owned identity mismatch');
    const modes=packet.expectedChildModes[name],children=receipt.children,ownedRows=fs.readFileSync(identity.rawJob,'utf8').trimEnd().split('\n').map(JSON.parse),seen=new Set(),childBindings=[];
    if(!Array.isArray(modes)||!Array.isArray(children)||children.length!==modes.length||identity.terminal.totalProcesses<children.length+1)throw Error('Actual child count/Owned process-tree accounting mismatch');
    for(let i=0;i<children.length;i++){
     const child=children[i];
     if(JSON.stringify(Object.keys(child).sort())!==JSON.stringify(['mode','pid','creationFileTime','exitCode','jobAssigned','rawReceipt'].sort())||child.mode!==modes[i]||typeof child.pid!=='string'||! /^[1-9]\d{0,9}$/.test(child.pid)||Number(child.pid)>0xffffffff||child.pid===receipt.pid||seen.has(child.pid)||typeof child.creationFileTime!=='string'||! /^[1-9]\d{0,19}$/.test(child.creationFileTime)||child.exitCode!==0||child.jobAssigned!==true||typeof child.rawReceipt!=='string'||Buffer.byteLength(child.rawReceipt)>8192||!child.rawReceipt.endsWith('\n')||child.rawReceipt.trimEnd().split(/\r?\n/).length!==1)throw Error('Actual child identity/closed receipt mismatch');
     seen.add(child.pid);const rawChild=JSON.parse(child.rawReceipt.trim());
     if(JSON.stringify(Object.keys(rawChild).sort())!==JSON.stringify(['pid','creationFileTime','payload'].sort())||rawChild.pid!==child.pid||rawChild.creationFileTime!==child.creationFileTime||!rawChild.payload||typeof rawChild.payload!=='object'||Array.isArray(rawChild.payload))throw Error('Raw child/held native identity mismatch');
     const members=ownedRows.filter(row=>row.event==='owned-member'&&String(row.pid)===child.pid);
     if(members.some(row=>row.creationFileTime!==child.creationFileTime||normalize(row.image)!==normalize(executable)))throw Error('Observed Owned child identity/image mismatch');
     childBindings.push({pid:child.pid,creationFileTime:child.creationFileTime,rawReceiptSha256:sha(Buffer.from(child.rawReceipt)),heldNativeProcessExited:true,inheritedAssignedRootJob:true,ownedMemberObserved:members.length>0});
    }
    receipts.push({name,receipt,identity,childBindings});
   }
   throw Error('RED unexpectedly admitted a listener; original failure was not reproduced');
   await run('ctest-eight',tools.ctest.path,['--test-dir',build,'-C','Release','--output-on-failure','--no-tests=error','-j','1','--timeout','20','--output-junit',path.join(output,'ctest.junit.xml')],180000);
   const junit=fs.readFileSync(path.join(output,'ctest.junit.xml'),'utf8');if(!/<testsuite\b/.test(junit)||/<(?:failure|error|skipped)\b/.test(junit)||JSON.stringify([...junit.matchAll(/<testcase\b[^>]*name="([^"]+)"/g)].map(m=>m[1]).sort())!==JSON.stringify(packet.cases.map(p=>'reference.agent.'+p).sort()))throw Error('Exact successful JUnit8 required');
   for(const p of artifacts)pin(p);sourceCheck();packageCheck();toolCheck();producerCheck();
   json(path.join(output,'summary.json'),{completed:true,mode:'native',architecture:a['--arch'],stages,receipts,directCases:8,registeredCTestCases:8,normalSdkCppCount:24,normalSdkRecompiled:false,installedSdkProducer:'actual-native-v10',actualAgentCandidateBytes:true,guiReadyVerified:false,realBridgeJoinBeforeReceipt:true,sdkGuiControllerRuntimeExercised:false,rendererExercised:false,allGenericPassed:stages.every(p=>p.genericPassed),qualificationPassed:false,releaseReady:false});
   if(stages.some(p=>p.genericPassed!==true))process.exitCode=1;
  console.log(JSON.stringify({completed:true,mode:a['--mode'],output,qualificationPassed:false,releaseReady:false}));
 }catch(error){json(path.join(output,'summary-failed.json'),{completed:false,mode:a['--mode'],architecture:a['--arch'],stages,error:error.message,qualificationPassed:false,releaseReady:false});throw error;}
}
main().catch(error=>{console.error(error.message);process.exitCode=1;});
