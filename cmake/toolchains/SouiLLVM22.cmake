# SOURCE DRAFT: explicit LLVM22MSVC142; the normal entry does not select this file yet.
# Use only with a fresh, separately supervised Ninja Multi-Config build tree.
if(CMAKE_VERSION VERSION_LESS 3.29 OR NOT CMAKE_HOST_WIN32)
    message(FATAL_ERROR "LLVM22MSVC142 requires CMake >= 3.29 on Windows")
endif()

function(_soui_llvm_path input kind output)
    if(NOT IS_ABSOLUTE "${input}" OR "${input}" MATCHES "[;\"\n\r\t]")
        message(FATAL_ERROR "LLVM profile requires an absolute local path: ${input}")
    endif()
    file(TO_CMAKE_PATH "${input}" path)
    cmake_path(NORMAL_PATH path)
    if(NOT path MATCHES "^[A-Za-z]:/")
        message(FATAL_ERROR "LLVM profile requires a local drive path: ${path}")
    endif()
    if(NOT EXISTS "${path}" OR (kind STREQUAL "FILE" AND IS_DIRECTORY "${path}")
            OR (kind STREQUAL "DIRECTORY" AND NOT IS_DIRECTORY "${path}"))
        message(FATAL_ERROR "LLVM profile missing ${kind}: ${path}")
    endif()
    set(cursor "${path}")
    while(TRUE)
        if(IS_SYMLINK "${cursor}")
            message(FATAL_ERROR "LLVM profile refuses a symbolic link: ${cursor}")
        endif()
        cmake_path(GET cursor PARENT_PATH parent)
        if(parent STREQUAL cursor OR parent STREQUAL "")
            break()
        endif()
        set(cursor "${parent}")
    endwhile()
    # Full Windows reparse-point checks are the Finder / owned guard's responsibility.
    set(${output} "${path}" PARENT_SCOPE)
endfunction()

# Only these declared tool FILEPATH slots admit a proven physical alias.
# Input roots, requested paths, flags, scalar identity and generated hooks stay textual.
set(_soui_tool_filepath_slots CMAKE_C_COMPILER CMAKE_CXX_COMPILER CMAKE_LINKER
    CMAKE_LINKER_LLD CMAKE_AR CMAKE_RC_COMPILER CMAKE_MT CMAKE_MAKE_PROGRAM)

function(_soui_llvm_bridge_inputs output)
    set(lines "soui.llvm-tool-bridge-inputs/v1\n${SOUI_TOOL_IDENTITY_POWERSHELL_EXECUTABLE}\n${SOUI_TOOL_IDENTITY_BRIDGE}\n${SOUI_TOOL_IDENTITY_HELPER}")
    set(pins "")
    foreach(path IN ITEMS "${SOUI_TOOL_IDENTITY_POWERSHELL_EXECUTABLE}" "${SOUI_TOOL_IDENTITY_BRIDGE}" "${SOUI_TOOL_IDENTITY_HELPER}")
        _soui_llvm_path("${path}" FILE checked)
        file(SIZE "${checked}" bytes)
        file(SHA256 "${checked}" sha)
        string(APPEND lines "\n${checked}|${bytes}|${sha}")
        list(APPEND pins "${checked}|${bytes}|${sha}")
    endforeach()
    string(SHA256 digest "${lines}")
    set(${output} "${digest}" PARENT_SCOPE)
    set(_soui_verified_bridge_pins "${pins}" PARENT_SCOPE)
endfunction()

function(_soui_llvm_assert_tool_path name observed expected)
    if(NOT name IN_LIST _soui_tool_filepath_slots)
        message(FATAL_ERROR "LLVM physical alias is not declared for ${name}")
    endif()
    if("${observed}" STREQUAL "${expected}")
        return()
    endif()
    _soui_llvm_path("${observed}" FILE checked_observed)
    _soui_llvm_path("${expected}" FILE checked_expected)
    _soui_llvm_bridge_inputs(current_bridge)
    if(NOT current_bridge STREQUAL SOUI_LLVM_BRIDGE_IDENTITY)
        message(FATAL_ERROR "LLVM file identity bridge inputs changed")
    endif()
    # These tool bytes/SHA came from the input scan whose whole digest was accepted.
    # Do not rebaseline an expected tool that changed after that scan.
    set(found FALSE)
    foreach(pin IN LISTS _soui_verified_tool_pins)
        string(REPLACE "|" ";" fields "${pin}")
        list(GET fields 0 path)
        if(path STREQUAL checked_expected)
            list(GET fields 1 bytes)
            list(GET fields 2 sha)
            set(found TRUE)
        endif()
    endforeach()
    if(NOT found)
        message(FATAL_ERROR "LLVM physical alias expected tool is not in the accepted input pins")
    endif()
    set(found_helper FALSE)
    foreach(pin IN LISTS _soui_verified_bridge_pins)
        string(REPLACE "|" ";" fields "${pin}")
        list(GET fields 0 path)
        if(path STREQUAL SOUI_TOOL_IDENTITY_HELPER)
            list(GET fields 1 helper_bytes)
            list(GET fields 2 helper_sha)
            set(found_helper TRUE)
        endif()
    endforeach()
    if(NOT found_helper)
        message(FATAL_ERROR "LLVM helper is not in the accepted bridge pins")
    endif()
    execute_process(
        COMMAND "${SOUI_TOOL_IDENTITY_POWERSHELL_EXECUTABLE}" -NoProfile -NonInteractive
            -File "${SOUI_TOOL_IDENTITY_BRIDGE}" -ObservedPath "${checked_observed}"
            -ExpectedPath "${checked_expected}" -ExpectedBytes "${bytes}" -ExpectedSha256 "${sha}"
            -HelperPath "${SOUI_TOOL_IDENTITY_HELPER}" -HelperBytes "${helper_bytes}" -HelperSha256 "${helper_sha}"
        WORKING_DIRECTORY "${CMAKE_BINARY_DIR}" TIMEOUT 15 ENCODING UTF-8
        RESULT_VARIABLE result OUTPUT_VARIABLE receipt ERROR_VARIABLE failure)
    string(STRIP "${receipt}" receipt)
    string(LENGTH "${receipt}" receipt_size)
    if(NOT "${result}" STREQUAL "0" OR NOT "${failure}" STREQUAL "" OR receipt_size GREATER 256)
        message(FATAL_ERROR "LLVM physical tool identity failed: ${name}; result=${result}; ${failure}")
    endif()
    string(REPLACE "|" ";" fields "${receipt}")
    list(LENGTH fields count)
    if(NOT count EQUAL 5)
        message(FATAL_ERROR "LLVM physical tool identity receipt malformed")
    endif()
    list(GET fields 0 marker)
    list(GET fields 1 actual_sha)
    list(GET fields 2 actual_bytes)
    list(GET fields 3 volume)
    list(GET fields 4 index)
    string(LENGTH "${volume}" volume_size)
    string(LENGTH "${index}" index_size)
    if(NOT marker STREQUAL "SOUI_LLVM_TOOL_FILE_IDENTITY_V1" OR NOT actual_sha STREQUAL sha
            OR NOT actual_bytes STREQUAL "${bytes}" OR NOT volume_size EQUAL 8 OR NOT index_size EQUAL 16
            OR NOT volume MATCHES "^[0-9a-f]+$" OR NOT index MATCHES "^[0-9a-f]+$")
        message(FATAL_ERROR "LLVM physical tool identity receipt changed")
    endif()
    message(STATUS "LLVM physical tool alias verified: ${name}; observed=${observed}; expected=${expected}; volume=${volume}; fileID=${index}")
endfunction()

function(_soui_llvm_bind name value type)
    set(bound_value "${value}")
    if(DEFINED ${name} AND NOT "${${name}}" STREQUAL "${value}")
        if(type STREQUAL "FILEPATH" AND name IN_LIST _soui_tool_filepath_slots)
            _soui_llvm_assert_tool_path("${name}" "${${name}}" "${value}")
            # Preserve the generator's already selected spelling; never FORCE a live build tool.
            set(bound_value "${${name}}")
        else()
            message(FATAL_ERROR "LLVM profile cache/request mismatch: ${name}=${${name}}; expected ${value}. Use a new build tree.")
        endif()
    endif()
    set(${name} "${bound_value}" CACHE ${type} "LLVM22MSVC142 fixed binding")
    set(${name} "${bound_value}" PARENT_SCOPE)
endfunction()

function(_soui_llvm_inputs output)
    set(lines "soui.llvm-profile-inputs/v3\nLLVM22MSVC142\n22.1.3\n19.29.30159\n10.0.19041.0\n${SOUI_LLVM_ARCHITECTURE}\n${_soui_llvm_target}\n${SOUI_LLVM_ROOT}\n${SOUI_MSVC142_ROOT}\n${SOUI_WINDOWS_SDK_ROOT}\n${SOUI_NINJA_EXECUTABLE}\n${SOUI_WINDOWS_CMD_EXECUTABLE}\n${SOUI_TOOL_IDENTITY_POWERSHELL_EXECUTABLE}\n${SOUI_TOOL_IDENTITY_BRIDGE}\n${SOUI_TOOL_IDENTITY_HELPER}\n${SOUI_LLVM_BRIDGE_IDENTITY}")
    set(_soui_tool_pins "")
    foreach(path IN LISTS _soui_llvm_roles _soui_llvm_sentinels _soui_llvm_bridge_files)
        _soui_llvm_path("${path}" FILE checked)
        file(SIZE "${checked}" bytes)
        file(SHA256 "${checked}" sha)
        string(APPEND lines "\n${checked}|${bytes}|${sha}")
        if(path IN_LIST _soui_llvm_roles)
            list(APPEND _soui_tool_pins "${checked}|${bytes}|${sha}")
        endif()
    endforeach()
    string(SHA256 digest "${lines}")
    set(${output} "${digest}" PARENT_SCOPE)
    set(_soui_verified_tool_pins "${_soui_tool_pins}" PARENT_SCOPE)
endfunction()

