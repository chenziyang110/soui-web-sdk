+    blink::WebDragData data;
+    convertDragData(&data, webDragData);
+    blink::WebDragOperation op = view->dragTargetDragEnter(data,
+        blink::WebPoint(clientPoint->x, clientPoint->y),
+        blink::WebPoint(screenPoint->x, screenPoint->y),
