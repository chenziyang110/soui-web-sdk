    reviewedSourceSha256: reviewed.sourceSha256, actualInputsSha256: actualInputs.sha256,
    sourceAndToolsUnchanged: true, outputs, architectureEvidence, records,
    compilerResults: records.filter(row => row.name.startsWith('compile-') || row.name.startsWith('configure-')).map(row => ({name: row.name,
      rootExitCode: row.summary.exitCode, supervisorExitCode: row.summary.supervisorExitCode, genericPassed: row.summary.passed,
      closureConfirmed: row.summary.closureConfirmed, compilerTailAcceptance: false})),
    testsNaturallyClosed: true, noGuiValidation: true, noDllValidation: true, noPipeValidation: true, noOsIdentityValidation: true,
    noWin7PeMatrix: true, noPerformanceValidation: true, releaseReady: false});
