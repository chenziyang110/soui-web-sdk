cmake_minimum_required(VERSION 3.24)
foreach(argument IN ITEMS WORKER_SOURCE_ROOT WORKER_TEST_DIR WORKER_GENERATED_DIR WORKER_GENERATE)
  if(NOT DEFINED ${argument} OR "${${argument}}" STREQUAL "")
    message(FATAL_ERROR "Worker source byte gate argument is missing: ${argument}")
  endif()
endforeach()
foreach(argument IN ITEMS WORKER_SOURCE_ROOT WORKER_TEST_DIR WORKER_GENERATED_DIR)
  if(NOT IS_ABSOLUTE "${${argument}}")
    message(FATAL_ERROR "Worker source byte gate requires an absolute resolved ${argument}")
  endif()
endforeach()
file(READ "${WORKER_TEST_DIR}/source-map.json" worker_map)
string(JSON worker_schema GET "${worker_map}" schema)
if(NOT worker_schema STREQUAL "worker-lifetime-source-map/1")
  message(FATAL_ERROR "Unsupported worker source map")
endif()
function(worker_relative path)
  if(IS_ABSOLUTE "${path}" OR path MATCHES "(^|/)\\.\\.(/|$)" OR path MATCHES "[\\\\:;]")
    message(FATAL_ERROR "Worker source map path is not portable: ${path}")
  endif()
endfunction()
function(worker_check_file path expected_bytes expected_sha)
  string(LENGTH "${expected_sha}" hash_length)
  if(NOT expected_bytes MATCHES "^[1-9][0-9]*$" OR NOT expected_sha MATCHES "^[a-f0-9]+$" OR NOT hash_length EQUAL 64)
    message(FATAL_ERROR "Worker source byte gate has invalid expected input metadata")
  endif()
  if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
    message(FATAL_ERROR "Worker source byte gate input is missing: ${path}")
  endif()
  file(SIZE "${path}" observed_bytes)
  file(SHA256 "${path}" observed_sha)
  if(NOT observed_bytes EQUAL expected_bytes OR NOT observed_sha STREQUAL expected_sha)
    message(FATAL_ERROR "Worker source byte gate input changed: ${path}")
  endif()
endfunction()
set(worker_source_inputs "")
set(worker_payload_inputs "")
foreach(group IN ITEMS sources payloads)
  string(JSON count LENGTH "${worker_map}" ${group})
  if(group STREQUAL "sources" AND NOT count EQUAL 13)
    message(FATAL_ERROR "Worker source map must pin the thirteen live inputs")
  endif()
  if(count LESS 1)
    message(FATAL_ERROR "Worker source map has no ${group}")
  endif()
  math(EXPR last "${count} - 1")
  foreach(index RANGE 0 ${last})
    string(JSON relative GET "${worker_map}" ${group} ${index} path)
    string(JSON bytes GET "${worker_map}" ${group} ${index} bytes)
    string(JSON sha GET "${worker_map}" ${group} ${index} sha256)
    worker_relative("${relative}")
    if(group STREQUAL "sources")
      set(input "${WORKER_SOURCE_ROOT}/${relative}")
      list(APPEND worker_source_inputs "${input}")
    else()
      set(input "${WORKER_TEST_DIR}/${relative}")
      list(APPEND worker_payload_inputs "${input}")
    endif()
    worker_check_file("${input}" "${bytes}" "${sha}")
  endforeach()
endforeach()
string(JSON copy_count LENGTH "${worker_map}" copies)
if(NOT copy_count EQUAL 12)
  message(FATAL_ERROR "Worker source map must describe the twelve actual source inputs")
endif()
math(EXPR copy_last "${copy_count} - 1")
foreach(index RANGE 0 ${copy_last})
  foreach(field IN ITEMS source output startByte endByteExclusive bytes sha256 exactWholeFile)
    string(JSON ${field} GET "${worker_map}" copies ${index} ${field})
  endforeach()
  worker_relative("${source}")
  worker_relative("${output}")
  set(input "${WORKER_SOURCE_ROOT}/${source}")
  list(FIND worker_source_inputs "${input}" pin_index)
  if(pin_index EQUAL -1)
    message(FATAL_ERROR "Worker copy input has no whole-source pin")
  endif()
  file(SIZE "${input}" input_bytes)
  math(EXPR length "${endByteExclusive} - ${startByte}")
  if(startByte LESS 0 OR endByteExclusive GREATER input_bytes OR length LESS 1 OR NOT length EQUAL bytes)
    message(FATAL_ERROR "Worker source map byte range is invalid: ${output}")
  endif()
  file(READ "${input}" input_hex HEX)
  math(EXPR hex_start "${startByte} * 2")
  math(EXPR hex_length "${length} * 2")
  string(SUBSTRING "${input_hex}" ${hex_start} ${hex_length} expected_hex)
  set(generated "${WORKER_GENERATED_DIR}/${output}")
  if(WORKER_GENERATE)
    get_filename_component(directory "${generated}" DIRECTORY)
    file(MAKE_DIRECTORY "${directory}")
    if(exactWholeFile)
      if(NOT startByte EQUAL 0 OR NOT endByteExclusive EQUAL input_bytes)
        message(FATAL_ERROR "Worker whole-file copy has a partial byte range")
      endif()
      file(COPY_FILE "${input}" "${generated}" ONLY_IF_DIFFERENT)
    else()
      # Decode the exact LF-only bytes. Configure one placeholder once; inserted
      # fragment data is not rescanned for $, semicolon or @ substitutions.
      set(fragment "")
      math(EXPR hex_last "${hex_length} - 2")
      string(SUBSTRING "${expected_hex}" ${hex_last} 2 terminal)
      if(NOT terminal STREQUAL "0a")
        message(FATAL_ERROR "Worker source fragment requires a terminal LF")
      endif()
      foreach(offset RANGE 0 ${hex_last} 2)
        string(SUBSTRING "${expected_hex}" ${offset} 2 byte_hex)
        math(EXPR byte "0x${byte_hex}")
        if(byte EQUAL 0 OR byte EQUAL 13)
          message(FATAL_ERROR "Worker source fragment requires NUL-free LF-only bytes")
        endif()
        string(ASCII ${byte} character)
        string(APPEND fragment "${character}")
      endforeach()
      # CONFIGURE supplies the template's terminal LF. Remove only the already
      # validated final source LF so the writer restores that exact one byte.
      math(EXPR fragment_body_length "${length} - 1")
      string(SUBSTRING "${fragment}" 0 ${fragment_body_length} fragment_body)
      file(CONFIGURE OUTPUT "${generated}" CONTENT "@fragment_body@" @ONLY NEWLINE_STYLE UNIX)
    endif()
  endif()
  worker_check_file("${generated}" "${bytes}" "${sha256}")
  file(READ "${generated}" observed_hex HEX)
  if(NOT observed_hex STREQUAL expected_hex)
    message(FATAL_ERROR "Worker generated bytes differ from the actual source range: ${output}")
  endif()
endforeach()
# Bind the real platform shutdown owner without compiling a second cleanup
# implementation. All three pre-shutdown fire routes must select one actual
# WebThreadImpl method before m_mainThread->shutdown changes its exit state.
foreach(field IN ITEMS source output startByte endByteExclusive bytes sha256)
  string(JSON shutdown_${field} GET "${worker_map}" shutdownProof ${field})
endforeach()
worker_relative("${shutdown_source}")
worker_relative("${shutdown_output}")
set(shutdown_input "${WORKER_SOURCE_ROOT}/${shutdown_source}")
list(FIND worker_source_inputs "${shutdown_input}" shutdown_pin_index)
if(shutdown_pin_index EQUAL -1)
  message(FATAL_ERROR "Shutdown owner has no whole-source pin")
endif()
file(SIZE "${shutdown_input}" shutdown_input_bytes)
math(EXPR shutdown_length "${shutdown_endByteExclusive} - ${shutdown_startByte}")
if(shutdown_startByte LESS 0 OR shutdown_endByteExclusive GREATER shutdown_input_bytes
    OR shutdown_length LESS 1 OR NOT shutdown_length EQUAL shutdown_bytes)
  message(FATAL_ERROR "Shutdown owner proof range is invalid")
endif()
file(READ "${shutdown_input}" shutdown_fragment OFFSET ${shutdown_startByte} LIMIT ${shutdown_length})
file(READ "${shutdown_input}" shutdown_input_hex HEX)
math(EXPR shutdown_hex_start "${shutdown_startByte} * 2")
math(EXPR shutdown_hex_length "${shutdown_length} * 2")
string(SUBSTRING "${shutdown_input_hex}" ${shutdown_hex_start} ${shutdown_hex_length} shutdown_expected_hex)
set(shutdown_generated "${WORKER_GENERATED_DIR}/${shutdown_output}")
if(WORKER_GENERATE)
  math(EXPR shutdown_body_length "${shutdown_length} - 1")
  string(SUBSTRING "${shutdown_fragment}" ${shutdown_body_length} 1 shutdown_terminal)
  if(NOT shutdown_terminal STREQUAL "\n")
    message(FATAL_ERROR "Shutdown owner proof requires a terminal LF")
  endif()
  string(SUBSTRING "${shutdown_fragment}" 0 ${shutdown_body_length} shutdown_body)
  file(CONFIGURE OUTPUT "${shutdown_generated}" CONTENT "@shutdown_body@" @ONLY NEWLINE_STYLE UNIX)
endif()
worker_check_file("${shutdown_generated}" "${shutdown_bytes}" "${shutdown_sha256}")
file(READ "${shutdown_generated}" shutdown_generated_hex HEX)
if(NOT shutdown_generated_hex STREQUAL shutdown_expected_hex)
  message(FATAL_ERROR "Shutdown owner proof differs from actual function bytes")
endif()
string(FIND "${shutdown_fragment}" "void BlinkPlatformImpl::shutdown()\n{" shutdown_function)
string(FIND "${shutdown_fragment}" "((WebThreadImpl*)m_mainThread)->shutdown();" shutdown_commit)
if(NOT shutdown_function EQUAL 0 OR shutdown_commit LESS 0)
  message(FATAL_ERROR "Shutdown owner proof does not bind the actual lifecycle function")
endif()
string(SUBSTRING "${shutdown_fragment}" 0 ${shutdown_commit} shutdown_before_commit)
set(shutdown_route_pattern "\\(\\(WebThreadImpl\\*\\)currentThread\\(\\)\\)->(fire|fireForShutdown)\\(\\)")
string(REGEX MATCHALL "${shutdown_route_pattern}" shutdown_all_routes "${shutdown_fragment}")
string(REGEX MATCHALL "${shutdown_route_pattern}" shutdown_before_routes "${shutdown_before_commit}")
list(LENGTH shutdown_all_routes shutdown_all_count)
list(LENGTH shutdown_before_routes shutdown_before_count)
if(NOT shutdown_all_count EQUAL 3 OR NOT shutdown_before_count EQUAL 3)
  message(FATAL_ERROR "Shutdown owner must bind exactly three pre-shutdown fire routes")
endif()
list(GET shutdown_all_routes 0 shutdown_route)
foreach(route IN LISTS shutdown_all_routes)
  if(NOT route STREQUAL shutdown_route)
    message(FATAL_ERROR "Shutdown owner fire routes disagree")
  endif()
endforeach()
string(REGEX REPLACE ".*->(fire|fireForShutdown)\\(\\)" "\\1" shutdown_entrypoint "${shutdown_route}")
set(shutdown_token "#define FIXTURE_PRE_SHUTDOWN_FIRE_ENTRYPOINT ${shutdown_entrypoint}\n")
set(shutdown_token_path "${WORKER_GENERATED_DIR}/fragments/shutdown_fire_entrypoint.inc")
if(WORKER_GENERATE)
  file(WRITE "${shutdown_token_path}" "${shutdown_token}")
endif()
file(READ "${shutdown_token_path}" shutdown_observed_token)
if(NOT shutdown_observed_token STREQUAL shutdown_token)
  message(FATAL_ERROR "Shutdown fixture entrypoint differs from its actual owner routes")
endif()
# Recheck every live input after generation/verification, before compilation.
string(JSON source_count LENGTH "${worker_map}" sources)
math(EXPR source_last "${source_count} - 1")
foreach(index RANGE 0 ${source_last})
  string(JSON relative GET "${worker_map}" sources ${index} path)
  string(JSON bytes GET "${worker_map}" sources ${index} bytes)
  string(JSON sha GET "${worker_map}" sources ${index} sha256)
  worker_check_file("${WORKER_SOURCE_ROOT}/${relative}" "${bytes}" "${sha}")
endforeach()
