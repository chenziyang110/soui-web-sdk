diff --git a/third_party/sources/miniblink/cc/raster/RasterCandidateBudget.h b/third_party/sources/miniblink/cc/raster/RasterCandidateBudget.h
new file mode 100644
index 00000000..aaf3ddb0
--- /dev/null
+++ b/third_party/sources/miniblink/cc/raster/RasterCandidateBudget.h
@@ -0,0 +1,43 @@
+#ifndef CC_RASTER_RASTER_CANDIDATE_BUDGET_H_
+#define CC_RASTER_RASTER_CANDIDATE_BUDGET_H_
+#include <cstddef>
+#include <cstdint>
+
+namespace cc {
+class RasterCandidateBudget {
+public:
+    enum class Failure : unsigned { None, LayerLimit, TileLimit, ByteLimit,
+        UnknownResidentOwner, UnknownPictureOwner, FilterOwner, GenerationChanged,
+        TaskLimit, ExistingWork };
+    static const size_t maximumLayers = 128;
+    static const size_t maximumTiles = 1024;
+    static const size_t maximumTasks = 64;
+    static const uint64_t maximumBytes = 64ULL * 1024 * 1024;
+    bool layer() { return count(m_layers, maximumLayers, Failure::LayerLimit); }
+    bool tile() { return count(m_tiles, maximumTiles, Failure::TileLimit); }
+    bool task() { return count(m_tasks, maximumTasks, Failure::TaskLimit); }
+    bool addBytes(uint64_t bytes)
+    {
+        if (bytes > maximumBytes - m_bytes)
+            return reject(Failure::ByteLimit);
+        m_bytes += bytes;
+        return eligible();
+    }
+    bool reject(Failure reason) { if (m_failure == Failure::None) m_failure = reason; return false; }
+    bool eligible() const { return m_failure == Failure::None; }
+    Failure failure() const { return m_failure; }
+    uint64_t bytes() const { return m_bytes; }
+private:
+    bool count(size_t& value, size_t maximum, Failure reason)
+    {
+        if (value == maximum)
+            return reject(reason);
+        ++value;
+        return eligible();
+    }
+    uint64_t m_bytes = 0;
+    size_t m_layers = 0, m_tiles = 0, m_tasks = 0;
+    Failure m_failure = Failure::None;
+};
+} // namespace cc
+#endif
diff --git a/third_party/sources/miniblink/cc/raster/RasterSchedulingPolicy.h b/third_party/sources/miniblink/cc/raster/RasterSchedulingPolicy.h
new file mode 100644
index 00000000..38ae5030
--- /dev/null
+++ b/third_party/sources/miniblink/cc/raster/RasterSchedulingPolicy.h
@@ -0,0 +1,57 @@
+#ifndef CC_RASTER_RASTER_SCHEDULING_POLICY_H_
+#define CC_RASTER_RASTER_SCHEDULING_POLICY_H_
+
+#include <cstdint>
+#include <cmath>
+
+namespace cc {
+class RasterTaskReceipt {
+public:
+    bool start() { if (m_state != State::Pending) return false; m_state = State::Running; return true; }
+    bool finish() { if (m_state != State::Running) return false; m_state = State::Completed; return true; }
+    bool cancelUnstarted() { if (m_state != State::Pending) return false; m_state = State::Cancelled; return true; }
+    bool failRunning() { if (m_state != State::Running) return false; m_state = State::Cancelled; return true; }
+private:
+    enum class State { Pending, Running, Completed, Cancelled };
+    State m_state = State::Pending;
+};
+class RasterSchedulingPolicy {
+public:
+    static const unsigned maximumWorkers = 4;
+    static const unsigned maximumQueuedTasks = 64;
+    static const uint64_t maximumQueuedBytes = 64ULL * 1024 * 1024;
+    static unsigned workers(unsigned requested)
+    {
+        return requested >= 1 && requested <= maximumWorkers ? requested : 1;
+    }
+    static uint64_t estimatedBytes(double width, double height)
+    {
+        if (!std::isfinite(width) || !std::isfinite(height) || width <= 0 || height <= 0)
+            return maximumQueuedBytes + 1;
+        const double bytes = std::ceil(width) * std::ceil(height) * 4;
+        return bytes <= maximumQueuedBytes ? static_cast<uint64_t>(bytes)
+            : maximumQueuedBytes + 1;
+    }
+    bool reserve(uint64_t bytes)
+    {
+        if (m_tasks == maximumQueuedTasks || bytes > maximumQueuedBytes - m_bytes)
+            return false;
+        ++m_tasks;
+        m_bytes += bytes;
+        return true;
+    }
+    void release(uint64_t bytes)
+    {
+        if (m_tasks && bytes <= m_bytes) {
+            --m_tasks;
+            m_bytes -= bytes;
+        }
+    }
+    unsigned tasks() const { return m_tasks; }
+    uint64_t bytes() const { return m_bytes; }
+private:
+    unsigned m_tasks = 0;
+    uint64_t m_bytes = 0;
+};
+} // namespace cc
+#endif
