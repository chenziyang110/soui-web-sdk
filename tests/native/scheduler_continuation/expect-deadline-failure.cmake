cmake_minimum_required(VERSION 3.24)
if(NOT DEFINED EXECUTABLE OR NOT FAILURE MATCHES "^(close|unregister)$")
  message(FATAL_ERROR "Expected executable and exact deadline failure case")
endif()
execute_process(COMMAND "${EXECUTABLE}" "--failure-${FAILURE}"
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
if(result STREQUAL "0" OR result MATCHES "[Tt]imeout" OR output MATCHES "unexpected-successful-stop")
  message(FATAL_ERROR "Failed native fence returned successful stop: ${output}")
endif()
if(FAILURE STREQUAL "close")
  set(receipt "deadline-close-failure retained-handle=1 wait-retired=1")
else()
  set(receipt "deadline-unregister-failure timer-not-closed=1")
endif()
if(NOT output MATCHES "${receipt}")
  message(FATAL_ERROR "Actual source failure seam was not reached: ${result} ${output} ${error}")
endif()
