'use strict';
const fs=require('node:fs'),path=require('node:path'),crypto=require('node:crypto');
const root=path.resolve(__dirname,'..');
const attempt=path.join(root,'out/measurement-tail-integration-dc48fd5f-4adf-473f-a048-bd2cfffa6eb8');
const base='verification/production-validation/0.5-measurement-integration-2026-10-09';
const hash=b=>crypto.createHash('sha256').update(b).digest('hex');
const indexPath=path.join(attempt,'evidence-index-final.json'),indexBytes=fs.readFileSync(indexPath);
if(hash(indexBytes)!=='e986d730a99bf3b9b9cf27593a622c0ec2e2b41500f31ccfcfcd102ec00f1415')throw Error('Frozen index changed');
const index=JSON.parse(indexBytes),result=JSON.parse(fs.readFileSync(path.join(attempt,'result-final.json')));
const frozen=JSON.parse(fs.readFileSync(path.join(attempt,'source-frozen.json')));
const files=[],seen=new Set();
function safe(base,name){
 if(typeof name!=='string'||path.isAbsolute(name)||/[\x00-\x1f:]/.test(name)||name.split(/[\\/]/).some(p=>!p||p==='.'||p==='..'))throw Error('Unsafe path');
 const full=path.resolve(base,name),relative=path.relative(base,full);
 if(!relative||relative.startsWith('..')||path.isAbsolute(relative))throw Error('Path escape');
 let cursor=full;while(cursor!==base){if(fs.lstatSync(cursor).isSymbolicLink())throw Error('Linked path');cursor=path.dirname(cursor);}return full;
}
function read(input){const st=fs.lstatSync(input);if(!st.isFile()||st.isSymbolicLink()||st.nlink!==1)throw Error('Not unique plain file');return fs.readFileSync(input);}
function inert(name){return /\.(?:cjs|mjs|js|jsx|ps1|cpp|hpp|h|ts|tsx|cmake|vcxproj|txt)$/i.test(name)||name==='CMakeLists.txt'?name+'.inert.snapshot':name;}
function copy(input,relative,expected){
 const bytes=read(input),digest=hash(bytes);if(expected&&(expected.bytes!==bytes.length||expected.sha256!==digest))throw Error('Evidence changed '+input);
 const rel=relative.split('/').map(inert).join('/');if(seen.has(rel.toLowerCase()))throw Error('Duplicate archive path');seen.add(rel.toLowerCase());
 const target=path.join(root,base,rel);fs.mkdirSync(path.dirname(target),{recursive:true});fs.writeFileSync(target,bytes,{flag:'wx'});
 files.push({path:base+'/'+rel,source:input,bytes:bytes.length,sha256:digest});return files.at(-1);
}
for(const f of frozen.files){const b=read(safe(root,f.path));if(b.length!==f.bytes||hash(b)!==f.sha256)throw Error('Frozen source changed '+f.path);}
if(frozen.files.length!==47||result.sourceSha256!==frozen.sha256||result.measurementBuildSourceSha256!==frozen.measurement.sha256||index.files.length!==1013)throw Error('Unexpected frozen result');
for(const [i,f]of index.files.entries()){const row=copy(safe(attempt,f.path),'raw/'+String(i+1).padStart(4,'0')+'-'+path.basename(f.path),f);row.originalRelativePath=f.path;}
copy(indexPath,'attempt/evidence-index-final.json');
for(const f of frozen.files)copy(safe(root,f.path),'compiled-inputs/'+f.path,f);
copy(__filename,'archive-driver.cjs');
const record={schema:'soui.measurement-mainline-archived-evidence/v1',version:'0.5.0-preview.1',
 testedHead:result.head,mainMerged:result.mainMerged,miSourceCommit:result.miSourceCommit,
 relatedSourceSha256:result.sourceSha256,relatedSourceFileCount:result.sourceFileCount,
 measurementBuildSourceSha256:result.measurementBuildSourceSha256,measurementBuildSourceCount:result.measurementBuildSourceCount,
 groups:result.groups,builds:result.builds,preparation:result.preparation,
 entrypointActualPSAst:result.entrypointActualPSAst,collectUnitProjectionOnly:result.collectUnitProjectionOnly,
 releaseReady:false,limitations:result.limitations,files};
fs.writeFileSync(path.join(root,base,'index.json'),JSON.stringify(record,null,2)+'\n',{flag:'wx'});
console.log(JSON.stringify({path:base+'/index.json',files:files.length,bytes:files.reduce((n,f)=>n+f.bytes,0),source:record.relatedSourceSha256}));
