    if (kind === 'byte-exact-inert-copy') {
      const leaf = path.basename(row.path).replace(/[^A-Za-z0-9._-]/g, '_').slice(0, 88);
      item.archivePath = 'raw/' + String(index).padStart(5, '0') + '-' + leaf + '.inert.snapshot';
      write(relative(destination, item.archivePath), data);
    }
    mapping.push(item);
  }
  const privateFiles = mapping.filter(row => !row.archivePath);
  write(relative(destination, 'byte-exact-map.json'), {schema: 'soui.local-task-family-archive-map/v1',
    records: mapping, originalsNeverRewritten: true, noNormalizationOfArchivedBytes: true});
  write(relative(destination, 'private-artifacts.json'), {schema: 'soui.local-task-family-private-artifacts/v1',
    files: privateFiles, compiledOutputs: binaryOutputs, externalHashPins: [...externalPins.values()],
    externalBinaryBodiesPublished: false, binlogBodiesPublished: false, generatedCompilerIdBodiesPublished: false,
    note: 'Original private paths and disk hashes are metadata. They are not copied payloads or loaded-memory authentication.'});
  write(relative(destination, 'archive-summary.json'), {...proof, date: '2026-10-09',
    scope: 'Local task family source-bound Release regression evidence only; not production qualification.',
    sourceStaticReview: {archivistPerformedIndependentProductionReview: false,
      provenance: 'Root reports prior independent static Root and merge_graph review of the unchanged frozen16; this curation does not repeat or upgrade that approval.'},
    actualNativeCompileInputCount: native.actualInputs.files.length, wholeRawSourceInputCount: native.rawSource.files.length,
    actualSourceNormalization: 'Full source identity uses recorded LF normalization; raw input snapshots and archived evidence remain byte-exact.',
    compiledOutputs: binaryOutputs, privateHashOnlyOriginalCount: privateFiles.length,
    byteExactInertCopies: mapping.length - privateFiles.length,
    productionGateLimitations: {fullDistribution: false, gui: false, dll: false, pipe: false, osIdentity: false,
      win7PeMatrix: false, performance: false, longRun: false, fullCollect: false, vendorKernel: false, realOsOom: false}});
  write(relative(destination, 'README.md'), bytes(path.join(__dirname, 'README.template.md')));
  for (const row of originalFiles.values()) verify(row);
  verifySourceBinding();
  for (const row of externalPins.values()) e.verify(row);
  const files = walk(destination).map(file => ({path: path.relative(destination, file).replace(/\\/g, '/'),
    bytes: bytes(file).length, sha256: hash(bytes(file))}));
  const payloadBytes = files.reduce((total, row) => total + row.bytes, 0);
  write(relative(destination, 'index.json'), {schema: 'soui.local-task-family-public-file-index/v1', files,
    bytes: payloadBytes, compilerTailAcceptance: false, qualificationPassed: false, validationPassed: false, releaseReady: false});
  for (const row of files) verify(row, relative(destination, row.path));
  const completion = {archive: destination, index: record(path.join(destination, 'index.json')),
    indexedPayload: files.length, totalArchiveFiles: files.length + 1, publicPayloadBytes: payloadBytes,
    publicBytesIncludingIndex: payloadBytes + bytes(path.join(destination, 'index.json')).length,
    mappedOriginals: mapping.length, byteExactInertCopies: mapping.length - privateFiles.length,
    privateHashOnlyOriginals: privateFiles.length, externalHashPins: externalPins.size, originalIndexProofs: indexProofs,
    source16Sha256: source16Hash, unchangedSource16: true, allOriginalsStable: true, noPublicBinaryBodies: true,
    actualNativeRecords: phaseProofs.length, actualPropertyPhases: 24, actualCtestPerArchitecture: 11,
    directCasesPerArchitecture: [13, 14], noNativeExecutionByArchivist: true,
    compilerTailAcceptance: false, qualificationPassed: false, validationPassed: false, releaseReady: false};
  write(path.join(__dirname, 'completion.json'), completion);
  write(path.join(__dirname, 'verification-proof.json'), {...completion,
    source16: reviewed.files, actualResults: resultRecord, phaseProofs, architectureProofs,
    publicPayloadHashesRechecked: true, originalPayloadHashesRecheckedPostCopy: true});
  console.log(JSON.stringify(completion, null, 2));
}
