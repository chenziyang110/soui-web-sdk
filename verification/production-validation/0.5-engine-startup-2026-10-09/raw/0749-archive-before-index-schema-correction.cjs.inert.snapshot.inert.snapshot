write(relative(archive, 'README.md'), readme);
// Freeze all source and original evidence again after copying; no prior corpus can silently drift.
for (const item of allOriginal.values()) verify(item);
for (const item of [...frozen.sources, ...frozen.nativeCompileInputs]) verify(item);
