cmake_minimum_required(VERSION 3.24)
if(NOT DEFINED SUBJECT OR NOT DEFINED CASE_ID OR NOT DEFINED SUBMODE)
  message(FATAL_ERROR "Expected-fail-fast wrapper arguments are incomplete")
endif()
execute_process(COMMAND "${SUBJECT}" "${CASE_ID}" "${SUBMODE}"
  RESULT_VARIABLE result OUTPUT_VARIABLE observations ERROR_VARIABLE errors TIMEOUT 10)
message("${observations}")
if(NOT errors STREQUAL "")
  message("${errors}")
endif()
if(NOT result STREQUAL "86")
  message(FATAL_ERROR "Actual source did not prove fail-fast before release: ${result}")
endif()
string(REPLACE "\r\n" "\n" lines "${observations}")
string(REPLACE "\n" ";" lines "${lines}")
set(summary_count 0)
set(native_pids "")
foreach(line IN LISTS lines)
  if(line STREQUAL "")
    continue()
  endif()
  string(JSON schema ERROR_VARIABLE schema_error GET "${line}" schema)
  if(schema_error STREQUAL "NOTFOUND" AND schema STREQUAL "worker-lifetime-source-run/1")
    math(EXPR summary_count "${summary_count} + 1")
    set(summary "${line}")
  else()
    string(JSON record ERROR_VARIABLE record_error GET "${line}" record)
    if(NOT record_error STREQUAL "NOTFOUND" OR NOT record STREQUAL "native-observation")
      message(FATAL_ERROR "Unexpected or malformed fail-fast observation")
    endif()
    string(JSON observation_pid GET "${line}" pid)
    string(JSON observation_pid_type TYPE "${line}" pid)
    string(JSON observation_case GET "${line}" case)
    if(NOT observation_pid_type STREQUAL "NUMBER" OR NOT observation_pid MATCHES "^[1-9][0-9]*$")
      message(FATAL_ERROR "Native observation has an invalid PID")
    endif()
    if(NOT observation_case STREQUAL CASE_ID)
      message(FATAL_ERROR "Native observation has a different case ID")
    endif()
    list(APPEND native_pids "${observation_pid}")
  endif()
endforeach()
if(NOT summary_count EQUAL 1)
  message(FATAL_ERROR "Expected exactly one fail-fast summary, observed ${summary_count}")
endif()
foreach(field IN ITEMS variant case submode reason)
  string(JSON field_type TYPE "${summary}" "${field}")
  if(NOT field_type STREQUAL "STRING")
    message(FATAL_ERROR "Fail-fast field has an incorrect JSON type: ${field}")
  endif()
endforeach()
foreach(field IN ITEMS pid registryCount registrySize workerFrees schedulerFrees workerClosed eventClosed waitFailureInjected exitFailureInjected debugBreaks closeInspections inspectedCount inspectedReady)
  string(JSON field_type TYPE "${summary}" "${field}")
  if(NOT field_type STREQUAL "NUMBER")
    message(FATAL_ERROR "Fail-fast numeric field has an incorrect JSON type: ${field}")
  endif()
endforeach()
foreach(field IN ITEMS contractPassed expectedFailFast qualificationPassed constructorOomClosed)
  string(JSON field_type TYPE "${summary}" "${field}")
  if(NOT field_type STREQUAL "BOOLEAN")
    message(FATAL_ERROR "Fail-fast verdict has an incorrect JSON type: ${field}")
  endif()
endforeach()
foreach(field IN ITEMS variant case submode pid contractPassed expectedFailFast reason
    registryCount registrySize workerFrees schedulerFrees workerClosed eventClosed
    waitFailureInjected exitFailureInjected qualificationPassed constructorOomClosed debugBreaks closeInspections inspectedCount inspectedReady)
  string(JSON value_${field} ERROR_VARIABLE field_error GET "${summary}" "${field}")
  if(NOT field_error STREQUAL "NOTFOUND")
    message(FATAL_ERROR "Missing fail-fast summary field: ${field}")
  endif()
endforeach()
if(NOT value_variant STREQUAL "after" OR NOT value_case STREQUAL CASE_ID
    OR NOT value_submode STREQUAL SUBMODE OR NOT value_pid MATCHES "^[1-9][0-9]*$"
    OR NOT value_contractPassed STREQUAL "ON" OR NOT value_expectedFailFast STREQUAL "ON"
    OR NOT value_reason STREQUAL "actual-source-terminate-before-release"
    OR NOT value_registryCount EQUAL 1 OR NOT value_registrySize EQUAL 1
    OR NOT value_workerFrees EQUAL 0 OR NOT value_schedulerFrees EQUAL 0
    OR NOT value_workerClosed EQUAL 0 OR NOT value_eventClosed EQUAL 0
    OR NOT value_qualificationPassed STREQUAL "OFF" OR NOT value_constructorOomClosed STREQUAL "OFF")
  message(FATAL_ERROR "Fail-fast summary does not bind the expected actual-source pre-release state")
endif()
if(CASE_ID STREQUAL "native-wait-fails")
  if(SUBMODE STREQUAL "wait")
    if(NOT value_waitFailureInjected EQUAL 1 OR NOT value_exitFailureInjected EQUAL 0)
      message(FATAL_ERROR "Actual wait-failure seam was not observed exactly once")
    endif()
  elseif(SUBMODE STREQUAL "exit-code")
    if(NOT value_waitFailureInjected EQUAL 0 OR NOT value_exitFailureInjected EQUAL 1)
      message(FATAL_ERROR "Actual exit-code-failure seam was not observed exactly once")
    endif()
  else()
    message(FATAL_ERROR "Unknown wait-failure submode")
  endif()
elseif(CASE_ID STREQUAL "worker-self-delete")
  if(NOT SUBMODE STREQUAL "wait")
    message(FATAL_ERROR "Unknown self-delete submode")
  endif()
elseif(CASE_ID STREQUAL "registry-live-fence" OR CASE_ID STREQUAL "concurrent-registry-close")
  if(NOT SUBMODE STREQUAL "wait" OR value_debugBreaks LESS 1
      OR NOT value_waitFailureInjected EQUAL 0 OR NOT value_exitFailureInjected EQUAL 0)
    message(FATAL_ERROR "Live registry fence did not prove non-continuable failure")
  endif()
  if(CASE_ID STREQUAL "concurrent-registry-close" AND (NOT value_closeInspections EQUAL 1
      OR NOT value_inspectedCount EQUAL 1 OR NOT value_inspectedReady EQUAL 1))
    message(FATAL_ERROR "Concurrent close inspected a partial or fabricated registry")
  endif()
else()
  message(FATAL_ERROR "Unknown fail-fast case")
endif()
list(LENGTH native_pids native_count)
if(native_count EQUAL 0)
  message(FATAL_ERROR "Fail-fast run has no native observations")
endif()
foreach(observation_pid IN LISTS native_pids)
  if(NOT observation_pid STREQUAL value_pid)
    message(FATAL_ERROR "Fail-fast receipt PID differs from native observations")
  endif()
endforeach()
# An external Owned Job binds this reported subject PID to the actual launched child.
# execute_process does not expose the child PID, so this helper cannot invent it.
message("{\"record\":\"validated-fail-fast-receipt\",\"case\":\"${CASE_ID}\",\"submode\":\"${SUBMODE}\",\"subjectPid\":${value_pid},\"externalOwnedPidBindingPending\":true}")
