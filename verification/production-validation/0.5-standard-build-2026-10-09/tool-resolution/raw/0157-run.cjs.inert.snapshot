'use strict';const fs=require('node:fs'),path=require('node:path'),crypto=require('node:crypto');const root='F:/work/sm05-build-caller',base=__dirname,phase=process.argv[2];if(!['red','green','tail-protocol-x86','tail-protocol-x64'].includes(phase))throw Error('Unknown phase');const sha=b=>crypto.createHash('sha256').update(b).digest('hex'),put=(p,b)=>fs.writeFileSync(p,Buffer.isBuffer(b)?b:JSON.stringify(b,null,2)+'\n',{flag:'wx'});
