+        return false;
+    m_finished = true;
+    unsigned size = 0;
+    if (EVP_DigestFinal_ex(m_context, m_result, &size) != 1 || size != m_expectedSize) {
+        m_failed = true;
+        return false;
+    }
+    resultData = m_result;
+    resultDataSize = size;
     return true;
 }
     
