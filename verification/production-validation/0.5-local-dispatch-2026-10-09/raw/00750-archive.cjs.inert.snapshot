  const rows = bytes.toString('utf8').trimEnd().split(/\r?\n/).map(JSON.parse), start = rows[0], terminal = rows.at(-1);
  assert.equal(rows.filter(x => x.event === 'start').length, 1); assert.equal(rows.filter(x => x.event === 'terminal').length, 1);
  assert.equal(start.event, 'start'); assert.equal(start.schema, 'soui.owned-process-run/v1');
  assert(start.jobAssignedBeforeResume && start.breakawayAllowed === false);
  assert(Number.isSafeInteger(start.pid) && start.pid > 0);
