-struct CompositorScrollUpdateTask {
-    CompositorScrollUpdateTask(LayerTreeHost* targetHost, int targetLayerId,
-        const ScrollSample& latestSample, const ScrollVector& latestVisualOffset)
-        : host(targetHost)
