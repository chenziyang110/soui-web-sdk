+#include <iostream>
+#include <iterator>
+#include <stdexcept>
+#include <string>
+
+namespace soui::benchmark {
+namespace ime_report_contract_detail {
+using json=nlohmann::json;
+inline void check(bool value,const char* message) {
+  if(!value)throw std::runtime_error(message);
+}
+template<class Call> inline void rejects(Call&& call,const char* message) {
+  bool rejected=false;
+  try {call();}catch(const std::exception&){rejected=true;}
+  check(rejected,message);
+}
+inline std::string params(const json& page) {
