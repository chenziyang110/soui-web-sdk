+#pragma once
+#include <soui/diagnostics/input_frame_trace.h>
+#include <json.hpp>
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <initializer_list>
+#include <mutex>
+#include <set>
+#include <stdexcept>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+namespace soui::benchmark {
+namespace ime_report_detail {
+using json=nlohmann::json;
+inline constexpr std::size_t byte_limit=24576;
+inline constexpr std::size_t persisted_byte_limit=32768;
+inline constexpr std::size_t maximum_events=96;
+inline constexpr std::size_t maximum_checkpoints=4;
+inline constexpr std::size_t text_unit_limit=128;
+inline constexpr std::size_t data_unit_limit=64;
+inline constexpr const char* capability="ime-functional-snapshot-v1";
+inline void require(bool value,const char* error){if(!value)throw std::runtime_error(error);}
+inline void keys(const json& value,std::initializer_list<const char*> expected) {
+  require(value.is_object()&&value.size()==expected.size(),"E_IME_REPORT_KEYS");
+  for(const auto* key:expected)require(value.contains(key),"E_IME_REPORT_KEYS");
+}
+inline bool integer(const json& value,std::uint64_t maximum) {
+  return value.is_number_integer()&&(value.is_number_unsigned()||value.get<std::int64_t>()>=0)&&value.get<std::uint64_t>()<=maximum;
+}
+inline double time(const json& value) {
+  require(value.is_number(),"E_IME_REPORT_TIME");const auto result=value.get<double>();
+  require(std::isfinite(result)&&result>=0&&result<=180000,"E_IME_REPORT_TIME");return result;
+}
+// json::parse validates UTF-8. Count decoded UTF-16 units, as textarea selection
+// offsets and JavaScript string.length do; supplementary characters take two.
+inline std::size_t text(const json& value,std::size_t limit) {
+  require(value.is_string(),"E_IME_REPORT_TEXT");const auto& bytes=value.get_ref<const std::string&>();
+  require(bytes.size()<=limit*4,"E_IME_REPORT_TEXT");std::size_t units=0;
+  for(std::size_t at=0;at<bytes.size();) {
+    const auto lead=static_cast<unsigned char>(bytes[at]);
+    const std::size_t width=lead<0x80?1:lead<0xe0?2:lead<0xf0?3:4;
+    require(at+width<=bytes.size(),"E_IME_REPORT_TEXT");at+=width;units+=width==4?2:1;
+    require(units<=limit,"E_IME_REPORT_TEXT");
+  }return units;
+}
+inline bool one_of(const json& value,std::initializer_list<const char*> choices) {
+  if(!value.is_string())return false;
+  for(const auto* choice:choices)if(value==choice)return true;return false;
+}
+inline void selection(const json& value,std::size_t units) {
+  const auto& begin=value.at("selection_start");const auto& end=value.at("selection_end");
+  const auto& direction=value.at("selection_direction");
+  if(begin.is_null()||end.is_null()) {
+    require(begin.is_null()&&end.is_null()&&direction.is_null(),"E_IME_REPORT_SELECTION");return;
+  }
+  require(integer(begin,units)&&integer(end,units)&&begin.get<std::uint64_t>()<=end.get<std::uint64_t>()&&
+    one_of(direction,{"forward","backward","none"}),"E_IME_REPORT_SELECTION");
+}
+inline void active(const json& value) {
+  require(one_of(value,{"test-input","finish","phase","other","none"}),"E_IME_REPORT_ACTIVE");
+}
+inline json parse(std::string_view params,const std::string& run) {
+  require(params.size()<=byte_limit,"E_IME_REPORT_SIZE");std::set<std::string> envelope_keys;
+  const auto envelope=json::parse(params.begin(),params.end(),[&](int depth,json::parse_event_t event,json& item) {
+    require(depth<=1&&event!=json::parse_event_t::array_start&&!(depth&&event==json::parse_event_t::object_start),"E_IME_REPORT_DEPTH");
+    if(event==json::parse_event_t::key)require(envelope_keys.insert(item.get<std::string>()).second,"E_IME_REPORT_DUPLICATE_KEY");
+    return true;
+  });keys(envelope,{"snapshot_json"});require(envelope.at("snapshot_json").is_string(),"E_IME_REPORT_TYPE");
+  const auto& raw=envelope.at("snapshot_json").get_ref<const std::string&>();require(raw.size()<=byte_limit,"E_IME_REPORT_SIZE");
+  std::vector<std::set<std::string>> objects;
+  auto report=json::parse(raw,[&](int depth,json::parse_event_t event,json& item) {
+    require(depth<=3,"E_IME_REPORT_DEPTH");
+    if(event==json::parse_event_t::object_start)objects.emplace_back();
+    else if(event==json::parse_event_t::key)require(!objects.empty()&&objects.back().insert(item.get<std::string>()).second,"E_IME_REPORT_DUPLICATE_KEY");
+    else if(event==json::parse_event_t::object_end)objects.pop_back();return true;
+  });
+  keys(report,{"schema","run_id","event_clock","events","checkpoints","final","overflow","classification",
+    "performance_verified","physical_latency_measured"});
+  require(report.at("schema")=="soui.ime-functional-page/v1"&&report.at("run_id")==run&&
+    report.at("event_clock")=="performance.now-relative-ms","E_IME_REPORT_IDENTITY");
+  require(report.at("overflow")==false,"E_IME_REPORT_OVERFLOW");
+  require(report.at("performance_verified")==false&&report.at("physical_latency_measured")==false,"E_IME_REPORT_CLAIM");
+  const auto& classification=report.at("classification");keys(classification,{"os_ime","native_late_commit","native_dual_flags"});
+  for(const auto* key:{"os_ime","native_late_commit","native_dual_flags"})require(classification.at(key)=="unknown","E_IME_REPORT_CLAIM");
+  const auto& events=report.at("events");require(events.is_array()&&events.size()<=maximum_events,"E_IME_REPORT_EVENTS");
+  std::uint64_t sequence=0;double previous_time=0;
+  for(const auto& event:events) {
+    keys(event,{"seq","time_ms","type","data","value","selection_start","selection_end","selection_direction","active_element","phase"});
+    require(integer(event.at("seq"),maximum_events)&&event.at("seq").get<std::uint64_t>()==++sequence,"E_IME_REPORT_SEQUENCE");
+    const auto observed=time(event.at("time_ms"));require(observed>=previous_time,"E_IME_REPORT_TIME");previous_time=observed;
+    require(one_of(event.at("type"),{"keydown","keyup","input","compositionstart","compositionupdate","compositionend","focus","blur",
+      "window-focus","window-blur","selectionchange","checkpoint"}),"E_IME_REPORT_EVENT_TYPE");
+    require(one_of(event.at("phase"),{"initial","preedit-observed","after-focus-return","final"}),"E_IME_REPORT_PHASE");
+    if(!event.at("data").is_null())(void)text(event.at("data"),data_unit_limit);
+    selection(event,text(event.at("value"),text_unit_limit));active(event.at("active_element"));
+  }
+  const auto& checkpoints=report.at("checkpoints");
+  require(checkpoints.is_array()&&checkpoints.size()<=maximum_checkpoints,"E_IME_REPORT_CHECKPOINTS");std::uint64_t last_checkpoint=0;
+  for(const auto& checkpoint:checkpoints) {
+    require(integer(checkpoint,events.size()),"E_IME_REPORT_CHECKPOINTS");const auto index=checkpoint.get<std::uint64_t>();
+    require(index>last_checkpoint&&events.at(static_cast<std::size_t>(index-1)).at("type")=="checkpoint","E_IME_REPORT_CHECKPOINTS");last_checkpoint=index;
+  }
+  const auto& final=report.at("final");keys(final,{"time_ms","value","selection_start","selection_end","selection_direction","active_element"});
+  require(time(final.at("time_ms"))>=previous_time,"E_IME_REPORT_TIME");
+  selection(final,text(final.at("value"),text_unit_limit));active(final.at("active_element"));
+  return report;
+}
+}
+struct ime_persistence_authority final {bool normal_runtime_close{},trace_quiescent{};};
+class ime_report_collector final {
+ public:
+  explicit ime_report_collector(std::string run):run_(std::move(run)){}
+  std::string submit(std::string_view params) {
+    const auto begin=sdk::diagnostics::input_frame_trace::now_qpc();auto report=ime_report_detail::parse(params,run_).dump();
+    const auto end=sdk::diagnostics::input_frame_trace::now_qpc();ime_report_detail::require(begin&&end>=begin,"E_IME_REPORT_CLOCK");
+    {std::lock_guard<std::mutex> lock(mutex_);ime_report_detail::require(!closing_,"E_IME_REPORT_CLOSING");
+      ime_report_detail::require(report_.empty(),"E_IME_REPORT_ALREADY_SUBMITTED");report_=std::move(report);begin_=begin;end_=end;}
+    return "{\"accepted\":true,\"persisted\":false,\"submission\":\"accepted\"}";
+  }
+  std::string submit_request(std::string_view params) {
+    try{return submit(params);}catch(const std::exception& failure) {
+      const std::string code=failure.what();const bool controlled=code.rfind("E_IME_REPORT_",0)==0&&code.size()<80;
+      return ime_report_detail::json{{"error",controlled?code:"E_IME_REPORT_INVALID"},{"message","IME functional snapshot rejected."}}.dump();
+    }
+  }
+  void close(){std::lock_guard<std::mutex> lock(mutex_);closing_=true;}
+  ime_report_detail::json take(const sdk::diagnostics::input_frame_trace::identity& identity,const std::string& run) {
+    std::string report;std::uint64_t begin{},end{};
+    {std::lock_guard<std::mutex> lock(mutex_);ime_report_detail::require(closing_&&!taken_,"E_IME_REPORT_NOT_CLOSED");
+      ime_report_detail::require(run==run_,"E_IME_REPORT_IDENTITY");taken_=true;report=std::move(report_);begin=begin_;end=end_;}
+    return {{"schema","soui.ime-functional-result/v1"},{"capability",ime_report_detail::capability},{"run_id",run},
+      {"process_id",identity.process_id},{"process_incarnation",std::to_string(identity.process_incarnation)},
+      {"qpc_frequency",std::to_string(identity.qpc_frequency)},{"submission",report.empty()?"unsubmitted":"accepted"},
+      {"accepted_begin_qpc",report.empty()?ime_report_detail::json(nullptr):ime_report_detail::json(std::to_string(begin))},
+      {"accepted_end_qpc",report.empty()?ime_report_detail::json(nullptr):ime_report_detail::json(std::to_string(end))},
+      {"page_snapshot",report.empty()?ime_report_detail::json(nullptr):ime_report_detail::json::parse(report)},
+      {"os_ime_coverage","unknown"},{"native_late_commit_coverage","unknown"},{"native_dual_flags_coverage","unknown"},
+      {"functional_pass",nullptr},{"performanceGate",false},{"releaseReady",false}};
+  }
+ private:
+  const std::string run_;std::mutex mutex_;std::string report_;std::uint64_t begin_{},end_{};bool closing_{},taken_{};
+};
+template<class Remaining,class Write>
+ime_report_detail::json persist_ime_report(ime_report_collector& collector,
+    const sdk::diagnostics::input_frame_trace::identity& identity,const std::string& run,
+    ime_persistence_authority authority,Remaining&& remaining,Write&& write) {
+  ime_report_detail::require(authority.normal_runtime_close&&authority.trace_quiescent,"E_IME_REPORT_PERSISTENCE_AUTHORITY");
+  ime_report_detail::require(remaining().count()>0,"E_IME_REPORT_CLOSE_DEADLINE");
+  auto value=collector.take(identity,run);value["normal_runtime_close_authorized"]=true;value["trace_quiescent_authorized"]=true;
+  const auto bytes=value.dump()+"\n";ime_report_detail::require(bytes.size()<=ime_report_detail::persisted_byte_limit,"E_IME_REPORT_SIZE");
+  write(bytes); // Caller supplies CREATE_NEW + full write/flush, after quiescence.
+  ime_report_detail::require(remaining().count()>0,"E_IME_REPORT_CLOSE_DEADLINE");value["persisted"]=value.at("submission")=="accepted";
+  return value;
+}
+}
