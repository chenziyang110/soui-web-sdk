cmake_minimum_required(VERSION 3.24)
project(DisplayCalibrationConsumer LANGUAGES CXX)
if(NOT MSVC OR NOT WIN32)
  message(FATAL_ERROR "This isolated consumer requires Windows and MSVC")
endif()
if(NOT CMAKE_VS_WINDOWS_TARGET_PLATFORM_VERSION STREQUAL "10.0.19041.0")
  message(FATAL_ERROR "SDK19041 must be selected explicitly")
endif()
add_executable(DisplayCalibration "F:/work/sm05-scopes/benchmarks/protocol/display-calibration.cpp")
target_compile_features(DisplayCalibration PRIVATE cxx_std_17)
target_compile_definitions(DisplayCalibration PRIVATE WINVER=0x0601 _WIN32_WINNT=0x0601)
target_compile_options(DisplayCalibration PRIVATE /W4 /utf-8 /EHsc)
set_property(TARGET DisplayCalibration PROPERTY MSVC_RUNTIME_LIBRARY MultiThreadedDLL)
