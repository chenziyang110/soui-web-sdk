'use strict';
const fs=require('node:fs'),path=require('node:path'),crypto=require('node:crypto');
const identity=require('../tools/internal/delivery-identity.cjs');
const root=path.resolve(__dirname,'..'),base='verification/production-validation/0.5-standard-build-2026-10-09';
const original=path.join(root,'out/standard-build-full-private-9c58b20e-9b71-42a7-b22b-c1a0aaae5907');
const hash=b=>crypto.createHash('sha256').update(b).digest('hex'),raw=fs.readFileSync(path.join(original,'index.json'));
if(hash(raw)!=='5018368731012ac42eb8976bf54ab7f778f0dd5ace12b18f7eb2b448c2bfcb1c')throw Error('Private full original changed');
const previous=JSON.parse(raw),vendorHashes=new Set();
for(const group of previous.groups){if(!group.label.startsWith('sdk-'))continue;
 const x=JSON.parse(fs.readFileSync(path.join(root,group.originalDirectory,'inputs.json')));
 for(const tool of x.tools)if(tool.role!=='runner')vendorHashes.add(tool.sha256);}
const files=[],privateToolBinaryInputs=[];
function copy(input,relative,expected){const b=fs.readFileSync(identity.safePath(input));if(expected&&(b.length!==expected.bytes||hash(b)!==expected.sha256))throw Error('Frozen original changed');
 const target=identity.safePath(root,base+'/'+relative);fs.mkdirSync(path.dirname(target),{recursive:true});fs.writeFileSync(target,b,{flag:'wx'});
 files.push({path:base+'/'+relative,source:input,bytes:b.length,sha256:hash(b)});}
for(const f of previous.files){const rel=f.path.slice(base.length+1),input=identity.safePath(original,rel),b=fs.readFileSync(input);
 if(b.length!==f.bytes||hash(b)!==f.sha256)throw Error('Original payload changed');
 const executable=b.length>=64&&b.readUInt16LE(0)===0x5a4d;
 const vendorName=/(?:^|[-/])(?:cl|link|lib|vctip|msbuild|cmake|ctest|node|cmd|powershell|pwsh|vswhere|conhost|mspdbsrv|mspdbcmf|cvtres)\.exe(?:\.|$)/i.test(rel);
 if(executable&&(vendorHashes.has(f.sha256)||vendorName))privateToolBinaryInputs.push({...f,privateRetainedPath:input,
  reason:'External build tool PE retained privately; provenance metadata only in public evidence'});
 else copy(input,rel,f);
}
copy(path.join(original,'index.json'),'original-full-index.json.inert.snapshot');
copy(__filename,'public-curation-driver.cjs.inert.snapshot');
const audit=JSON.parse(fs.readFileSync(path.join(original,'dependency-audit/index.json')));
for(const f of audit.files)copy(path.join(original,'dependency-audit',f.path),'dependency-audit/'+f.path,f);
copy(path.join(original,'dependency-audit/index.json'),'dependency-audit/index.json');
copy(path.join(original,'README.md'),'README.md');
const index={...previous,schema:'soui.standard-build-public-evidence/v1',originalFullArchive:{sha256:hash(raw),files:previous.files.length,
 bytes:previous.files.reduce((s,f)=>s+f.bytes,0),privateRetainedDirectory:original},privateToolBinaryInputs,files};
fs.writeFileSync(path.join(root,base,'index.json'),JSON.stringify(index,null,2)+'\n',{flag:'wx'});
console.log(JSON.stringify({path:base+'/index.json',files:files.length,privateToolBinaryInputs:privateToolBinaryInputs.length,
 bytes:files.reduce((s,f)=>s+f.bytes,0),indexSha256:hash(fs.readFileSync(path.join(root,base,'index.json')))}));
