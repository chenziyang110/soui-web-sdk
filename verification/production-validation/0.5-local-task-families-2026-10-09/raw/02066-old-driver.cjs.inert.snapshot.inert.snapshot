verifyPreparation();
const identity = require(path.join(root, 'tools/internal/delivery-identity.cjs'));
const {launchOwned} = require(path.join(root, 'tools/internal/owned-process.cjs'));
const hash = bytes => crypto.createHash('sha256').update(bytes).digest('hex');
const encode = value => Buffer.from(JSON.stringify(value, null, 2) + '\n');
const need = (value, message) => { if (!value) throw Error(message); };
need(process.argv.length === 2, 'This fixed private driver accepts no arguments');
const reviewedPath = path.join(__dirname, 'reviewed-inputs.json');
const reviewedBytes = fs.readFileSync(reviewedPath), reviewed = JSON.parse(reviewedBytes);
need(hash(reviewedBytes) === '493d43655e241556b02804a7d345491e1632fb26184f49f7830c49369f09ec6f', 'Reviewed index changed');
need(reviewed.root === root && reviewed.files.length === 16, 'Reviewed source belongs to another worktree');
function file(requestedPath) {
