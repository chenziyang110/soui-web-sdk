 fs.mkdirSync(output);fs.mkdirSync(path.join(output,'temp'));
 const build=path.join(output,'build');
 function selectedSdkCheck(phase,projectRoot=build){
  const expected='10.0.19041.0',platform=a['--arch']+',version='+expected;
  const cache=fs.readFileSync(path.join(projectRoot,'CMakeCache.txt'),'utf8');
  if(!cache.split(/\r?\n/).includes('CMAKE_GENERATOR_PLATFORM:INTERNAL='+platform))throw Error('Actual generator platform/SDK request differs');
  const projects=list(projectRoot).filter(p=>/\.vcxproj$/i.test(p));
  if(!projects.length)throw Error('No actual generated VS projects for SDK selection');
  const projectPins=projects.map(file=>{
   const body=fs.readFileSync(file),versions=[...body.toString('utf8').matchAll(/<WindowsTargetPlatformVersion(?:\s[^>]*)?>([^<]+)<\/WindowsTargetPlatformVersion>/g)].map(m=>m[1].trim());
   if(!versions.length||versions.some(version=>version!==expected))throw Error('Actual generated project selected a different Windows SDK: '+file);
   return{path:file,bytes:body.length,sha256:sha(body),windowsTargetPlatformVersions:versions};
  });
  json(path.join(output,phase+'.selected-sdk.json'),{expectedWindowsSdk:expected,generatorPlatform:platform,actualGeneratedProjectSdkVersionsMatch:true,projectPins,completeToolchainProvenance:false,qualificationPassed:false});
