'use strict';
const fs=require('node:fs'),path=require('node:path'),crypto=require('node:crypto'),identity=require('../tools/internal/delivery-identity.cjs');
const root=path.resolve(__dirname,'..'),attempt=path.join(root,'out/operation-query-mainline-gui-b110143d-3086-44e6-aeea-f65fb136634d');
const base='verification/production-validation/0.5-operation-query-2026-10-09/post-main',hash=b=>crypto.createHash('sha256').update(b).digest('hex');
const indexBytes=fs.readFileSync(path.join(attempt,'index.json'));
if(hash(indexBytes)!=='fcd797f7a25697ef88b424a6fddf805baae9711a135a9af7e7e02e20211606a9')throw Error('Frozen GUI index changed');
const original=JSON.parse(indexBytes),files=[];
function copy(input,relative,expected){const s=fs.lstatSync(input);if(!s.isFile()||s.isSymbolicLink()||s.nlink!==1)throw Error('Not plain unique evidence');
 const b=fs.readFileSync(input),sha256=hash(b);if(expected&&(b.length!==expected.bytes||sha256!==expected.sha256))throw Error('Evidence changed');
 const rel=/\.(cjs|mjs|js|ts|cpp|h|ps1|cmake|txt)$/i.test(relative)?relative+'.inert.snapshot':relative,target=path.join(root,base,rel);
 fs.mkdirSync(path.dirname(target),{recursive:true});fs.writeFileSync(target,b,{flag:'wx'});files.push({path:base+'/'+rel,source:input,bytes:b.length,sha256});return files.at(-1);}
for(const [i,f]of original.files.entries()){const row=copy(identity.safePath(attempt,f.path),'raw/'+String(i+1).padStart(4,'0')+'-'+path.basename(f.path),f);row.originalRelativePath=f.path;}
copy(path.join(attempt,'index.json'),'attempt-index.json');copy(__filename,'archive-driver.cjs');
const result=JSON.parse(fs.readFileSync(path.join(attempt,'result.json')));
fs.writeFileSync(path.join(root,base,'index.json'),JSON.stringify({schema:'soui.operation-query-post-main-archived/v1',mainMerged:'4fc8c199ac0d58bc8509fab0f3a36a047ad268c1',
 sourceSha256:original.sourceSha256,guiSourceSha256:original.guiSourceSha256,guiOutputSha256:original.guiOutputSha256,
 nativeInputsUnchanged:true,nativeInputFiles:371,nativeRecompiled:false,result,fullTestExecuted:false,fullCollectExecuted:false,
 actualGuiBindingsCompiled:true,desktopGuiValidated:false,releaseReady:false,files},null,2)+'\n',{flag:'wx'});
console.log(JSON.stringify({path:base+'/index.json',files:files.length,bytes:files.reduce((n,f)=>n+f.bytes,0),sha256:hash(fs.readFileSync(path.join(root,base,'index.json')))}));
