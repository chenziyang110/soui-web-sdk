  for(const p of packet.liveInputs)pin(p);
  for(const root of packet.inventoryRoots){const actual=list(root.path).map(normalize);if(JSON.stringify(actual)!==JSON.stringify(root.paths))throw Error('SDK/header input membership changed');}
  if(fs.readdirSync(path.join(directory,'empty-user-props')).length)throw Error('Private user props directory changed');
  if(JSON.stringify(list(directory).map(p=>path.relative(directory,p).replaceAll('\\','/')).sort())!==JSON.stringify(packet.packageMembership))throw Error('Sealed package membership changed');
  for(const p of packet.sourceFixtureRanges){pin(p.source);pin(p.fixture);const actual=fs.readFileSync(p.source.path).subarray(p.startByte,p.startByte+p.bytes),copy=fs.readFileSync(p.fixture.path).subarray(p.fixtureStartByte,p.fixtureStartByte+p.bytes);if(actual.length!==p.bytes||!actual.equals(copy)||sha(actual)!==p.sha256)throw Error('Actual public fixture source bytes changed');}
