    proof: {schema: 'soui.local-dispatch-original-readonly-review/v1', indexSha256: expected.index,
      indexedOriginals: index.files.length, actualInputs: frozen.actualInputs.files.length, sourceSha256: expected.source,
      rawSourceSha256: expected.raw, actualInputSha256: expected.nativeInputs, toolCount: frozen.tools.length,
      jobs, counts, outputFiles: results.outputs.length, peFiles: pe, staticLibraries: libraries, allExact: true,
      authorBoundary: 'Archivist authored original 14 test cases; Root/Deps independently reviewed their design. This proof verifies execution and archive bytes, not self-approval.'}};
}
async function audit() {
  const directory = path.join(__dirname, 'audit'); fs.mkdirSync(directory);
  const cli = path.join(path.dirname(fs.realpathSync.native(process.execPath)), 'node_modules/npm/bin/npm-cli.js');
  const tools = [pin(process.execPath), pin(cli), pin(runner), pin(client)];
  assert.equal(tools[2].sha256, expected.runner); assert.equal(tools[3].sha256, expected.client);
  assert(!fs.existsSync(path.join(root, '.npmrc')) && !fs.existsSync(path.join(root, 'sdk/web/.npmrc')), 'Project npmrc requires separate credential review');
  const packages = ['sdk/web/package.json', 'sdk/web/package-lock.json'].map(name => ({...meta(bounded(root, name)), path: name}));
  const env = {}; const allow = new Set(['path', 'pathext', 'comspec', 'systemroot', 'windir', 'temp', 'tmp',
    'userprofile', 'appdata', 'localappdata', 'homedrive', 'homepath', 'programdata', 'number_of_processors', 'processor_architecture']);
  for (const [name, value] of Object.entries(process.env)) if (allow.has(name.toLowerCase())) env[name] = value;
  const empty = path.join(directory, 'empty.npmrc'); write(empty, Buffer.alloc(0));
  env.NPM_CONFIG_USERCONFIG = empty; env.NPM_CONFIG_GLOBALCONFIG = empty; env.MSBUILDDISABLENODEREUSE = '1';
  const credential = /token|secret|password|passwd|passphrase|api_?key|credential|authorization|cookie|ssh_auth/i;
  const removed = Object.keys(process.env).filter(k => credential.test(k)); assert(!Object.keys(env).some(k => credential.test(k)));
  const args = [cli, '--prefix', 'sdk/web', 'audit', '--json', '--ignore-scripts', '--registry=https://registry.npmjs.org'];
  const inputs = {schema: 'soui.local-dispatch-audit-inputs/v1', executable: tools[0], args, cwd: root, tools, packageInputs: packages,
    sourceSha256: expected.source, actualInputSha256: expected.nativeInputs, timeoutMs: 120000, drainMs: 3000,
    environmentGuard: {allowlistedEnvironment: true, removedCredentialLikeNames: removed, valuesNeverWritten: true,
      parentEnvironmentUnchanged: true, emptyUserAndGlobalNpmConfig: true, explicitPublicRegistry: true},
    noInstall: true, noDependencyBuildClaim: true, noTailPolicy: true};
  write(path.join(directory, 'inputs.json'), inputs);
  const out = fs.openSync(path.join(directory, 'stdout.bin'), 'wx'), err = fs.openSync(path.join(directory, 'stderr.bin'), 'wx');
  let owned, finished, ready, readyError = null;
  try {
    owned = require(client).launchOwned(process.execPath, args, {runner, cwd: root, report: path.join(directory, 'owned.ndjson'),
      timeoutMs: inputs.timeoutMs, drainMs: inputs.drainMs, env, stdout: out, stderr: err});
    try { ready = await owned.ready; } catch (e) { readyError = e.message; owned.stop(); }
    finished = await owned.finished;
  } finally { fs.closeSync(out); fs.closeSync(err); }
  const archivedFinished = {...finished, ...(ready ? {ready} : {}), readyError,
    contextSha256: hash(read(path.join(directory, 'owned.ndjson.context.json'))),
    stdoutSha256: hash(read(path.join(directory, 'stdout.bin'))), stderrSha256: hash(read(path.join(directory, 'stderr.bin')))};
  write(path.join(directory, 'finished.json'), archivedFinished);
  tools.forEach(repin); packages.forEach(p => check(bounded(root, p.path), p));
  const stdout = read(path.join(directory, 'stdout.bin')); let auditJson = null, parseError = null;
  try { auditJson = JSON.parse(stdout); } catch (e) { parseError = e.message; }
  let natural = false, subject = null, supervisionError = null;
