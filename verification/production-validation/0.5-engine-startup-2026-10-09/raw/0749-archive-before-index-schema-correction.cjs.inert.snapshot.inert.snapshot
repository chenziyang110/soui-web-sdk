for (const item of files) verify({...item, path: relative(archive, item.path)});
const completion = {archive, index: record(path.join(archive, 'index.json')), indexedPayload: files.length,
  totalArchiveFiles: files.length + 1, bytes: files.reduce((total, item) => total + item.bytes, 0),
  mappedOriginals: mapping.length, byteExactInertCopies: mapping.length - omitted.length,
  privateHashOnly: omitted.length, originalIndexProofs: indexProofs,
  nativeCompileInputCount: frozen.nativeCompileInputs.length, sourceUnchanged: true,
