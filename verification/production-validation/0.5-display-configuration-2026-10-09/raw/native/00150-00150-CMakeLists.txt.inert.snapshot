cmake_minimum_required(VERSION 3.24)
project(DisplayLoadProbe LANGUAGES CXX)
if(NOT MSVC OR NOT WIN32 OR NOT CMAKE_VS_WINDOWS_TARGET_PLATFORM_VERSION STREQUAL "10.0.19041.0")
  message(FATAL_ERROR "Requires MSVC and SDK19041")
endif()
add_executable(DisplayLoadProbe load-probe.cpp)
target_compile_features(DisplayLoadProbe PRIVATE cxx_std_17)
target_compile_definitions(DisplayLoadProbe PRIVATE WINVER=0x0601 _WIN32_WINNT=0x0601)
target_compile_options(DisplayLoadProbe PRIVATE /W4 /utf-8 /EHsc)
set_property(TARGET DisplayLoadProbe PROPERTY MSVC_RUNTIME_LIBRARY MultiThreadedDLL)
