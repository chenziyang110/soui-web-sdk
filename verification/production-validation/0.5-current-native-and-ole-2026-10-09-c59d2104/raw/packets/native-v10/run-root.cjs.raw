function list(root){return fs.readdirSync(root,{withFileTypes:true}).flatMap(e=>{const p=path.join(root,e.name);if(e.isSymbolicLink())throw Error('Symlink input refused');if(e.isDirectory())return list(p);if(!e.isFile())throw Error('Nonregular input refused');return[p];}).sort((a,b)=>normalize(a)<normalize(b)?-1:normalize(a)>normalize(b)?1:0);}
function pin(p){if(!p||!path.isAbsolute(p.path)||!Number.isSafeInteger(p.bytes)||p.bytes<0||!/^[a-f0-9]{64}$/.test(p.sha256)||fs.statSync(p.path).size!==p.bytes||digest(p.path)!==p.sha256)throw Error('Input/tool pin mismatch: '+p?.path);return p;}
function parse(argv){const a={};for(let n=0;n<argv.length;n+=2){if(!/^--[a-z-]+$/.test(argv[n])||argv[n+1]===undefined||a[argv[n]]!==undefined)throw Error('Invalid/repeated argument');a[argv[n]]=argv[n+1];}return a;}
async function main(){
 const a=parse(process.argv.slice(2));
 if(a['--root-gate']!=='ROOT_FULL_NATIVE_UNIT_SUITE_V10'||Object.keys(a).some(k=>!['--root-gate','--package-sha','--arch'].includes(k)))throw Error('Root gate/arguments invalid');
 if(!['x64','Win32'].includes(a['--arch'])||!/^[a-f0-9]{64}$/.test(a['--package-sha']||''))throw Error('Architecture/package pin required');
 const packageFile=path.join(directory,'package.json');if(digest(packageFile)!==a['--package-sha'])throw Error('Package pin mismatch');
 const packet=JSON.parse(fs.readFileSync(packageFile,'utf8'));
 if(packet.schema!=='private-full-native-unit-suite-v10'||packet.executionOwner!=='Root only'||packet.releaseReady!==false||packet.initializedUnloadQualified!==false||packet.souiTestKitDefined!==false||packet.normalSdkSources!==true||packet.webview2BackendBuilt!==false||packet.preparationComplete!==true||packet.expectedTests.length!==126||packet.expectedTargets.length!==46||packet.sdkSources.length!==24||packet.uiaSources.length!==1||packet.uiaPublicInstalled!==true||packet.localEndpointPublicInstalled!==true||packet.localTaskFamilyPublicInstalled!==true||packet.legacyDragLeafPublicInstalled!==true||packet.requestClosePublicInstalled!==true||packet.workerLifetimePublicInstalled!==true||packet.windowsPeerIdentityPublicInstalled!==true||packet.dragCtorPublicInstalled!==true||packet.expectedTestCommands.length!==126||packet.expectedGeneratedFragments.length!==25||packet.sourceFixtureRanges.length!==21)throw Error('Package contract');
