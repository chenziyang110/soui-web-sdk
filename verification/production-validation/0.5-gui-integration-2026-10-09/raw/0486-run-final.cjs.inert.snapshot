
'use strict';
const fs=require('node:fs'),path=require('node:path'),cp=require('node:child_process'),crypto=require('node:crypto'),Module=require('node:module'),assert=require('node:assert/strict');
const root=path.resolve(__dirname,'../..'),out=__dirname,identity=require(path.join(root,'tools/internal/delivery-identity.cjs')),gui=require(path.join(root,'tools/sdk/gui-bindings-delivery.cjs')),sdk=require(path.join(root,'tools/sdk/soui-sdk.cjs'));
function run(name,args,env){const r=cp.spawnSync(process.execPath,args,{cwd:root,env:{...process.env,...env},encoding:'utf8',timeout:300000,windowsHide:true});fs.writeFileSync(path.join(out,name+'.stdout.log'),r.stdout||'');fs.writeFileSync(path.join(out,name+'.stderr.log'),r.stderr||'');const result={exe:process.execPath,args,status:r.status,error:r.error?.message||null};fs.writeFileSync(path.join(out,name+'.json'),identity.encoded(result));if(r.status!==0)throw Error(name+' failed');return result;}
const commands=[];
commands.push(run('final-build',['tools/sdk/gui-bindings-delivery.cjs','build','--root',root]));
commands.push(run('final-boundaries',['--test','tests/sdk/gui-bindings-delivery.test.cjs','tests/sdk/gui-bindings-entrypoints.test.cjs']));
commands.push(run('final-pack-smoke',['tests/sdk/sdk-package-smoke.cjs']));
commands.push(run('final-core-gui',['--test','tests/web/gui.test.mjs']));
commands.push(run('final-bindings',['tools/sdk/gui-bindings-delivery.cjs','test','--root',root]));
const ps=cp.spawnSync('pwsh',['-NoProfile','-Command',"$files=@('tools/Build.ps1','tools/Test.ps1');foreach($file in $files){$tokens=$null;$errors=$null;[void][Management.Automation.Language.Parser]::ParseFile((Resolve-Path $file),[ref]$tokens,[ref]$errors);if($errors.Count){$errors|Out-String|Write-Error;exit 1}};Write-Output '2 PowerShell entrypoints parsed'"],{cwd:root,encoding:'utf8',windowsHide:true});fs.writeFileSync(path.join(out,'parser.stdout.log'),ps.stdout||'');fs.writeFileSync(path.join(out,'parser.stderr.log'),ps.stderr||'');if(ps.status!==0)throw Error('PS parser');
const baseline=cp.execFileSync('git',['show','21ec627a2e41536be4a7cb5b4e92f38817872e83:tools/sdk/soui-sdk.cjs'],{cwd:root});fs.writeFileSync(path.join(out,'baseline-soui-sdk.cjs.inert.snapshot'),baseline);
const legacy=new Module(path.join(root,'tools/sdk/soui-sdk.cjs'),module);legacy.filename=path.join(root,'tools/sdk/soui-sdk.cjs');legacy.paths=Module._nodeModulePaths(path.dirname(legacy.filename));legacy._compile(baseline.toString('utf8'),legacy.filename);
const fixture=path.join(out,'red-fixture'),oldPacked=path.join(out,'red-default-sdk'),newPacked=path.join(out,'green-optional-sdk');
const write=(name,data)=>{const file=path.join(fixture,name);fs.mkdirSync(path.dirname(file),{recursive:true});fs.writeFileSync(file,data);};
for(const name of sdk.managedRoots)write(name+'/fixture.txt','fixture\n');for(const name of sdk.managedFiles)write(name,'fixture\n');write('VERSION',fs.readFileSync(path.join(root,'VERSION')));
for(const entry of gui.packages){for(const name of ['package.json','package-lock.json','tsconfig.json'])write(entry.root+'/'+name,fs.readFileSync(path.join(root,entry.root,name)));fs.cpSync(path.join(root,entry.root,'src'),path.join(fixture,entry.root,'src'),{recursive:true});fs.cpSync(path.join(root,entry.root,'dist'),path.join(fixture,entry.root,'dist'),{recursive:true});}
fs.cpSync(path.join(root,'sdk/bindings/shared'),path.join(fixture,'sdk/bindings/shared'),{recursive:true});write('tools/sdk/gui-bindings-delivery.cjs',fs.readFileSync(path.join(root,'tools/sdk/gui-bindings-delivery.cjs')));
const source=gui.source(fixture),output=gui.outputs(fixture),evidenceDirectory='out/gui-bindings/build-00000000-0000-0000-0000-000000000000';
const fakeCommands=gui.packages.flatMap(entry=>[['ci','--ignore-scripts','--no-audit','--no-fund','--install-links'],['run','build']].map((args,i)=>{const stdout=entry.name.replaceAll('/','-')+i+'.stdout.log',stderr=entry.name.replaceAll('/','-')+i+'.stderr.log';write(evidenceDirectory+'/'+stdout,'fixture\n');write(evidenceDirectory+'/'+stderr,'');return{cwd:entry.root,executable:process.execPath,args:['fixture-npm',...args],exitCode:0,error:null,stdout,stderr,logs:{stdout:{bytes:8,sha256:identity.hash(Buffer.from('fixture\n'))},stderr:{bytes:0,sha256:identity.hash(Buffer.alloc(0))}}};}));
write(gui.reportName,identity.encoded({schema:'soui.gui-bindings-build/v1',version:gui.metadata(fixture),source,output,evidenceDirectory,commands:fakeCommands}));
legacy.exports.pack(fixture,oldPacked,gui.metadata(fixture));const oldManifest=legacy.exports.readPackage(oldPacked);
const required=gui.packages.flatMap(p=>[p.root+'/'+p.import,p.root+'/'+p.types]),missing=required.filter(name=>!oldManifest.files.some(f=>f.path===name));assert.equal(missing.length,6);assert.equal(oldManifest.optionalGuiBindings,undefined);
fs.writeFileSync(path.join(out,'red-result.json'),identity.encoded({expectation:'compiled imports delivered',passed:false,fixtureOnly:true,baselineSourceSha256:identity.hash(baseline),missing,manifestSha256:identity.hash(identity.encoded(oldManifest))}));
sdk.pack(fixture,newPacked,gui.metadata(fixture),{withGuiBindings:true});const current=sdk.readPackage(newPacked);assert.equal(required.every(name=>current.files.some(f=>f.path===name)),true);fs.writeFileSync(path.join(out,'green-result.json'),identity.encoded({passed:true,fixtureOnly:true,sourceSha256:source.sha256,outputSha256:output.sha256,manifestSha256:identity.hash(identity.encoded(current))}));
fs.writeFileSync(path.join(out,'commands-final.json'),identity.encoded(commands));console.log(JSON.stringify({out,status:'passed',commands:commands.length,redMissing:missing.length}));
