+}
+inline json sample(const std::string& run) {
+  // One BMP plus one supplementary character: three JS UTF-16 code units,
+  // seven UTF-8 bytes. Selection validation must use the former.
+  const std::string text="\xE6\xB1\x89\xF0\xA0\x80\x80";
+  json events=json::array();
+  for(unsigned seq=1;seq<=3;++seq)events.push_back({
+    {"seq",seq},{"time_ms",static_cast<double>(seq)},
+    {"type",seq==1?"compositionstart":seq==2?"compositionupdate":"checkpoint"},
+    {"data",seq==2?json(text):json(nullptr)},{"value",text},
+    {"selection_start",3},{"selection_end",3},{"selection_direction","none"},
+    {"active_element","test-input"},{"phase",seq==3?"after-focus-return":"preedit-observed"}});
+  return {{"schema","soui.ime-functional-page/v1"},{"run_id",run},
+    {"event_clock","performance.now-relative-ms"},{"events",events},{"checkpoints",json::array({3})},
+    {"final",{{"time_ms",4.0},{"value",text},{"selection_start",3},{"selection_end",3},
+      {"selection_direction","none"},{"active_element","test-input"}}},
+    {"overflow",false},{"classification",{{"os_ime","unknown"},{"native_late_commit","unknown"},
+      {"native_dual_flags","unknown"}}},{"performance_verified",false},{"physical_latency_measured",false}};
+}
+}
+
+// Production parser/collector contracts only. This does not run Blink, dispatch
+// input, recognize an OS IME, or qualify any text/focus/performance behavior.
+inline unsigned run_ime_report_contracts(const std::filesystem::path& root) {
+  using namespace ime_report_contract_detail;
+  const std::string run(32,'c');
+  const auto page=sample(run);
