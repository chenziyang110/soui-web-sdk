cmake_minimum_required(VERSION 3.28)
project(SouiFullNativeUnitSuite LANGUAGES C CXX)
if(NOT WIN32 OR NOT MSVC)
 message(FATAL_ERROR "Actual Windows MSVC suite required")
endif()
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_MSVC_RUNTIME_LIBRARY MultiThreadedDLL)
set(SOUI_BUILD_TEMPLATE OFF CACHE BOOL "No template application" FORCE)
set(SOUI_BUILD_DEMOS OFF CACHE BOOL "No Demo application" FORCE)
set(SOUI_BUILD_TESTS ON CACHE BOOL "Current native test sources" FORCE)
set(BUILD_TESTING ON CACHE BOOL "Current registered unit tests" FORCE)
set(SOUI_BUILD_WEBVIEW2 OFF CACHE BOOL "No WebView2 backend" FORCE)
set(SOUI_BUILD_UIA ON CACHE BOOL "Current public optional UIA module" FORCE)
enable_testing()
add_subdirectory("F:/work/sm05-broker/sdk" sdk)
add_subdirectory("F:/work/sm05-broker/tests/native" native)
if(TARGET SouiWorkbench OR TARGET Soui::WebView2)
 message(FATAL_ERROR "Native GUI app or optional backend was unexpectedly included")
endif()
function(root_collect_native directory)
 get_property(local_tests DIRECTORY "${directory}" PROPERTY TESTS)
 foreach(test IN LISTS local_tests)
  get_property(timeout TEST "${test}" DIRECTORY "${directory}" PROPERTY TIMEOUT)
  if(NOT timeout)
   set_tests_properties("${test}" DIRECTORY "${directory}" PROPERTIES TIMEOUT 30)
  endif()
  set_property(GLOBAL APPEND PROPERTY ROOT_SUITE_TESTS "${test}")
 endforeach()
 get_property(local_targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
 foreach(target IN LISTS local_targets)
  get_target_property(kind "${target}" TYPE)
  if(kind STREQUAL "EXECUTABLE")
   set_property(GLOBAL APPEND PROPERTY ROOT_SUITE_TARGETS "${target}")
  endif()
 endforeach()
 get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
 foreach(child IN LISTS children)
  root_collect_native("${child}")
 endforeach()
endfunction()
root_collect_native("F:/work/sm05-broker/tests/native")
get_property(root_tests GLOBAL PROPERTY ROOT_SUITE_TESTS)
get_property(root_targets GLOBAL PROPERTY ROOT_SUITE_TARGETS)
list(SORT root_tests)
list(SORT root_targets)
file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/actual-registered-tests.txt" CONTENT "$<JOIN:${root_tests},\n>\n" NEWLINE_STYLE UNIX)
file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/actual-native-targets.txt" CONTENT "$<JOIN:${root_targets},\n>\n" NEWLINE_STYLE UNIX)
file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/actual-sdk-sources.txt" CONTENT "$<JOIN:$<TARGET_PROPERTY:soui_sdk,SOURCES>,\n>\n" NEWLINE_STYLE UNIX)
file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/actual-uia-sources.txt" CONTENT "$<JOIN:$<TARGET_PROPERTY:soui_uia,SOURCES>,\n>\n" NEWLINE_STYLE UNIX)
add_custom_target(root_full_native_suite DEPENDS soui_sdk soui_zlib soui_uia ${root_targets})
