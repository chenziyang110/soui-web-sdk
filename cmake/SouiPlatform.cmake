include_guard(GLOBAL)

# Target-platform policy, not a claim that any target has passed acceptance.
# Call soui_detect_platform() after project(... LANGUAGES C CXX). Compiler
# predefined macros verify the requested target. The x86 family may use -m32/
# -m64 while CMAKE_SYSTEM_PROCESSOR still names the other x86-family width.
# A cross-family contradiction is an incorrect toolchain, never a fallback.
function(_soui_normalize_os value output)
  string(TOLOWER "${value}" value)
  if(value STREQUAL "windows")
    set(result windows)
  elseif(value STREQUAL "linux")
    set(result linux)
  elseif(value STREQUAL "darwin")
    set(result macos)
  else()
    message(FATAL_ERROR "SOUI not_supported: unknown target operating system '${value}'. Expected Windows, Linux or Darwin.")
  endif()
  set(${output} "${result}" PARENT_SCOPE)
endfunction()

function(_soui_normalize_arch value output)
  string(STRIP "${value}" value)
  string(TOLOWER "${value}" value)
  if(value MATCHES "arm64ec")
    message(FATAL_ERROR "SOUI not_supported: ARM64EC is not an ARM64 target supported by this SDK.")
  elseif(value MATCHES "^(x86|win32|ia32|i[3-6]86)$")
    set(result x86)
  elseif(value MATCHES "^(x64|amd64|x86_64|x86-64)$")
    set(result x64)
  elseif(value MATCHES "^(arm64|aarch64)$")
    set(result arm64)
  elseif(value MATCHES "^(arm|arm32|armhf|armel|armv[4-8](l|hl|tel)?|armv7-a)$")
    set(result arm32)
  else()
    message(FATAL_ERROR "SOUI not_supported: unknown target architecture '${value}'; no x86/x64 fallback is permitted.")
  endif()
  set(${output} "${result}" PARENT_SCOPE)
endfunction()

# Compile only: no target executables are run, including during cross builds.
function(_soui_probe_compiler_arch output universal target_os)
  if(CMAKE_CXX_COMPILER_LOADED)
    include(CheckCXXSourceCompiles)
    set(language CXX)
  elseif(CMAKE_C_COMPILER_LOADED)
    include(CheckCSourceCompiles)
    set(language C)
  else()
    set(${output} "" PARENT_SCOPE)
    return()
  endif()
  set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
  set(CMAKE_REQUIRED_QUIET TRUE)
  if(target_os STREQUAL "windows")
    set(os_condition "defined(_WIN32)")
  elseif(target_os STREQUAL "linux")
    set(os_condition "defined(__linux__) && !defined(__ANDROID__)")
  else()
    set(os_condition "defined(__APPLE__) && defined(__MACH__) && !defined(__ENVIRONMENT_IPHONE_OS_VERSION_MIN_REQUIRED__) && !defined(__ENVIRONMENT_TV_OS_VERSION_MIN_REQUIRED__) && !defined(__ENVIRONMENT_WATCH_OS_VERSION_MIN_REQUIRED__)")
  endif()
  if(universal)
    set(names universal2)
    set(condition_universal2 "(defined(__x86_64__) || defined(__aarch64__)) && !defined(_M_ARM64EC)")
  else()
    set(names x86 x64 arm32 arm64)
    set(condition_x86 "defined(__i386__) || defined(_M_IX86)")
    set(condition_x64 "(defined(__x86_64__) || defined(_M_X64) || defined(_M_AMD64)) && !defined(_M_ARM64EC)")
    set(condition_arm32 "(defined(__arm__) || defined(_M_ARM)) && !defined(_M_ARM64EC)")
    set(condition_arm64 "(defined(__aarch64__) || defined(_M_ARM64)) && !defined(_M_ARM64EC)")
  endif()
  set(result "")
  foreach(name IN LISTS names)
    # Do not reuse a result after compiler flags/architecture selections change.
    set(probe "_SOUI_ARCH_PROBE_${name}")
    unset(${probe} CACHE)
    unset(${probe})
    set(source "#if !(${os_condition})\n#error Compiler target operating system conflicts with CMAKE_SYSTEM_NAME\n#endif\n#if !(${condition_${name}})\n#error Unsupported target architecture\n#endif\nint main(void) { return 0; }\n")
    if(language STREQUAL "CXX")
      check_cxx_source_compiles("${source}" ${probe})
    else()
      check_c_source_compiles("${source}" ${probe})
    endif()
    if(${probe})
      list(APPEND result "${name}")
    endif()
    unset(${probe} CACHE)
  endforeach()
  list(LENGTH result matches)
  if(NOT matches EQUAL 1)
    message(FATAL_ERROR "SOUI not_supported: compiler OS/architecture probe failed or target is unknown/ARM64EC. Check CMAKE_SYSTEM_NAME, the target toolchain and flags; no host-architecture fallback is permitted.")
  endif()
  set(${output} "${result}" PARENT_SCOPE)
endfunction()

# Outputs:
# SOUI_TARGET_OS, SOUI_TARGET_ARCH, SOUI_TARGET_ARCHITECTURES (canonical list),
# SOUI_TARGET_POINTER_SIZE (bytes), SOUI_TARGET_CROSSCOMPILING,
# SOUI_PORTABLE_CORE_SUPPORTED, SOUI_DESKTOP_HOST_SUPPORTED,
# SOUI_PREBUILT_DEPENDENCIES_SUPPORTED.
function(soui_detect_platform)
  _soui_normalize_os("${CMAKE_SYSTEM_NAME}" target_os)
  set(declared_arches "")
  foreach(variable CMAKE_GENERATOR_PLATFORM CMAKE_VS_PLATFORM_NAME
      CMAKE_CXX_COMPILER_ARCHITECTURE_ID CMAKE_C_COMPILER_ARCHITECTURE_ID)
    if(DEFINED ${variable} AND NOT "${${variable}}" STREQUAL "")
      if(target_os STREQUAL "macos" AND "${variable}" MATCHES "_COMPILER_ARCHITECTURE_ID$")
        # CMake can identify every slice of an Apple universal compiler output.
        # Do not drop malformed empty entries from a compiler slice list.
        foreach(value IN LISTS ${variable})
          _soui_normalize_arch("${value}" normalized)
          list(APPEND declared_arches "${normalized}")
        endforeach()
      else()
        # Visual Studio permits "x64,version=..." in generator-platform settings.
        # Other hints remain single-architecture, including outside macOS.
        string(REGEX REPLACE ",.*$" "" value "${${variable}}")
        _soui_normalize_arch("${value}" normalized)
        list(APPEND declared_arches "${normalized}")
      endif()
    endif()
  endforeach()
  foreach(variable CMAKE_CXX_COMPILER_TARGET CMAKE_C_COMPILER_TARGET)
    if(DEFINED ${variable} AND NOT "${${variable}}" STREQUAL "")
      string(REGEX REPLACE "-.*$" "" value "${${variable}}")
      _soui_normalize_arch("${value}" normalized)
      list(APPEND declared_arches "${normalized}")
    endif()
  endforeach()
  set(processor_arch "")
  if(NOT "${CMAKE_SYSTEM_PROCESSOR}" STREQUAL "")
    _soui_normalize_arch("${CMAKE_SYSTEM_PROCESSOR}" processor_arch)
  endif()
  list(REMOVE_DUPLICATES declared_arches)

  set(osx_arches "")
  if(NOT target_os STREQUAL "macos" AND NOT "${CMAKE_OSX_ARCHITECTURES}" STREQUAL "")
    message(FATAL_ERROR "SOUI not_supported: CMAKE_OSX_ARCHITECTURES requires a macOS target.")
  endif()
  if(target_os STREQUAL "macos" AND NOT "${CMAKE_OSX_ARCHITECTURES}" STREQUAL "")
    foreach(value IN LISTS CMAKE_OSX_ARCHITECTURES)
      _soui_normalize_arch("${value}" normalized)
      if(NOT normalized MATCHES "^(x64|arm64)$")
        message(FATAL_ERROR "SOUI not_supported: macOS supports only x64, arm64 or universal2; '${value}' is unsupported.")
      endif()
      list(APPEND osx_arches "${normalized}")
    endforeach()
    list(REMOVE_DUPLICATES osx_arches)
  endif()
  list(LENGTH osx_arches osx_count)
  if(osx_count EQUAL 2)
    set(universal TRUE)
    set(target_arch universal2)
    # Stable order regardless of the user-provided list order.
    set(target_arches x64 arm64)
    foreach(value IN LISTS declared_arches)
      if(NOT value IN_LIST target_arches)
        message(FATAL_ERROR "SOUI not_supported: conflicting macOS compiler and architecture-list targets.")
      endif()
    endforeach()
  else()
    set(universal FALSE)
  endif()
  _soui_probe_compiler_arch(compiler_arch "${universal}" "${target_os}")

  if(NOT universal)
    if(NOT "${compiler_arch}" STREQUAL "")
      set(target_arch "${compiler_arch}")
    elseif(declared_arches)
      list(GET declared_arches 0 target_arch)
    elseif(osx_arches)
      list(GET osx_arches 0 target_arch)
    else()
      _soui_normalize_arch("${CMAKE_SYSTEM_PROCESSOR}" target_arch)
    endif()
    foreach(value IN LISTS declared_arches osx_arches)
      if(NOT value STREQUAL target_arch)
        message(FATAL_ERROR "SOUI not_supported: conflicting target architecture '${value}' and compiler target '${target_arch}'.")
      endif()
    endforeach()
    set(target_arches "${target_arch}")
  endif()
  # On Apple platforms CMAKE_SYSTEM_PROCESSOR may remain the host CPU even
  # for an explicit -arch selection. On Windows it also remains the host CPU
  # for VS -A and cross developer prompts/compiler targets. The explicit target
  # plus compiler probe is authoritative; the declared target was checked
  # against the actual compiler above. Linux toolchain processor contradictions
  # must still fail instead of silently selecting the host compiler.
  set(windows_compiler_selection FALSE)
  if(target_os STREQUAL "windows" AND declared_arches)
    set(windows_compiler_selection TRUE)
  endif()
  if(NOT "${processor_arch}" STREQUAL "" AND NOT osx_arches AND NOT windows_compiler_selection)
    if(NOT processor_arch STREQUAL target_arch)
      if(NOT (processor_arch MATCHES "^(x86|x64)$" AND target_arch MATCHES "^(x86|x64)$"))
        message(FATAL_ERROR "SOUI not_supported: CMAKE_SYSTEM_PROCESSOR '${processor_arch}' conflicts with compiler target '${target_arch}'. Fix the cross-compiling toolchain; a host compiler cannot substitute for the target compiler.")
      endif()
    endif()
  endif()
  if(target_os STREQUAL "macos" AND target_arch MATCHES "^(x86|arm32)$")
    message(FATAL_ERROR "SOUI not_supported: macOS does not support ${target_arch}; use x64, arm64 or universal2.")
  endif()
  if(target_arch MATCHES "^(x86|arm32)$")
    set(expected_size 4)
  else()
    set(expected_size 8)
  endif()
  if(NOT "${CMAKE_SIZEOF_VOID_P}" MATCHES "^(4|8)$")
    message(FATAL_ERROR "SOUI not_supported: missing or unsupported target pointer size '${CMAKE_SIZEOF_VOID_P}'. Call soui_detect_platform after enabling a C/C++ compiler.")
  elseif(NOT CMAKE_SIZEOF_VOID_P EQUAL expected_size)
    message(FATAL_ERROR "SOUI not_supported: target ${target_arch} requires ${expected_size}-byte pointers, but the compiler reports ${CMAKE_SIZEOF_VOID_P}. Check the target ABI/toolchain.")
  endif()

  set(desktop FALSE)
  if(target_os STREQUAL "windows" AND target_arch MATCHES "^(x86|x64)$")
    set(desktop TRUE)
  endif()
  set(SOUI_TARGET_OS "${target_os}" PARENT_SCOPE)
  set(SOUI_TARGET_ARCH "${target_arch}" PARENT_SCOPE)
  set(SOUI_TARGET_ARCHITECTURES "${target_arches}" PARENT_SCOPE)
  set(SOUI_TARGET_POINTER_SIZE "${CMAKE_SIZEOF_VOID_P}" PARENT_SCOPE)
  set(SOUI_TARGET_CROSSCOMPILING "${CMAKE_CROSSCOMPILING}" PARENT_SCOPE)
  set(SOUI_PORTABLE_CORE_SUPPORTED TRUE PARENT_SCOPE)
  set(SOUI_DESKTOP_HOST_SUPPORTED "${desktop}" PARENT_SCOPE)
  set(SOUI_PREBUILT_DEPENDENCIES_SUPPORTED "${desktop}" PARENT_SCOPE)
endfunction()

function(soui_require_capability capability)
  if(NOT DEFINED SOUI_TARGET_OS OR NOT DEFINED SOUI_TARGET_ARCH)
    soui_detect_platform()
  endif()
  if(capability STREQUAL "portable_core")
    set(supported "${SOUI_PORTABLE_CORE_SUPPORTED}")
    set(reason "A supported target C++17 toolchain is required.")
  elseif(capability STREQUAL "system_desktop")
    set(supported "${SOUI_PORTABLE_CORE_SUPPORTED}")
    if(SOUI_TARGET_OS STREQUAL "windows" AND SOUI_TARGET_ARCH STREQUAL "arm32")
      set(supported FALSE)
    endif()
    set(reason "The opt-in system-WebView backend requires target SDK/runtime packages and native GUI validation; Windows ARM32 has no supported WebView2 distribution.")
  elseif(capability STREQUAL "desktop_host" OR capability STREQUAL "soui_prebuilt"
      OR capability STREQUAL "miniblink_prebuilt")
    set(supported "${SOUI_DESKTOP_HOST_SUPPORTED}")
    set(reason "The existing desktop host and SOUI/Miniblink prebuilt dependencies support Windows x86/x64 only. Use a fresh -DSOUI_BUILD_PORTABLE=ON build for Runtime, or -DSOUI_BUILD_DESKTOP=ON for the separate system-WebView path with target dependencies.")
  else()
    message(FATAL_ERROR "SOUI not_supported: unknown capability '${capability}'.")
  endif()
  if(NOT supported)
    message(FATAL_ERROR "SOUI not_supported: ${capability} on ${SOUI_TARGET_OS}/${SOUI_TARGET_ARCH}. ${reason}")
  endif()
endfunction()
