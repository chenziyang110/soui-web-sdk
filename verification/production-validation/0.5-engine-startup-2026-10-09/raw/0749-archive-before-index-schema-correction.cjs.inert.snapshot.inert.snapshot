  }
  mapping.push(entry);
}
const omitted = mapping.filter(item => !item.archivePath);
const summary = {schema: 'soui.engine-startup-persistent-evidence/v1', date: '2026-10-09',
  archiveHostObservation: {platform: process.platform, release: os.release(), arch: process.arch},
  frozenInput: frozenRecord, actualResults: actualResultRecord, indexProofs,
  rawSourceInputs: frozen.sources, actualNativeCompileInputs: frozen.nativeCompileInputs,
  sourceNormalization: 'none', nativeCompileInputCount: frozen.nativeCompileInputs.length,
  uniqueActualNativeJobs: phaseProofs.length, reusedX64CompileJobs: 2, newContinuationJobs: 20,
  phases: phaseProofs, architectures: result.architectures, binaryOutputs,
  firstHarnessError: firstResult.error, firstHarnessNativeTestsExecuted: false,
  audit: {finished: auditFinished, vulnerabilities: npmOutput.metadata.vulnerabilities, noInstall: true, packageInputs: auditInputs.packages},
  controlledRegressionObserved: true, actualSdkLibraryCompiled: true, compilerTailAcceptance: false,
  allPositiveGenericSupervisionPassed: false, validationPassed: false, releaseReady: false,
  noFullDistributionValidation: true, noGuiValidation: true, noVendorKernelValidation: true,
