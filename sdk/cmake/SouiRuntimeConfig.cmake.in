@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
set(SouiRuntime_TARGET_OS "@SOUI_TARGET_OS@")
set(SouiRuntime_TARGET_ARCH "@SOUI_TARGET_ARCH@")
include("${CMAKE_CURRENT_LIST_DIR}/SouiPlatform.cmake")
soui_detect_platform()
if(NOT SOUI_TARGET_OS STREQUAL SouiRuntime_TARGET_OS)
  set(SouiRuntime_FOUND FALSE)
  set(SouiRuntime_NOT_FOUND_MESSAGE "SouiRuntime was built for ${SouiRuntime_TARGET_OS}, but the consumer targets ${SOUI_TARGET_OS}")
  return()
endif()
if(NOT SOUI_TARGET_ARCH STREQUAL SouiRuntime_TARGET_ARCH AND
    NOT (SouiRuntime_TARGET_ARCH STREQUAL "universal2" AND SOUI_TARGET_ARCH MATCHES "^(x64|arm64|universal2)$"))
  set(SouiRuntime_FOUND FALSE)
  set(SouiRuntime_NOT_FOUND_MESSAGE "SouiRuntime was built for ${SouiRuntime_TARGET_ARCH}, but the consumer targets ${SOUI_TARGET_ARCH}")
  return()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/SouiRuntimeTargets.cmake")
set(SouiRuntime_Runtime_FOUND TRUE)
check_required_components(SouiRuntime)
