'use strict';
const fs = require('node:fs'), path = require('node:path'), crypto = require('node:crypto');
const assert = require('node:assert/strict');
const root = 'F:/work/sm05-startup';
const continuation = path.join(root, 'out/engine-startup-continuation-7e151d3f-4976-49af-a4cc-e68831db35c6');
const actual = path.join(continuation, 'actual-70059d03-7f13-4310-a50d-565bbb7d0382');
const hash = b => crypto.createHash('sha256').update(b).digest('hex');
const json = f => JSON.parse(fs.readFileSync(f));
const record = f => { const b = fs.readFileSync(f); return {path:f, bytes:b.length, sha256:hash(b)}; };
const checks = [];
function verify(r) { const b=fs.readFileSync(r.path); assert.equal(b.length,r.bytes,r.path); assert.equal(hash(b),r.sha256,r.path); return b; }
const helper = path.join(continuation,'toolchain-evidence.cjs');
assert.equal(record(helper).sha256, '47c23f30c595c7ba89ad7a99e8661b15e3f7ebb9c0a7bc10eee23b5f574aa192');
const reader = require(helper), frozenPath = path.join(continuation,'frozen-inputs-final.json');
assert.equal(record(frozenPath).sha256, 'd3058e44941616b9d50d1ae10bedfa7d64d38aed93a471c151933e4b28a8aa02');
const frozen = json(frozenPath), results = json(path.join(actual,'results.json'));
for (const r of [...frozen.sources,...frozen.nativeCompileInputs,...frozen.privateInputs,
  ...frozen.originalPrivateInputs,...frozen.toolchainImports,...Object.values(frozen.tools),
  frozen.priorAttempt.index,frozen.priorAttempt.results,...frozen.priorAttempt.payloadFiles]) verify(r);
for (const dir of [actual,frozen.priorAttempt.directory]) {
  const indexPath=path.join(dir,'index.json'), index=json(indexPath);
  for(const r of index.files) verify(r);
  checks.push({kind:'unchanged-private-index',...record(indexPath),payloadFiles:index.files.length});
}
assert.equal(results.controlledRegressionObserved,true);
assert.equal(results.validationPassed,false);
assert.equal(results.allPositiveGenericSupervisionPassed,false);
assert.equal(results.fullDistributionCompiled,false);
assert.equal(results.phases.length,22);
const phases = new Map(results.phases.map(p=>[p.name,p]));
for(const p of phases.values()) {
  const read=reader.readPhase(p,frozen);
  assert.equal(read.start.pid,p.ready.pid);
  assert.equal(read.start.creationFileTime,p.ready.creationFileTime);
  checks.push({kind:'owned-phase',name:p.name,pid:read.start.pid,creationFileTime:read.start.creationFileTime,
    rootExit:p.result.exitCode,supervisorExit:p.result.supervisorExitCode,genericPassed:p.genericSupervisionPassed,
    reason:read.terminal.reason,terminatedOwnedJob:read.terminal.terminatedOwnedJob,
    activeBeforeCleanup:read.terminal.activeBeforeCleanup,closureConfirmed:read.terminal.closureConfirmed,
    report:record(p.result.report),context:record(p.result.report+'.context.json')});
}
for(const architecture of results.architectures) {
  const name=architecture.architecture;
  assert.equal(architecture.ctestPassed,3); assert.equal(architecture.directControlledCasesPassed,9);
  assert.equal(architecture.oldBodyDestructorBoundaryObserved,true);
  assert.equal(architecture.actualSdkLibraryCompiled,true); assert.equal(architecture.compilationCompleted,true);
  assert.equal(architecture.compilationGenericSupervisionPassed,false);
  assert.equal(architecture.compilerTailAcceptance,false); assert.equal(architecture.fullDistributionCompiled,false);
  const compile=phases.get(name+'-compile'), build=name==='x64'?frozen.priorAttempt.build:path.join(actual,'b-x86');
  const toolchain=reader.readToolchain(build,name,frozen,compile);
  for(const p of toolchain.projects) assert.equal(p.macroEnabled,
    p.target==='soui_engine_thread_startup_tests'||p.target==='EngineStartupRed');
  const stored=json(architecture.toolchainEvidence.path); verify(architecture.toolchainEvidence);
  assert.deepEqual(toolchain.projects,stored.projects);
  assert.deepEqual(toolchain.observedTools,stored.observedTools);
  assert.equal(stored.evaluatedProjects.length,5);
  for(const e of stored.evaluatedProjects) {
    assert.equal(e.properties.VCToolsVersion,'14.44.35207'); assert.equal(e.properties.PlatformToolset,'v143');
    assert.equal(e.properties.WindowsTargetPlatformVersion,'10.0.19041.0');
    assert.equal(e.properties.PreferredToolArchitecture,'x64');
    assert(phases.get(e.phase).genericSupervisionPassed);
  }
  for(const suffix of ['ctest','direct-green','production-imports']) {
    const p=phases.get(name+'-'+suffix); assert.equal(p.result.exitCode,0); assert.equal(p.genericSupervisionPassed,true);
    assert.equal(p.result.terminal.terminatedOwnedJob,false); assert.equal(p.result.terminal.activeBeforeCleanup,0);
  }
  const direct=fs.readFileSync(path.join(actual,name+'-direct-green/stdout.bin'),'utf8');
  assert.equal((direct.match(/^PASS /gm)||[]).length,9); assert(direct.includes('9/9 passed'));
  const ctest=fs.readFileSync(path.join(actual,name+'-ctest/stdout.bin'),'utf8');
  assert(ctest.includes('100% tests passed, 0 tests failed out of 3'));
  const red=phases.get(name+'-old-body-red'); assert.equal(red.result.exitCode,124);
  assert.equal(red.genericSupervisionPassed,false); assert.equal(red.result.terminal.reason,'timeout');
  assert.equal(red.result.terminal.terminatedOwnedJob,true);
  assert.equal(fs.readFileSync(path.join(actual,name+'-old-body-red/stdout.bin'),'utf8'),
    'Controlled launch exception observed; old-body destructor follows\r\n');
  for(const output of architecture.outputs) {
    const b=verify(output);
    if(output.path.endsWith('.exe')) {
      assert.equal(b.readUInt16LE(0),0x5a4d); const pe=b.readUInt32LE(0x3c);
      assert.equal(b.readUInt32LE(pe),0x4550); assert.equal(b.readUInt16LE(pe+4),name==='x64'?0x8664:0x14c);
    } else assert.equal(b.subarray(0,8).toString('ascii'),'!<arch>\n');
  }
  checks.push({kind:'actual-sdk-and-controlled-native',architecture:name,outputs:architecture.outputs,
    toolchainEvidence:architecture.toolchainEvidence,ctestPassed:3,directControlledCases:9,
    oldBodyDestructorTimeout:true,macroDisabledInActualSdk:true,
    compilationReusedFromPriorAttempt:architecture.compilationReusedFromPriorAttempt,
    observedToolIdentityCount:toolchain.observedTools.reduce((n,t)=>n+t.observedProcesses.length,0)});
}
const proof={schema:'soui.engine-startup-root-byte-review/v1',createdAt:new Date().toISOString(),
  originalPrivateBytesUnchanged:true,controlledRegressionObserved:true,validationPassed:false,
  noCompilerTailOverride:true,fullDistributionCompiled:false,frozenInput:record(frozenPath),
  results:record(path.join(actual,'results.json')),checks};
const target=path.join(root,'out','root-startup-review-'+crypto.randomUUID()+'.json');
fs.writeFileSync(target,JSON.stringify(proof,null,2)+'\n',{flag:'wx'});
console.log(JSON.stringify({...record(target),phases:phases.size,controlledRegressionObserved:true,validationPassed:false}));
