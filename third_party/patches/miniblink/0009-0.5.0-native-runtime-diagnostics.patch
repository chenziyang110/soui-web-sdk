-			isolate->ThrowException(WinapiErrnoException(isolate,
-				GetLastError(),
-				"OpenFileMappingW"));
-			goto out;
-		}
-
-		handler = reinterpret_cast<LPTHREAD_START_ROUTINE*>(
-			MapViewOfFile(mapping,
