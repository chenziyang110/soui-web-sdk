'use strict';
const fs=require('node:fs');const path=require('node:path');const crypto=require('node:crypto');
const root=path.resolve(__dirname,'../..');
const client='F:/work/sm05/tools/internal/owned-process.cjs';const bootstrap='F:/work/sm05/out/benchmark-protocol/Release/OwnedProcessRunner.exe';
const {launchOwned}=require(client);const mode=process.argv[2];
const folder=path.join(__dirname,mode+'-'+crypto.randomUUID());fs.mkdirSync(folder);fs.copyFileSync(__filename,path.join(folder,'harness.cjs'));
const sha=file=>crypto.createHash('sha256').update(fs.readFileSync(file)).digest('hex');
const names=['tools/internal/owned-process.cjs','tools/internal/owned-tail-evidence.cjs','tools/internal/compiler-tail-policy.cjs',
 'tests/benchmark/tail-evidence-fixtures.cjs','tests/benchmark/owned-tail-evidence-reader.test.cjs','tests/benchmark/compiler-tail-policy.test.cjs',
 'tests/benchmark/owned-tail-client-boundaries.test.cjs','tests/benchmark/owned-tail-client-native.test.cjs','docs/adr/0031-compiler-tail-snapshot.md'];
const inputs=names.map(name=>({path:name,sha256:sha(path.join(root,name))}));
fs.writeFileSync(path.join(folder,'inputs.json'),JSON.stringify({schema:'soui.tail-js-validation-inputs/v1',inputs,client,clientSha256:sha(client),
 bootstrap,bootstrapSha256:sha(bootstrap),node:process.execPath,nodeVersion:process.version,noGui:true,actualCompilerTail:false},null,2)+'\n');
async function run(name,args,env={}) {
 const ownFolder=path.join(folder,name);fs.mkdirSync(ownFolder);
 const owned=launchOwned(process.execPath,args,{runner:bootstrap,cwd:root,report:path.join(ownFolder,'owned.ndjson'),
  timeoutMs:120000,drainMs:2500,stdout:'pipe',stderr:'pipe',env:{...process.env,...env}});
 const stdout=[],stderr=[];owned.child.stdout.on('data',b=>stdout.push(b));owned.child.stderr.on('data',b=>stderr.push(b));
 const result=await owned.finished;
 fs.writeFileSync(path.join(ownFolder,'stdout.bin'),Buffer.concat(stdout));fs.writeFileSync(path.join(ownFolder,'stderr.bin'),Buffer.concat(stderr));
 fs.writeFileSync(path.join(ownFolder,'finished.json'),JSON.stringify(result,null,2)+'\n');
 console.log(JSON.stringify({name,exitCode:result.exitCode,passed:result.passed,closureConfirmed:result.closureConfirmed,report:result.report}));
 if(!result.passed||!result.closureConfirmed||sha(result.report)!==result.reportSha256)throw Error('Outer generic supervision failed: '+name);
 return result;
}
async function main(){const results=[];
 if(mode==='pure')results.push(await run('reader-policy-client',['--test','tests/benchmark/owned-tail-evidence-reader.test.cjs',
  'tests/benchmark/compiler-tail-policy.test.cjs','tests/benchmark/owned-tail-client-boundaries.test.cjs','tests/benchmark/owned-process-client-boundaries.test.cjs']));
 else for(const arch of ['x86','x64']) {
  const release=path.join(root,'out/tail-'+arch,'Release');
  if(mode==='native')results.push(await run(arch+'-client',['--test','tests/benchmark/owned-tail-client-native.test.cjs'],{
   SOUI_TAIL_RUNNER:path.join(release,'OwnedProcessRunner.exe'),SOUI_TAIL_FIXTURE:path.join(release,'OwnedTailProcessFixture.exe'),
   SOUI_TAIL_JS_EVIDENCE_DIRECTORY:path.join(folder,arch+'-raw-tests')}));
  else if(mode==='legacy')results.push(await run(arch+'-legacy',['--test','tests/benchmark/owned-process-runner.test.cjs',
   'tests/benchmark/owned-process-client.test.cjs','tests/benchmark/owned-process-client-boundaries.test.cjs'],{
   SOUI_OWNED_PROCESS_RUNNER:path.join(release,'OwnedProcessRunner.exe')}));
  else throw Error('Expected pure/native/legacy');
 }
 for(const item of inputs)if(sha(path.join(root,item.path))!==item.sha256)throw Error('Source changed during validation: '+item.path);
 fs.writeFileSync(path.join(folder,'summary.json'),JSON.stringify(results,null,2)+'\n');console.log('Evidence: '+folder);
}
main().catch(error=>{console.error(error.stack);process.exitCode=1});
