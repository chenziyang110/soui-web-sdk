const frozenRecord = record(path.join(continuation, 'frozen-inputs-final.json'));
assert.equal(frozenRecord.sha256, 'd3058e44941616b9d50d1ae10bedfa7d64d38aed93a471c151933e4b28a8aa02');
const frozen = JSON.parse(verify(frozenRecord));
for (const item of [...frozen.sources, ...frozen.nativeCompileInputs, ...frozen.privateInputs,
  ...frozen.originalPrivateInputs, ...frozen.toolchainImports]) verify(item);
for (const item of Object.values(frozen.tools)) evidence.verify(item); // Tools are checked but never copied.
assert.equal(frozen.nativeCompileInputs.length, 66);
const firstResult = JSON.parse(bytes(path.join(first, 'results.json')));
assert.equal(firstResult.phases.length, 2); assert.equal(firstResult.controlledRegressionObserved, false);
assert.equal(firstResult.validationPassed, false); assert(firstResult.error.includes('<VCToolsVersion>14.44.35207</VCToolsVersion>'));
const actualResultRecord = record(path.join(actual, 'results.json'));
assert.equal(actualResultRecord.sha256, 'a33097915c7b87006b3146b5f89bb2dbb161c3a4fd2bc895a4b83ca344e903b8');
const result = JSON.parse(verify(actualResultRecord));
assert.equal(result.frozenInputSha256, frozenRecord.sha256);
assert.equal(result.controlledRegressionObserved, true); assert.equal(result.validationPassed, false);
assert.equal(result.allPositiveGenericSupervisionPassed, false); assert.equal(result.noTailAcceptance, true);
assert.equal(result.actualSdkLibraryCompiled, true); assert.equal(result.fullDistributionCompiled, false);
assert.equal(result.error, undefined); assert.equal(result.phases.length, 22);
const phaseProofs = [], binaryOutputs = [];
for (const phase of result.phases) {
  const native = evidence.readPhase(phase, frozen);
  if (/-(?:configure|compile)$/.test(phase.name)) {
    assert.equal(phase.result.exitCode, 0); assert.equal(phase.result.passed, false);
    assert.equal(phase.result.supervisorExitCode, 124); assert.equal(native.terminal.reason, 'owned-descendants-remain');
  } else if (phase.name.endsWith('-old-body-red')) {
    assert.equal(phase.result.passed, false); assert.equal(phase.result.exitCode, 124);
    assert.equal(phase.result.supervisorExitCode, 124); assert.equal(native.terminal.reason, 'timeout');
    assert(bytes(phase.raw.find(item => path.basename(item.path) === 'stdout.bin').path).toString('utf8')
      .includes('Controlled launch exception observed; old-body destructor follows'));
  } else {
    assert.equal(phase.result.exitCode, 0); assert.equal(phase.result.supervisorExitCode, 0);
    assert.equal(phase.result.passed, true); assert.equal(native.terminal.reason, 'completed');
    assert.equal(native.terminal.terminatedOwnedJob, false);
  }
  phaseProofs.push({name: phase.name, identity: phase.ready, reused: phase.reusedFromPriorAttempt === true,
    rootExitCode: phase.result.exitCode, supervisorExitCode: phase.result.supervisorExitCode,
    genericPassed: phase.result.passed, terminal: native.terminal, raw: phase.raw});
}
assert.equal(result.architectures.length, 2);
for (const architecture of result.architectures) {
  const arch = architecture.architecture;
  assert(arch === 'x86' || arch === 'x64'); assert.equal(architecture.outputs.length, 5);
  assert.equal(architecture.ctestPassed, 3); assert.equal(architecture.directControlledCasesPassed, 9);
  assert.equal(architecture.oldBodyDestructorBoundaryObserved, true);
  assert.equal(architecture.compilerTailAcceptance, false); assert.equal(architecture.compilationGenericSupervisionPassed, false);
  const compiled = result.phases.find(item => item.name === arch + '-compile');
  const build = arch === 'x64' ? frozen.priorAttempt.build : path.join(actual, 'b-x86');
  const toolchain = evidence.readToolchain(build, arch, frozen, compiled);
  const savedToolchain = JSON.parse(verify(architecture.toolchainEvidence));
  assert.deepEqual(savedToolchain.actualCompiler, toolchain.actualCompiler);
  assert.equal(savedToolchain.evaluatedProjects.length, 5);
  for (const item of savedToolchain.evaluatedProjects) {
    const phase = result.phases.find(phase => phase.name === item.phase);
    const evaluated = evidence.readProperties(bytes(phase.raw.find(item => path.basename(item.path) === 'stdout.bin').path), frozen, arch);
    assert.deepEqual(item.properties, evaluated.properties);
    item.evaluatedImportInputs.forEach(verify);
  }
  for (const output of architecture.outputs) {
    const data = verify(output);
    if (output.coffMachine !== undefined) {
      assert.equal(data.toString('ascii', 0, 2), 'MZ');
      assert.equal(data.readUInt16LE(data.readUInt32LE(0x3c) + 4), arch === 'x64' ? 0x8664 : 0x14c);
    } else assert.equal(data.toString('ascii', 0, 8), '!<arch>\n');
    binaryOutputs.push({architecture: arch, ...output, disposition: 'private-compiled-output-hash-only'});
  }
  for (const item of architecture.ctestDefinitions) {
    assert(verify(item.original).equals(verify(item.copied)));
  }
  const log = bytes(path.join(actual, 'ctest-' + arch, 'Testing/Temporary/LastTest.log')).toString('utf8');
  assert.equal((log.match(/Test Passed\./g) || []).length, 3);
  assert(log.includes('Engine startup controlled-fault regression: 9/9 passed'));
  assert(log.includes('Production engine implementation without TEST_ONLY hook definitions passed'));
  assert(log.includes('Engine diagnostics: owned late results and failure semantics passed'));
  const direct = bytes(path.join(actual, arch + '-direct-green/stdout.bin')).toString('utf8');
  assert(direct.includes('Engine startup controlled-fault regression: 9/9 passed'));
}
const auditInputs = JSON.parse(bytes(path.join(audit, 'inputs.json')));
const auditFinished = JSON.parse(bytes(path.join(audit, 'finished.json')));
const auditSummary = JSON.parse(bytes(path.join(audit, 'summary.json')));
auditInputs.tools.forEach(item => evidence.verify(item)); auditInputs.packages.forEach(verify);
assert.equal(auditInputs.root, root); assert.equal(auditInputs.noInstall, true); assert.equal(auditInputs.noTailPolicy, true);
const auditRaw = bytes(path.join(audit, 'owned.ndjson'));
assert.equal(hash(auditRaw), auditFinished.reportSha256); assert(auditRaw.toString('utf8').endsWith('\n'));
const auditRows = auditRaw.toString('utf8').trimEnd().split('\n').map(JSON.parse);
assert.equal(auditRows[0].pid, auditFinished.pid); assert.equal(auditRows[0].creationFileTime, auditFinished.creationFileTime);
assert(/^[1-9]\d*$/.test(auditFinished.creationFileTime) && BigInt(auditFinished.creationFileTime) <= 18446744073709551615n);
assert.deepEqual(auditRows.at(-1), auditFinished.terminal);
assert.equal(auditFinished.passed, true); assert.equal(auditFinished.closureConfirmed, true);
for (const key of ['stopRequested', 'fallbackUsed']) assert.equal(auditFinished[key], false);
for (const key of ['spawnError', 'reportError']) assert.equal(auditFinished[key], null);
assert.equal(auditFinished.exitCode, 0); assert.equal(auditFinished.supervisorExitCode, 0);
assert.equal(auditFinished.terminal.reason, 'completed'); assert.equal(auditFinished.terminal.activeProcesses, 0);
assert.equal(auditFinished.terminal.terminatedOwnedJob, false);
const auditContext = JSON.parse(bytes(path.join(audit, 'owned.ndjson.context.json')));
assert.equal(auditContext.executableSha256, auditInputs.tools[0].sha256);
assert.equal(auditContext.runnerSha256, frozen.tools.runner.sha256);
