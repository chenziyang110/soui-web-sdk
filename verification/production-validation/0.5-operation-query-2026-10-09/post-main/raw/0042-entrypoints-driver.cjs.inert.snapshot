'use strict';
const path=require('node:path'),{spawnSync}=require('node:child_process'),assert=require('node:assert/strict');
const root=path.resolve(__dirname,'..');
const script=`$tokens=$null;$errors=$null
$ast=[System.Management.Automation.Language.Parser]::ParseFile('${root.replace(/'/g,"''")}/tools/Test.ps1',[ref]$tokens,[ref]$errors)
if($errors.Count -gt 0){$errors|Out-String|Write-Error;exit 1}
$commands=@($ast.FindAll({param($a) $a -is [System.Management.Automation.Language.CommandAst]},$true)|ForEach-Object{$_.Extent.Text})
[ordered]@{commands=$commands;parserErrors=$errors.Count}|ConvertTo-Json -Depth 4 -Compress`;
const result=spawnSync('C:/Windows/System32/WindowsPowerShell/v1.0/powershell.exe',['-NoProfile','-Command',script],{cwd:root,encoding:'utf8',windowsHide:true});
assert.equal(result.status,0,result.stderr);const parsed=JSON.parse(result.stdout);assert.equal(parsed.parserErrors,0);
const commands=parsed.commands.filter(c=>c.startsWith('& node ')&&(c.includes("'tests/web/task-query.test.mjs'")||c.includes("'sdk/web/node_modules/typescript/bin/tsc'")));
assert.equal(commands.length,2);assert.ok(commands[0].includes('--test'));assert.ok(commands[1].includes("-p (Join-Path $root 'tests/web/task-query-types.tsconfig.json')"));
assert.equal(parsed.commands.filter(c=>c.startsWith('& ctest ')&&c.includes('--test-dir $output')).length,1);
console.log(JSON.stringify({schema:'soui.task-query-standard-entry-extraction/v1',actualPowerShellAst:true,commands,
 ctestEntryPresent:true,fullTestExecuted:false,nativeTargetsExecutedHere:false,fullCollectExecuted:false}));
