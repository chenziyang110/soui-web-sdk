# Keep the raw release identity separate from CMake's numeric package version.
# This is the same supported language as tools/internal/sdk-version.cjs, not
# unrestricted SemVer: stable, preview.N or rc.N; no build metadata/leading zero.
function(soui_input_ui_package_version raw output)
  string(LENGTH "${raw}" _length)
  if(_length GREATER 64 OR NOT raw MATCHES "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(preview|rc)\\.(0|[1-9][0-9]*))?$")
    message(FATAL_ERROR "Invalid SDK release identity: expected X.Y.Z, X.Y.Z-preview.N or X.Y.Z-rc.N")
  endif()
  set(_parts "${CMAKE_MATCH_1};${CMAKE_MATCH_2};${CMAKE_MATCH_3}")
  set(_package "${CMAKE_MATCH_1}.${CMAKE_MATCH_2}.${CMAKE_MATCH_3}")
  if(NOT "${CMAKE_MATCH_6}" STREQUAL "")
    list(APPEND _parts "${CMAKE_MATCH_6}")
  endif()
  foreach(_part IN LISTS _parts)
    string(LENGTH "${_part}" _part_length)
    if(_part_length GREATER 16 OR (_part_length EQUAL 16 AND _part STRGREATER "9007199254740991"))
      message(FATAL_ERROR "SDK release identity component exceeds the project safe-integer limit")
    endif()
  endforeach()
  set(${output} "${_package}" PARENT_SCOPE)
endfunction()

function(soui_input_ui_resolve_sdk)
  set(SOUI_INPUT_UI_SDK_VERSION "" CACHE STRING "Exact raw SDK release identity; empty follows source VERSION")
  set(_source_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../..")
  set(_in_source FALSE)
  if(TARGET Soui::Sdk)
    get_target_property(_imported Soui::Sdk IMPORTED)
    if(NOT _imported)
      set(_in_source TRUE)
    endif()
  endif()
  # A pre-existing source target already fixes the headers/library. An old
  # excluded benchmark cache cannot select a different SDK or break root builds.
  if(_in_source OR "${SOUI_INPUT_UI_SDK_VERSION}" STREQUAL "")
    if(NOT EXISTS "${_source_root}/VERSION")
      message(FATAL_ERROR "Missing VERSION: set SOUI_INPUT_UI_SDK_VERSION to the frozen installed release identity")
    endif()
    file(READ "${_source_root}/VERSION" _raw)
    string(STRIP "${_raw}" _raw)
  else()
    set(_raw "${SOUI_INPUT_UI_SDK_VERSION}")
  endif()
  soui_input_ui_package_version("${_raw}" _package)
  if(NOT TARGET Soui::Sdk)
    find_package(SouiSdk ${_package} EXACT CONFIG REQUIRED)
  endif()
  if(_in_source)
    set(_header "${_source_root}/sdk/include/soui/version.h")
    set(_kind source)
  else()
    set(_headers "")
    get_target_property(_includes Soui::Sdk INTERFACE_INCLUDE_DIRECTORIES)
    foreach(_include IN LISTS _includes)
      if(_include MATCHES "\\$<")
        message(FATAL_ERROR "Installed SDK include paths must be concrete for release identity verification")
      endif()
      if(EXISTS "${_include}/soui/version.h")
        file(REAL_PATH "${_include}/soui/version.h" _found)
        list(APPEND _headers "${_found}")
      endif()
    endforeach()
    list(REMOVE_DUPLICATES _headers)
    list(LENGTH _headers _header_count)
    if(NOT _header_count EQUAL 1)
      message(FATAL_ERROR "Installed SDK must provide exactly one identifiable soui/version.h")
    endif()
    list(GET _headers 0 _header)
    set(_kind installed)
  endif()
  if(NOT EXISTS "${_header}")
    message(FATAL_ERROR "SDK release identity header is missing: ${_header}")
  endif()
  file(STRINGS "${_header}" _defines REGEX "^[ \t]*#[ \t]*define[ \t]+SOUI_SDK_VERSION_STRING[ \t]+")
  list(LENGTH _defines _define_count)
  if(NOT _define_count EQUAL 1 OR NOT _defines MATCHES "^[ \t]*#[ \t]*define[ \t]+SOUI_SDK_VERSION_STRING[ \t]+\"([^\"]+)\"[ \t]*$")
    message(FATAL_ERROR "SDK version header must contain one literal SOUI_SDK_VERSION_STRING")
  endif()
  set(_actual_raw "${CMAKE_MATCH_1}")
  soui_input_ui_package_version("${_actual_raw}" _actual_package)
  if(NOT _actual_raw STREQUAL _raw)
    message(FATAL_ERROR "SDK raw release mismatch: requested '${_raw}', header declares '${_actual_raw}'")
  endif()
  set(SOUI_INPUT_UI_EFFECTIVE_SDK_VERSION "${_raw}" PARENT_SCOPE)
  set(SOUI_INPUT_UI_PACKAGE_VERSION "${_package}" PARENT_SCOPE)
  set(SOUI_INPUT_UI_SDK_VERSION_HEADER "${_header}" PARENT_SCOPE)
  set(SOUI_INPUT_UI_SDK_IDENTITY_KIND "${_kind}" PARENT_SCOPE)
  message(STATUS "Input/UI SDK release ${_raw}; EXACT package ${_package}; ${_kind} header ${_header}")
endfunction()
