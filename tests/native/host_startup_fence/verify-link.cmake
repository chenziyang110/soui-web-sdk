cmake_minimum_required(VERSION 3.24)
include("${CMAKE_CURRENT_LIST_DIR}/verify-inputs.cmake")
if(NOT STARTUP_MAP OR NOT EXISTS "${STARTUP_MAP}")
  message(FATAL_ERROR "Actual startup consumer MAP is required")
endif()
file(READ "${STARTUP_MAP}" startup_link_map)
string(TOLOWER "${startup_link_map}" startup_link_map_lower)
if(NOT startup_link_map_lower MATCHES "startup_observed_host\\.obj")
  message(FATAL_ERROR "Actual MAP does not bind the generated private Host object")
endif()
if(startup_link_map_lower MATCHES "soui_miniblink_host\\.obj")
  message(FATAL_ERROR "Actual MAP pulled the normal SDK Host archive member into the observer consumer")
endif()