'use strict';
const fs=require('node:fs'),path=require('node:path'),crypto=require('node:crypto'),assert=require('node:assert/strict');
const {execFileSync}=require('node:child_process');const Module=require('node:module');
const cwd=path.resolve(__dirname,'../..');const root=path.join(__dirname,'red-reader-'+crypto.randomUUID());fs.mkdirSync(root);
const hash=b=>crypto.createHash('sha256').update(b).digest('hex');
const baseline=execFileSync('git',['show','HEAD:benchmarks/protocol/check-pair-runs.cjs'],{cwd});
fs.writeFileSync(path.join(root,'baseline-reader.cjs'),baseline);fs.copyFileSync(__filename,path.join(root,'harness.cjs'));
const filename=path.join(cwd,'benchmarks/protocol/check-pair-runs.cjs');
const moduleOld=new Module(filename,module);moduleOld.filename=filename;moduleOld.paths=Module._nodeModulePaths(path.dirname(filename));
moduleOld._compile(baseline.toString('utf8'),filename);
const old=moduleOld.exports, current=require(filename);
const evidence=path.join(cwd,'verification/production-validation/benchmark-s02-full-preflight-2026-09-25/raw');
const source=path.join(evidence,'benchmark-s02-soui-20260925-run1');
let failure;try{old.loadRun(source,'soui');}catch(error){failure=error;}
assert(failure && /recorded trace verdict changed/.test(failure.message),'Original reader did not reproduce the migration failure');
const verdict=current.loadRun(source,'soui');assert.equal(verdict.identityBinding.legacyUnbound,true);
assert.equal(verdict.identityBinding.exactFileTimeBound,false);
const raw=[];function walk(folder){for(const e of fs.readdirSync(folder,{withFileTypes:true})){const file=path.join(folder,e.name);
 if(e.isDirectory())walk(file);else{const b=fs.readFileSync(file);raw.push({path:path.relative(source,file).replaceAll('\\','/'),bytes:b.length,sha256:hash(b)});}}}
walk(source);raw.sort((a,b)=>a.path.localeCompare(b.path));
const result={schema:'soui.reader-red-green/v1',baselineGitBlob:'HEAD:benchmarks/protocol/check-pair-runs.cjs',
 baselineSha256:hash(baseline),currentSha256:hash(fs.readFileSync(filename)),analyzerSha256:hash(fs.readFileSync(path.join(cwd,'benchmarks/protocol/check-run-traces.cjs'))),
 source,raw,red:{expectedRejection:true,error:failure.message},green:{legacyUnbound:true,exactFileTimeBound:false},
 scope:'Original Git reader evaluated against the imported v2 analyzer and unchanged historical raw; no old binary/benchmark execution'};
fs.writeFileSync(path.join(root,'result.json'),JSON.stringify(result,null,2)+'\n');
fs.writeFileSync(path.join(root,'stderr.bin'),Buffer.from(failure.stack+'\n'));
console.log(JSON.stringify({root,red:result.red,green:result.green}));
