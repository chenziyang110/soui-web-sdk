'use strict';
const fs=require('node:fs'),path=require('node:path'),crypto=require('node:crypto');
const root=path.resolve(__dirname,'../..'),folder=__dirname;
const client='F:/work/sm05/tools/internal/owned-process.cjs';
const runner='F:/work/sm05/out/benchmark-protocol/Release/OwnedProcessRunner.exe';
const {launchOwned}=require(client);
const sha=bytes=>crypto.createHash('sha256').update(bytes).digest('hex');
const encoded=x=>JSON.stringify(x,null,2)+'\n';
const fileRecord=filename=>{const b=fs.readFileSync(filename);return {path:filename,bytes:b.length,sha256:sha(b)};};
const [phase,arch]=process.argv.slice(2);
if(!['red-tail','build','protocol','native','entrypoints','boundaries'].includes(phase))throw Error('Invalid phase');
if(['build','protocol','native'].includes(phase)&&!['x86','x64'].includes(arch))throw Error('Invalid architecture');
const leaf=path.join(folder,phase+'-'+(arch||'both')+'-'+crypto.randomUUID());fs.mkdirSync(leaf);
let executable=process.execPath,args;
if(phase==='red-tail')args=['--test','--test-reporter=tap','tests/benchmark/measurement-preparation-source.test.cjs'];
else if(phase==='build'){
 executable='C:/Windows/System32/WindowsPowerShell/v1.0/powershell.exe';
 args=['-NoProfile','-ExecutionPolicy','Bypass','-File','tools/internal/Build-ValidationTools.ps1','-Architecture',arch,'-FreshConfigure'];
}else if(phase==='entrypoints')args=[path.join(folder,'entrypoints.cjs')];
else if(phase==='boundaries')args=[path.join(folder,'prepared-boundaries.cjs')];
else args=['tools/internal/measurement-validation.cjs',phase,arch];
const env={...process.env,MSBUILDDISABLENODEREUSE:'1',PSModulePath:'C:/Windows/system32/WindowsPowerShell/v1.0/Modules'};
for(const key of Object.keys(env))if(key.startsWith('BENCHMARK_')||key==='PROCESS_TREE_SAMPLER_EXE')delete env[key];
const sourceFiles=['tools/internal/measurement-validation.cjs','tests/benchmark/measurement-preparation-source.test.cjs',
 'tools/internal/Build-ValidationTools.ps1','benchmarks/protocol/owned-process-runner.cpp',
 'benchmarks/protocol/owned-tail-evidence.cpp','benchmarks/protocol/owned-tail-evidence.h',
 'tools/Test.ps1','tools/Collect-Verification.cjs'];
const inputs={schema:'soui.measurement-tail-integration-command/v1',phase,architecture:arch||null,cwd:root,executable,args,
 executableIdentity:fileRecord(executable),bootstrapClient:fileRecord(client),bootstrapRunner:fileRecord(runner),
 node:fileRecord(process.execPath),sourceFiles:sourceFiles.map(rel=>({relativePath:rel,...fileRecord(path.join(root,rel))})),
 harness:fileRecord(__filename),entrypointFixture:phase==='entrypoints'?fileRecord(path.join(folder,'entrypoints.cjs')):null,
 boundaryFixture:phase==='boundaries'?fileRecord(path.join(folder,'prepared-boundaries.cjs')):null,
 env:{MSBUILDDISABLENODEREUSE:env.MSBUILDDISABLENODEREUSE,PSModulePath:env.PSModulePath},noGui:true,noCorrectInputTrace:true};
if(phase!=='red-tail'){
 const frozen=JSON.parse(fs.readFileSync(path.join(folder,'source-frozen.json')));
 for(const item of frozen.files)if(fileRecord(path.join(root,item.path)).sha256!==item.sha256)throw Error('Frozen input changed '+item.path);
 inputs.frozenSourceSha256=frozen.sha256;
}
fs.writeFileSync(path.join(leaf,'inputs.json'),encoded(inputs),{flag:'wx'});
const stdout=fs.openSync(path.join(leaf,'stdout.log'),'wx'),stderr=fs.openSync(path.join(leaf,'stderr.log'),'wx');
(async()=>{let result;try{result=await launchOwned(executable,args,{runner,cwd:root,report:path.join(leaf,'owned.ndjson'),
 timeoutMs:phase==='build'?240000:180000,drainMs:phase==='build'?30000:3500,env,stdout,stderr}).finished;}
 finally{fs.closeSync(stdout);fs.closeSync(stderr);}
 fs.writeFileSync(path.join(leaf,'finished.json'),encoded(result),{flag:'wx'});
 const conclusion={phase,architecture:arch||null,leaf,rootExitCode:result.exitCode,genericSupervisionPassed:result.passed,
 closureConfirmed:result.closureConfirmed,termination:result.terminal?.terminatedOwnedJob,reason:result.terminal?.reason,
 reportSha256:result.reportSha256,compileCompleted:phase==='build'&&result.exitCode===0,
 compilerTailPolicyAccepted:false};
 fs.writeFileSync(path.join(leaf,'conclusion.json'),encoded(conclusion),{flag:'wx'});
 for(const input of inputs.sourceFiles)if(fileRecord(input.path).sha256!==input.sha256)throw Error('Phase source changed');
 if(phase!=='red-tail')for(const item of JSON.parse(fs.readFileSync(path.join(folder,'source-frozen.json'))).files)
  if(fileRecord(path.join(root,item.path)).sha256!==item.sha256)throw Error('Frozen input changed after phase '+item.path);
 console.log(encoded(conclusion));
 const okay=phase==='red-tail'?result.exitCode===1&&result.closureConfirmed:
  phase==='build'?result.exitCode===0&&result.closureConfirmed:result.passed&&result.closureConfirmed;
 if(!okay||result.spawnError||result.reportError||result.fallbackUsed)process.exitCode=1;
})().catch(error=>{fs.writeFileSync(path.join(leaf,'error.txt'),error.stack+'\n',{flag:'wx'});console.error(error.stack);process.exitCode=1;});
