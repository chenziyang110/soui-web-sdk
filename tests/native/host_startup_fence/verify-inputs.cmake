cmake_minimum_required(VERSION 3.24)
if(NOT STARTUP_TEST_DIR)
  set(STARTUP_TEST_DIR "${CMAKE_CURRENT_LIST_DIR}")
endif()
if(NOT SOUI_DISTRIBUTION_ROOT OR NOT IS_ABSOLUTE "${SOUI_DISTRIBUTION_ROOT}")
  message(FATAL_ERROR "The actual distribution root is required")
endif()
file(READ "${STARTUP_TEST_DIR}/source-pins.json" startup_pins)
foreach(group IN ITEMS liveFiles payloadFiles)
  if(group STREQUAL "liveFiles")
    set(pin_root "${SOUI_DISTRIBUTION_ROOT}")
  else()
    set(pin_root "${STARTUP_TEST_DIR}")
  endif()
  string(JSON count LENGTH "${startup_pins}" ${group})
  math(EXPR last "${count} - 1")
  foreach(i RANGE 0 ${last})
    string(JSON relative GET "${startup_pins}" ${group} ${i} path)
    string(JSON expected_bytes GET "${startup_pins}" ${group} ${i} canonical bytes)
    string(JSON expected_sha GET "${startup_pins}" ${group} ${i} canonical sha256)
    if(IS_ABSOLUTE "${relative}" OR relative MATCHES "(^|/)\\.\\.(/|$)")
      message(FATAL_ERROR "Startup input is not project-relative")
    endif()
    set(input "${pin_root}/${relative}")
    if(NOT EXISTS "${input}" OR IS_DIRECTORY "${input}")
      message(FATAL_ERROR "Required startup input absent: ${group}/${relative}")
    endif()
    # Only CRLF becomes LF. Lone CR and every other byte remain significant.
    file(READ "${input}" actual_body)
    string(REPLACE "\r\n" "\n" actual_canonical "${actual_body}")
    string(LENGTH "${actual_canonical}" actual_bytes)
    string(SHA256 actual_sha "${actual_canonical}")
    if(NOT actual_bytes EQUAL expected_bytes OR NOT actual_sha STREQUAL expected_sha)
      message(FATAL_ERROR "Required startup input changed: ${group}/${relative}")
    endif()
  endforeach()
endforeach()
foreach(kind IN ITEMS sdk_cpp sdk_private_h sdk_public_h)
  string(JSON count LENGTH "${startup_pins}" inventories ${kind})
  math(EXPR last "${count} - 1")
  set(declared)
  foreach(i RANGE 0 ${last})
    string(JSON relative GET "${startup_pins}" inventories ${kind} ${i})
    list(APPEND declared "${relative}")
  endforeach()
  list(SORT declared)
  if(kind STREQUAL "sdk_cpp")
    file(GLOB_RECURSE actual RELATIVE "${SOUI_DISTRIBUTION_ROOT}" "${SOUI_DISTRIBUTION_ROOT}/sdk/src/*.cpp")
  elseif(kind STREQUAL "sdk_private_h")
    file(GLOB_RECURSE actual RELATIVE "${SOUI_DISTRIBUTION_ROOT}" "${SOUI_DISTRIBUTION_ROOT}/sdk/src/*.h")
  else()
    file(GLOB_RECURSE actual RELATIVE "${SOUI_DISTRIBUTION_ROOT}" "${SOUI_DISTRIBUTION_ROOT}/sdk/include/*.h")
  endif()
  list(SORT actual)
  if(NOT actual STREQUAL declared)
    message(FATAL_ERROR "Actual SDK startup inventory changed: ${kind}")
  endif()
endforeach()
# CMake string offsets and lengths are byte counts; no source re-encoding occurs.
file(READ "${SOUI_DISTRIBUTION_ROOT}/sdk/src/host/soui_miniblink_host.cpp" startup_host_raw_body)
string(REPLACE "\r\n" "\n" startup_generated_host_body "${startup_host_raw_body}")
file(READ "${STARTUP_TEST_DIR}/observer-edits.json" startup_edits)
string(JSON edit_count LENGTH "${startup_edits}")
if(NOT edit_count EQUAL 6)
  message(FATAL_ERROR "Exactly six read-only observer insertions are required")
endif()
foreach(i RANGE 0 5)
  string(JSON offset GET "${startup_edits}" ${i} byteOffset)
  string(JSON before_bytes GET "${startup_edits}" ${i} beforeBytes)
  string(JSON after_bytes GET "${startup_edits}" ${i} afterBytes)
  string(JSON before GET "${startup_edits}" ${i} before)
  string(JSON after GET "${startup_edits}" ${i} after)
  string(JSON before_sha GET "${startup_edits}" ${i} beforeSha256)
  string(JSON after_sha GET "${startup_edits}" ${i} afterSha256)
  string(LENGTH "${before}" measured_before_bytes)
  string(LENGTH "${after}" measured_after_bytes)
  string(SHA256 measured_before_sha "${before}")
  string(SHA256 measured_after_sha "${after}")
  if(NOT measured_before_bytes EQUAL before_bytes OR NOT measured_after_bytes EQUAL after_bytes
     OR NOT measured_before_sha STREQUAL before_sha OR NOT measured_after_sha STREQUAL after_sha)
    message(FATAL_ERROR "Observer span declaration changed: ${i}")
  endif()
  string(SUBSTRING "${startup_generated_host_body}" ${offset} ${before_bytes} actual_before)
  if(NOT actual_before STREQUAL before)
    message(FATAL_ERROR "Actual Host observer span changed: ${i}")
  endif()
  string(SUBSTRING "${startup_generated_host_body}" 0 ${offset} prefix)
  math(EXPR tail "${offset} + ${before_bytes}")
  string(SUBSTRING "${startup_generated_host_body}" ${tail} -1 suffix)
  set(startup_generated_host_body "${prefix}${after}${suffix}")
endforeach()
string(JSON startup_expected_generated_sha GET "${startup_pins}" generatedHost sha256)
string(SHA256 reconstructed_sha "${startup_generated_host_body}")
if(NOT reconstructed_sha STREQUAL startup_expected_generated_sha)
  message(FATAL_ERROR "Replayed private Host differs from the reviewed whole bytes")
endif()
if(STARTUP_GENERATED)
  if(NOT EXISTS "${STARTUP_GENERATED}")
    message(FATAL_ERROR "Generated private Host is absent")
  endif()
  file(SHA256 "${STARTUP_GENERATED}" actual_generated_sha)
  if(NOT actual_generated_sha STREQUAL startup_expected_generated_sha)
    message(FATAL_ERROR "Generated private Host changed before compilation or link")
  endif()
endif()