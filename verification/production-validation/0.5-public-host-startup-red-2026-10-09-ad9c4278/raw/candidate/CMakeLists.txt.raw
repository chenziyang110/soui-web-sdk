cmake_minimum_required(VERSION 3.24)
if(NOT SOUI_LIVE_ROOT)
  message(FATAL_ERROR "Root must identify the unchanged live distribution input")
endif()
get_filename_component(SOUI_LIVE_ROOT "${SOUI_LIVE_ROOT}" ABSOLUTE)
set(startup_candidate "${CMAKE_CURRENT_LIST_DIR}")
set(startup_shadow "${startup_candidate}/shadow")
file(READ "${startup_candidate}/source-pins.json" startup_pins)
foreach(group IN ITEMS liveFiles shadowFiles payloadFiles)
  if(group STREQUAL "liveFiles")
    set(pin_root "${SOUI_LIVE_ROOT}")
  elseif(group STREQUAL "shadowFiles")
    set(pin_root "${startup_shadow}")
  else()
    set(pin_root "${startup_candidate}")
  endif()
  string(JSON pin_count LENGTH "${startup_pins}" ${group})
  math(EXPR last_pin "${pin_count} - 1")
  foreach(i RANGE 0 ${last_pin})
    string(JSON relative GET "${startup_pins}" ${group} ${i} path)
    string(JSON expected_bytes GET "${startup_pins}" ${group} ${i} bytes)
    string(JSON expected_sha GET "${startup_pins}" ${group} ${i} sha256)
    set(source "${pin_root}/${relative}")
    if(NOT EXISTS "${source}")
      message(FATAL_ERROR "Required startup input absent: ${group}/${relative}")
    endif()
    file(SIZE "${source}" actual_bytes)
    file(SHA256 "${source}" actual_sha)
    if(NOT actual_bytes EQUAL expected_bytes OR NOT actual_sha STREQUAL expected_sha)
      message(FATAL_ERROR "Required startup input changed: ${group}/${relative}")
    endif()
  endforeach()
endforeach()
foreach(kind IN ITEMS sdk_cpp sdk_private_h sdk_public_h)
  string(JSON declared_count LENGTH "${startup_pins}" inventories ${kind})
  math(EXPR last_declared "${declared_count} - 1")
  set(declared)
  foreach(i RANGE 0 ${last_declared})
    string(JSON relative GET "${startup_pins}" inventories ${kind} ${i})
    list(APPEND declared "${relative}")
  endforeach()
  list(SORT declared)
  foreach(inventory_root IN ITEMS "${SOUI_LIVE_ROOT}" "${startup_shadow}")
    if(kind STREQUAL "sdk_cpp")
      file(GLOB_RECURSE actual RELATIVE "${inventory_root}" "${inventory_root}/sdk/src/*.cpp")
    elseif(kind STREQUAL "sdk_private_h")
      file(GLOB_RECURSE actual RELATIVE "${inventory_root}" "${inventory_root}/sdk/src/*.h")
    else()
      file(GLOB_RECURSE actual RELATIVE "${inventory_root}" "${inventory_root}/sdk/include/*.h")
    endif()
    list(SORT actual)
    if(NOT actual STREQUAL declared)
      message(FATAL_ERROR "SDK startup inventory changed: ${kind}")
    endif()
  endforeach()
endforeach()
if(CHECK_ONLY)
  return()
endif()

project(SouiPublicHostStartupRed LANGUAGES C CXX)
if(NOT WIN32 OR NOT MSVC)
  message(FATAL_ERROR "This actual public Host test requires Windows/MSVC")
endif()
if(NOT IS_ABSOLUTE "${SOUI_KERNEL_PATH}" OR NOT EXISTS "${SOUI_KERNEL_PATH}")
  message(FATAL_ERROR "Root must supply the actual full-source kernel path")
endif()
string(LENGTH "${SOUI_KERNEL_SHA256}" kernel_sha_length)
if(NOT kernel_sha_length EQUAL 64 OR NOT SOUI_KERNEL_SHA256 MATCHES "^[0-9a-f]+$")
  message(FATAL_ERROR "Root must supply the actual lowercase kernel SHA256")
endif()
file(SHA256 "${SOUI_KERNEL_PATH}" actual_kernel_sha)
if(NOT actual_kernel_sha STREQUAL SOUI_KERNEL_SHA256)
  message(FATAL_ERROR "Actual kernel bytes changed")
endif()
set(SOUI_BUILD_WEBVIEW2 OFF CACHE BOOL "" FORCE)
set(SOUI_BUILD_UIA OFF CACHE BOOL "" FORCE)
set(CMAKE_MSVC_RUNTIME_LIBRARY MultiThreadedDLL)
add_subdirectory("${startup_shadow}/sdk" sdk)
add_executable(soui_public_host_startup_red WIN32 fixture.cpp)
target_compile_features(soui_public_host_startup_red PRIVATE cxx_std_17)
target_compile_options(soui_public_host_startup_red PRIVATE /utf-8 /W4 /EHsc /U_DEBUG)
target_link_libraries(soui_public_host_startup_red PRIVATE Soui::Sdk Soui::ActionJson)
add_custom_target(verify_public_host_startup_sources
  COMMAND "${CMAKE_COMMAND}" "-DSOUI_LIVE_ROOT=${SOUI_LIVE_ROOT}" -DCHECK_ONLY=ON
          -P "${CMAKE_CURRENT_LIST_FILE}" VERBATIM)
add_dependencies(soui_sdk verify_public_host_startup_sources)
add_dependencies(soui_public_host_startup_red verify_public_host_startup_sources)
enable_testing()
add_test(NAME host_startup_registration_before_return COMMAND soui_public_host_startup_red
  --kernel "${SOUI_KERNEL_PATH}" --kernel-sha "${SOUI_KERNEL_SHA256}"
  --resources "${startup_candidate}/resources" --output "${CMAKE_BINARY_DIR}/host-startup-ctest-result.json")
set_tests_properties(host_startup_registration_before_return PROPERTIES
  TIMEOUT 20 RUN_SERIAL TRUE ENVIRONMENT "SOUI_DIAGNOSTIC_SCRIPT=1")
