new file mode 100644
index 00000000..58553ee8
--- /dev/null
+++ b/third_party/sources/miniblink/cc/trees/IndependentInputTrace.h
@@ -0,0 +1,119 @@
+#ifndef CC_TREES_INDEPENDENT_INPUT_TRACE_H_
+#define CC_TREES_INDEPENDENT_INPUT_TRACE_H_
+
+#include "cc/trees/InputFrameCoverage.h"
+#include "cc/input/ScrollController.h"
+#include <array>
+
+namespace cc {
+// Scene authority metadata; it is independent of recorder configuration/loss.
+struct SceneInputIdentity {
+    uint64_t view = 0, generation = 0, document = 0, geometry = 0;
+    void set(const InputFrameCoverage::Event& value)
+    {
+        view = value.view_id; generation = value.view_generation;
+        document = value.document_generation; geometry = value.geometry_generation;
+    }
+    bool matches(const InputFrameCoverage::Event& value) const
+    {
+        return view && generation && document && geometry && view == value.view_id
+            && generation == value.view_generation && document == value.document_generation
+            && geometry == value.geometry_generation;
+    }
+};
+
+class IndependentInputTrace {
+public:
+    using Event = InputFrameCoverage::Event;
+    static const size_t maximumEntries = 32;
+    bool append(const Event& value, const ScrollNodeKey& node, uint64_t epoch,
+        uint64_t receipt, double inputTime, bool smooth)
+    {
+        if (!InputFrameCoverage::validRange(value) || !receipt || !epoch
+            || m_size == maximumEntries)
+            return false;
+        Entry& entry = m_entries[m_size++];
+        entry = Entry{};
+        entry.event = value; entry.node = node; entry.epoch = epoch;
+        entry.receipt = receipt; entry.inputTime = inputTime; entry.smooth = smooth;
+        return true;
+    }
+    void adopt(const ScrollNodeKey& node, uint64_t epoch, uint64_t throughReceipt,
+        double sampleTime, bool validVisualSample)
+    {
+        if (!validVisualSample)
+            return;
+        for (size_t index = 0; index < m_size; ++index) {
+            Entry& entry = m_entries[index];
+            if (entry.node == node && entry.epoch == epoch && entry.receipt <= throughReceipt
+                && (!entry.smooth || sampleTime > entry.inputTime))
+                entry.adopted = true;
+        }
+    }
+    bool takeForPaint(const Event& actualFrame, Event* result)
+    {
+        if (!result || !actualFrame.frame_id)
+            return false;
+        for (size_t index = 0; index < m_size; ++index) {
+            const Entry& entry = m_entries[index];
+            if (!entry.adopted || !InputFrameCoverage::sameGeneration(entry.event, actualFrame))
+                continue;
+            *result = entry.event;
+            result->frame_id = actualFrame.frame_id;
+            result->task_id = 0; // Filled only from the actual executing compositor context, if known.
+            result->action_first = actualFrame.action_first;
+            result->action_last = actualFrame.action_last;
+            result->flags = content::input_frame_trace::coverage_valid;
+            result->outcome = content::input_frame_trace::terminal::none;
+            result->why = content::input_frame_trace::reason::accepted;
+            result->value = entry.receipt; // Compositor receipt, never the router input sequence.
+            result->related_id = actualFrame.related_id; // Actual scene identity.
+            remove(index);
+            return true;
+        }
+        return false;
+    }
+    bool takeStale(const Event& confirmed, Event* result)
+    {
+        for (size_t index = 0; result && index < m_size; ++index) {
+            if (!InputFrameCoverage::sameGeneration(m_entries[index].event, confirmed)) {
+                *result = m_entries[index].event;
+                remove(index);
+                return true;
+            }
+        }
+        return false;
+    }
+    bool takeNode(const ScrollNodeKey& node, uint64_t epoch, Event* result)
+    {
+        for (size_t index = 0; result && index < m_size; ++index) {
+            if (m_entries[index].node == node && m_entries[index].epoch == epoch) {
+                *result = m_entries[index].event;
+                remove(index);
+                return true;
+            }
+        }
+        return false;
+    }
+    size_t size() const { return m_size; }
+    bool takeAny(Event* result)
+    {
+        if (!result || !m_size)
+            return false;
+        *result = m_entries[--m_size].event;
+        return true;
+    }
+private:
+    struct Entry {
+        Event event;
+        ScrollNodeKey node;
+        uint64_t epoch = 0, receipt = 0;
+        double inputTime = 0;
+        bool smooth = false, adopted = false;
+    };
+    void remove(size_t index) { m_entries[index] = m_entries[--m_size]; }
+    std::array<Entry, maximumEntries> m_entries{};
+    size_t m_size = 0;
+};
+} // namespace cc
+#endif
diff --git a/third_party/sources/miniblink/cc/trees/InputFrameCoverage.h b/third_party/sources/miniblink/cc/trees/InputFrameCoverage.h
new file mode 100644
index 00000000..3cfea753
--- /dev/null
+++ b/third_party/sources/miniblink/cc/trees/InputFrameCoverage.h
@@ -0,0 +1,129 @@
+#ifndef CC_TREES_INPUT_FRAME_COVERAGE_H_
+#define CC_TREES_INPUT_FRAME_COVERAGE_H_
+
+#include "content/common/InputFrameTrace.h"
+#include <array>
+#include <limits>
+
+namespace cc {
+
+class InputFrameCoverage {
+public:
+    static const size_t maximumSegments = 32;
+    using Event = content::input_frame_trace::event;
+    bool append(const Event& value)
+    {
+        if (!validRange(value))
+            return false;
+        Event merged = value;
+        // Revisit after every union, since one new range can connect several
+        // explicitly adjacent segments. A gap is never filled by inference.
+        for (size_t index = 0; index < m_count;) {
+            const Event& previous = m_segments[index];
+            if (sameGeneration(previous, merged) && touches(previous, merged)) {
+                merged.input_first = previous.input_first < merged.input_first
+                    ? previous.input_first : merged.input_first;
+                merged.input_last = previous.input_last > merged.input_last
+                    ? previous.input_last : merged.input_last;
+                m_segments[index] = m_segments[--m_count];
+                index = 0;
+            } else {
+                ++index;
+            }
+        }
+        if (m_count == maximumSegments)
+            return false; // Only trace coverage is lost; never input or work.
+        m_segments[m_count++] = merged;
+        return true;
+    }
+    size_t size() const { return m_count; }
+    const Event& at(size_t index) const { return m_segments[index]; }
+    void clear() { m_count = 0; }
+    static bool sameGeneration(const Event& a, const Event& b)
+    {
+        return a.view_id == b.view_id && a.view_generation == b.view_generation
+            && a.document_generation == b.document_generation
+            && a.geometry_generation == b.geometry_generation;
+    }
+    static bool validRange(const Event& value)
+    {
+        return value.version == content::input_frame_trace::abi_version
+            && value.struct_size == sizeof(Event) && value.view_id
+            && value.view_generation && value.document_generation
+            && value.geometry_generation && value.input_first
+            && value.input_last >= value.input_first;
+    }
+private:
+    static bool touches(const Event& a, const Event& b)
+    {
+        const auto maximum = (std::numeric_limits<uint64_t>::max)();
+        return a.input_first <= b.input_last + (b.input_last != maximum)
+            && b.input_first <= a.input_last + (a.input_last != maximum);
+    }
+    std::array<Event, maximumSegments> m_segments{};
+    size_t m_count = 0;
+};
+
+class InputDispatchTraceStack {
+public:
+    using Event = InputFrameCoverage::Event;
+    static const size_t maximumDepth = 16;
+    bool enter(const Event& value, const Event* previous = nullptr)
+    {
+        if (m_exhausted)
+            return false;
+        if (!InputFrameCoverage::validRange(value))
+            return false;
+        if (m_overflowDepth || m_depth == maximumDepth) {
+            if (m_overflowDepth == (std::numeric_limits<size_t>::max)()) {
+                m_exhausted = true;
+                return false;
+            }
+            ++m_overflowDepth;
+            return false;
+        }
+        m_stack[m_depth] = value;
+        m_hasPrevious[m_depth] = previous != nullptr;
+        if (previous)
+            m_previous[m_depth] = *previous;
+        ++m_depth;
+        return true;
+    }
+    bool leave(const Event& clear, Event* processed, Event* restore = nullptr,
+        bool* hasRestore = nullptr)
+    {
+        if (m_exhausted)
+            return false;
+        if (m_overflowDepth) {
+            --m_overflowDepth;
+            return false;
+        }
+        if (!m_depth || !processed)
+            return false;
+        const Event value = m_stack[--m_depth];
+        if (hasRestore)
+            *hasRestore = m_hasPrevious[m_depth];
+        if (restore && m_hasPrevious[m_depth])
+            *restore = m_previous[m_depth];
+        if (!InputFrameCoverage::sameGeneration(value, clear))
+            return false;
+        *processed = value;
+        return true;
+    }
+    bool current(Event* value) const
+    {
+        if (!value || !m_depth || m_exhausted || m_overflowDepth)
+            return false;
+        *value = m_stack[m_depth - 1];
+        return true;
+    }
+private:
+    std::array<Event, maximumDepth> m_stack{};
+    std::array<Event, maximumDepth> m_previous{};
+    std::array<bool, maximumDepth> m_hasPrevious{};
+    size_t m_depth = 0;
+    size_t m_overflowDepth = 0;
+    bool m_exhausted = false;
+};
+} // namespace cc
+#endif
