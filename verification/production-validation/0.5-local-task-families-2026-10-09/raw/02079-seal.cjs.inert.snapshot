'use strict';
// Create-only private handoff/index. No build, native, GUI or process control.
const fs=require('node:fs'),path=require('node:path'),assert=require('node:assert/strict');
const e=require('./toolchain-evidence.cjs');
const write=(n,v)=>fs.writeFileSync(path.join(__dirname,n),typeof v==='string'?v:JSON.stringify(v,null,2)+'\n',{flag:'wx'});
const frozen=JSON.parse(fs.readFileSync(path.join(__dirname,'frozen-inputs-final.json')));
for(const row of [...frozen.privateInputs,...frozen.sources,...Object.values(frozen.tools),...frozen.toolchainImports,
    ...frozen.prior.payloadFiles,...frozen.prior.identityFiles,...frozen.futureReadPins])e.verify(row);
assert.equal(frozen.sources.length,16);assert.equal(frozen.prior.payloadFiles.length,473);
const checks=JSON.parse(fs.readFileSync(path.join(__dirname,'check-preparation-results.json')));assert.equal(checks.passed,12);
for(const prefix of ['driver','helper'])for(const channel of ['stdout','stderr'])assert.equal(fs.statSync(path.join(__dirname,prefix+'-syntax.'+channel+'.log')).size,0);
const argv=[frozen.tools.node.path,path.join(__dirname,'driver.cjs')];
write('README.md',`# Compact family continuation preparation\n\nRoot reviews the full driver/helper then executes handoff.json argv with no extra arguments. This preparation performed filesystem reads, two syntax checks and twelve pure checks only: no new compilation/native/GUI/VM execution. Source16 remains cb93c9e390aa53bc5c46196828b66f067e30824c5b5ca1387e294255c0f0fb3f.\n\nThe long-path first attempt stays failed (FTK1011); its exact index/failure and the Root relocation map are pinned. The second x64 attempt has 473 immutable indexed payloads, root-zero configure and compile, generic false/supervisor124 with completed owned cleanup. Neither old failure is overwritten or qualified. The same twelve compiled x64 projects (eleven EXE plus static SDK) are bound by actual source/tlogs, PE machine/output hashes and owned CL/Link/Lib/MSBuild PID/decimal FILETIME. Those bytes are reused without compiling x64 again.\n\nAll 41 prior read tlogs were enumerated: 6586 path references, 585 unique files. Using the actual old whole raw-source hash records (including wke.h), tools and vendor records binds 527; 41 are generated inside that owned attempt. The remaining 17 were observed only after compilation. Four touch selected projects: SortDefault.nls, System32/tzres.dll, exact MSVC Hostx64/x64/2052/clui.dll and cvtres.exe. Thirteen VCPKG libraries occur only in CMake CompilerId configure probes; they are not described as SDK formal-link dependencies. The initial narrow-pool enumeration and corrected whole-source classification both remain explicit private records. No old post-observation is retroactively pre-pinned. sourceReadFullyPrelaunchBound=false and qualificationPassed=false are retained.\n\nFuture x86 uses nineteen finite exact hash-only file pins: the seventeen observed paths plus the known Hostx64/x86 CLUI/CVTRES counterparts. No Windows directory or generic filename allowlist is used. Any new unknown/read-unavailable path is explicitly post-observed in the complete classification, with configure-probe versus selected-project references, and does not become an input-closure or qualification claim. Disk hashes describe the driver view at observation/preparation, not actual historical read bytes or loaded process memory.\n\nRoot will perform twelve fresh read-only MSBuild getProperty phases per architecture, validating MSVC14.44.35207/hostx64/SDK19041 and the default imports. Property evaluation must naturally close. CTest definitions are byte-copied to a fresh independent test directory and listed commands must exactly bind the original eleven compiled EXEs. CTest11/11 and direct normal13/private14 still await execution; only the dedicated private target uses TEST_ONLY for service/store/transport. Fresh x86 builds under this short private directory. Every new test/direct/property phase requires natural generictrue/zero; configure/compile root0 may continue after exact report/closure checks while genericfalse/124 stays false.\n\nOld indexed x64 build/CTest/tlogs are never written by this script; after each phase their complete frozen payload hashes are rechecked. All source and tools must remain fixed. Complete raw reports/contexts/argv/stdout/stderr are newly recorded, credentials and compiler override names removed only in child environment, values never dumped. Binlogs and external tool bodies remain private. Both old compiler tails keep the positive generic aggregate/validation false; no tail acceptance, GUI, OS identity, release, full toolchain isolation or long-term/performance claim is made.\n`);
write('handoff.json',{schema:'soui.family-compact-continuation-handoff/v1',argv,driver:e.record(path.join(__dirname,'driver.cjs')),
  helper:e.record(path.join(__dirname,'toolchain-evidence.cjs')),frozen:e.record(path.join(__dirname,'frozen-inputs-final.json')),
  original473Unchanged:true,source16Unchanged:true,source16Sha256:frozen.source16Sha256,
  priorIndexSha256:frozen.prior.originalIndexSha256,readTlogs:41,readReferences:6586,uniqueReads:585,
  prelaunchBoundUniqueReads:527,generatedUniqueReads:41,postObservedUniqueReads:17,futureExactFilePins:19,
  x64ReusedProjects:12,x64ReusedExecutables:11,x64ReusedStaticSdk:1,pureChecks:12,syntaxExitCodes:[0,0],
  newBuildExecuted:false,newNativeExecuted:false,qualificationPassed:false,sourceReadFullyPrelaunchBound:false,
  compilerTailAcceptance:false,releaseReady:false});
const files=e.walk(__dirname).map(p=>({relativePath:path.relative(__dirname,p).replace(/\\/g,'/'),...e.record(p)}));
write('index.json',{schema:'soui.family-compact-preparation-index/v1',files,newBuildExecuted:false,newNativeExecuted:false,
  qualificationPassed:false,sourceReadFullyPrelaunchBound:false,releaseReady:false});
console.log(JSON.stringify({argv,index:e.record(path.join(__dirname,'index.json')),payload:files.length,totalFiles:files.length+1,
  bytes:files.reduce((n,r)=>n+r.bytes,0),driver:e.record(path.join(__dirname,'driver.cjs')),helper:e.record(path.join(__dirname,'toolchain-evidence.cjs')),
  frozen:e.record(path.join(__dirname,'frozen-inputs-final.json')),source16Unchanged:true,original473Unchanged:true,newNativeExecuted:false}));
