cmake_minimum_required(VERSION 3.24)
if(NOT SOUI_DISTRIBUTION_ROOT)
  message(FATAL_ERROR "Set SOUI_DISTRIBUTION_ROOT to the exact Root-selected current source tree")
endif()
get_filename_component(SOUI_DISTRIBUTION_ROOT "${SOUI_DISTRIBUTION_ROOT}" ABSOLUTE)
file(READ "${CMAKE_CURRENT_LIST_DIR}/source-pins.json" input_pins)
string(JSON pin_count LENGTH "${input_pins}" files)
math(EXPR last_pin "${pin_count} - 1")
foreach(i RANGE 0 ${last_pin})
  string(JSON relative GET "${input_pins}" files ${i} path)
  string(JSON expected_bytes GET "${input_pins}" files ${i} bytes)
  string(JSON expected_sha GET "${input_pins}" files ${i} sha256)
  set(source "${SOUI_DISTRIBUTION_ROOT}/${relative}")
  if(NOT EXISTS "${source}")
    message(FATAL_ERROR "Required real source is absent: ${relative}")
  endif()
  file(SIZE "${source}" actual_bytes)
  file(SHA256 "${source}" actual_sha)
  if(NOT actual_bytes EQUAL expected_bytes OR NOT actual_sha STREQUAL expected_sha)
    message(FATAL_ERROR "Required real source changed: ${relative}")
  endif()
endforeach()
foreach(kind IN ITEMS sdk_cpp sdk_private_h sdk_public_h)
  string(JSON declared_count LENGTH "${input_pins}" inventories ${kind})
  math(EXPR last_declared "${declared_count} - 1")
  set(declared)
  foreach(i RANGE 0 ${last_declared})
    string(JSON relative GET "${input_pins}" inventories ${kind} ${i})
    list(APPEND declared "${relative}")
  endforeach()
  if(kind STREQUAL "sdk_cpp")
    file(GLOB_RECURSE actual RELATIVE "${SOUI_DISTRIBUTION_ROOT}" "${SOUI_DISTRIBUTION_ROOT}/sdk/src/*.cpp")
  elseif(kind STREQUAL "sdk_private_h")
    file(GLOB_RECURSE actual RELATIVE "${SOUI_DISTRIBUTION_ROOT}" "${SOUI_DISTRIBUTION_ROOT}/sdk/src/*.h")
  else()
    file(GLOB_RECURSE actual RELATIVE "${SOUI_DISTRIBUTION_ROOT}" "${SOUI_DISTRIBUTION_ROOT}/sdk/include/*.h")
  endif()
  list(SORT actual)
  list(SORT declared)
  if(NOT actual STREQUAL declared)
    message(FATAL_ERROR "Normal SDK input membership changed: ${kind}")
  endif()
endforeach()
if(CHECK_ONLY)
  return()
endif()

project(SouiActualOleStartupSchedules LANGUAGES C CXX)
if(NOT WIN32 OR NOT MSVC)
  message(FATAL_ERROR "This fixture requires the actual Windows MSVC SDK")
endif()
if(NOT IS_ABSOLUTE "${SOUI_KERNEL_PATH}" OR NOT EXISTS "${SOUI_KERNEL_PATH}")
  message(FATAL_ERROR "Root must supply the actual absolute full-source kernel path")
endif()
if(NOT SOUI_KERNEL_SHA256 MATCHES "^[0-9a-f]+$")
  message(FATAL_ERROR "Root must supply the actual lowercase full-source kernel SHA256")
endif()
string(LENGTH "${SOUI_KERNEL_SHA256}" kernel_sha_length)
if(NOT kernel_sha_length EQUAL 64)
  message(FATAL_ERROR "Kernel SHA256 must have exactly 64 digits")
endif()
file(SHA256 "${SOUI_KERNEL_PATH}" kernel_sha)
if(NOT kernel_sha STREQUAL SOUI_KERNEL_SHA256)
  message(FATAL_ERROR "Actual kernel bytes differ from Root's producer pin")
endif()
set(SOUI_BUILD_WEBVIEW2 OFF CACHE BOOL "" FORCE)
set(SOUI_BUILD_UIA OFF CACHE BOOL "" FORCE)
set(CMAKE_MSVC_RUNTIME_LIBRARY MultiThreadedDLL)
add_subdirectory("${SOUI_DISTRIBUTION_ROOT}/sdk" sdk)
add_executable(soui_actual_ole_startup_schedules fixture.cpp)
target_compile_features(soui_actual_ole_startup_schedules PRIVATE cxx_std_17)
target_compile_definitions(soui_actual_ole_startup_schedules PRIVATE ENABLE_WKE=0)
target_compile_options(soui_actual_ole_startup_schedules PRIVATE /utf-8 /W4 /EHsc /U_DEBUG)
target_include_directories(soui_actual_ole_startup_schedules PRIVATE "${SOUI_DISTRIBUTION_ROOT}/sdk/src/host")
target_link_libraries(soui_actual_ole_startup_schedules PRIVATE Soui::Sdk Soui::ActionJson)
add_custom_target(verify_actual_ole_startup_sources
  COMMAND "${CMAKE_COMMAND}" "-DSOUI_DISTRIBUTION_ROOT=${SOUI_DISTRIBUTION_ROOT}" -DCHECK_ONLY=ON
          -P "${CMAKE_CURRENT_LIST_FILE}" VERBATIM)
add_dependencies(soui_sdk verify_actual_ole_startup_sources)
add_dependencies(soui_actual_ole_startup_schedules verify_actual_ole_startup_sources)
enable_testing()
foreach(schedule IN ITEMS matching ui-advance-before-ack ack-before-dispatch)
  string(REPLACE "-" "_" test_suffix "${schedule}")
  add_test(NAME "ole_startup_${test_suffix}" COMMAND soui_actual_ole_startup_schedules
    --kernel "${SOUI_KERNEL_PATH}" --kernel-sha "${SOUI_KERNEL_SHA256}" --case "${schedule}")
  set_tests_properties("ole_startup_${test_suffix}" PROPERTIES TIMEOUT 20 RUN_SERIAL TRUE
    ENVIRONMENT "SOUI_DIAGNOSTIC_SCRIPT=1")
endforeach()
