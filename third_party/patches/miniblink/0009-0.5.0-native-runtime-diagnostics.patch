+WebThread::Task* WorkerThread::wrapRawTask(PassOwnPtr<WebThread::Task> task, WorkerShutdownRecord::TaskKind kind)
+{
+    if (!m_managedShutdown) return task.leakPtr();
+    return new TrackedWorkerTask(this, task, kind);
+}
