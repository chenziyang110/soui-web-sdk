assert.equal(auditContext.tailImagePin, undefined);
assert.equal(auditSummary.auditAccepted, true); assert.equal(auditSummary.naturalClosure, true);
const npmOutput = JSON.parse(bytes(path.join(audit, 'stdout.bin')));
assert.equal(npmOutput.metadata.vulnerabilities.total, 0);

const allOriginal = new Map();
function add(file, group, originalRelativePath) {
  const key = canonical(file);
  if (!allOriginal.has(key)) allOriginal.set(key, {group, originalRelativePath, ...record(file)});
}
for (const item of roots) for (const file of walk(item.directory))
  add(file, item.name, path.relative(item.directory, file).replace(/\\/g, '/'));
for (const name of ['root-startup-review-5c480572-76e6-48c0-b5db-aae895a6aa55.json',
  'review-startup-continuation-root.cjs', 'review-startup-continuation-root-before-marker-correction.inert.snapshot',
  'audit-sdk-web-root.cjs']) add(path.join(root, 'out', name), 'root-review-and-audit-drivers', name);
for (const item of auditInputs.packages) add(item.path, 'audit-package-inputs', path.relative(root, item.path).replace(/\\/g, '/'));
add(__filename, 'archive-driver', path.basename(__filename));
add(path.join(__dirname, 'README.template.md'), 'archive-description', 'README.template.md');
assert.equal(record(path.join(root, 'out/root-startup-review-5c480572-76e6-48c0-b5db-aae895a6aa55.json')).sha256,
  '924fc1b4d37346ebc491dcaa391dee2c69cc876b3003e613b6aae191fe088127');
function disposition(item, data) {
  if (/\.binlog(?:\.inert\.snapshot)?$/i.test(item.path)) return 'private-msbuild-binlog-hash-only';
  const machine = data.length >= 2 ? data.readUInt16LE(0) : 0;
  const coff = data.length >= 20 && [0x14c, 0x8664].includes(machine) && data.readUInt16LE(2) > 0 && data.readUInt16LE(2) <= 96 && data.readUInt16LE(16) === 0;
  const bigObj = data.length >= 56 && data.readUInt16LE(0) === 0 && data.readUInt16LE(2) === 0xffff && [0x14c, 0x8664].includes(data.readUInt16LE(6));
  if (/\.(exe|dll|obj|lib|pdb|pch|idb|ilk|res|exp)(?:\.inert\.snapshot)?$/i.test(item.path) ||
      data.toString('ascii', 0, 2) === 'MZ' || data.toString('ascii', 0, 8) === '!<arch>\n' ||
      data.toString('ascii', 0, 24).startsWith('Microsoft C/C++ MSF') || coff || bigObj)
    return 'private-compiled-binary-hash-only';
  if (/[/\\]b-(?:x64|x86)[/\\]/i.test(item.path) && /\.bin$/i.test(item.path)) return 'private-build-binary-hash-only';
  return 'byte-exact-inert-copy';
}
assert(!fs.existsSync(archive), 'Public archive must be create-only');
fs.mkdirSync(archive); safe(archive);
const mapping = [];
for (const [index, item] of [...allOriginal.values()].entries()) {
  const data = verify(item), kind = disposition(item, data);
  const entry = {...item, disposition: kind};
  if (kind === 'byte-exact-inert-copy') {
    const leaf = path.basename(item.path).replace(/[^A-Za-z0-9._-]/g, '_').slice(0, 90);
    const archivePath = 'raw/' + String(index).padStart(4, '0') + '-' + leaf + '.inert.snapshot';
