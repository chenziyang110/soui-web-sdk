+        ShutdownReadLocker locker(&m_manager->m_shutdownLock);
+        if (!locker.lock())
+            return;
+
+        if (!m_manager->downloadOnIoThread())
+            return;
+        if (m_manager->m_isShutdown)
+            return;
+
+        IoTask* task = new IoTask(m_manager, m_thread, true);
+        m_thread->postTask(FROM_HERE, task);
