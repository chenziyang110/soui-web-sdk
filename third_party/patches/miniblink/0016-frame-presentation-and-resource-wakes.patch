diff --git a/third_party/sources/miniblink/cc/trees/DirtyRegionPolicy.h b/third_party/sources/miniblink/cc/trees/DirtyRegionPolicy.h
new file mode 100644
index 000000000..c478a9ba7
--- /dev/null
+++ b/third_party/sources/miniblink/cc/trees/DirtyRegionPolicy.h
@@ -0,0 +1,46 @@
+#ifndef DirtyRegionPolicy_h
+#define DirtyRegionPolicy_h
+
+#include <cstddef>
+#include <limits>
+
+namespace cc {
+namespace dirty_region {
+
+struct MergeChoice {
+    size_t first;
+    size_t second; // count denotes the incoming rectangle.
+};
+
+// At the region cap, include the incoming rectangle in the least-cost choice.
+// Merging two old distant regions before considering a nearby incoming region
+// can inflate raster/paint work by almost a viewport.
+template<typename Rect, typename Area, typename UnionArea>
+inline MergeChoice leastCostMerge(const Rect* regions, size_t count,
+    const Rect& incoming, Area area, UnionArea unionArea)
+{
+    MergeChoice result = { 0, count };
+    double best = std::numeric_limits<double>::max();
+    for (size_t i = 0; i < count; ++i) {
+        const double incomingCost = unionArea(regions[i], incoming) - area(regions[i]) - area(incoming);
+        if (incomingCost < best) {
+            best = incomingCost;
+            result.first = i;
+            result.second = count;
+        }
+        for (size_t j = i + 1; j < count; ++j) {
+            const double cost = unionArea(regions[i], regions[j]) - area(regions[i]) - area(regions[j]);
+            if (cost < best) {
+                best = cost;
+                result.first = i;
+                result.second = j;
+            }
+        }
+    }
+    return result;
+}
+
+} // namespace dirty_region
+} // namespace cc
+
+#endif
diff --git a/third_party/sources/miniblink/cc/trees/FrameSchedulingPolicy.h b/third_party/sources/miniblink/cc/trees/FrameSchedulingPolicy.h
new file mode 100644
index 000000000..c08e93e15
--- /dev/null
+++ b/third_party/sources/miniblink/cc/trees/FrameSchedulingPolicy.h
@@ -0,0 +1,35 @@
+#ifndef FrameSchedulingPolicy_h
+#define FrameSchedulingPolicy_h
+
+#include <cmath>
+
+namespace cc {
+namespace frame_scheduling {
+
+// A late wake skips elapsed slots but retains the fractional phase. It never
+// replays a backlog, and an idle-to-dirty transition may draw immediately.
+inline double advanceDeadline(double deadline, double now, double interval)
+{
+    if (!(interval > 0) || !std::isfinite(interval))
+        return 0;
+    if (!(deadline > 0) || !std::isfinite(deadline))
+        return now + interval;
+    if (deadline > now)
+        return deadline;
+    double next = deadline + (std::floor((now - deadline) / interval) + 1) * interval;
+    if (!(next > now))
+        next += interval;
+    return next;
+}
+
+inline long long remainingDelayMilliseconds(double deadline, double now)
+{
+    if (!(deadline > now))
+        return 0;
+    return static_cast<long long>(std::ceil((deadline - now) * 1000.0));
+}
+
+} // namespace frame_scheduling
+} // namespace cc
+
+#endif
