-		pid = (DWORD)args[0]->IntegerValue();
-
-		process = OpenProcess(PROCESS_CREATE_THREAD | PROCESS_QUERY_INFORMATION |
-			PROCESS_VM_OPERATION | PROCESS_VM_WRITE |
-			PROCESS_VM_READ,
-			FALSE,
