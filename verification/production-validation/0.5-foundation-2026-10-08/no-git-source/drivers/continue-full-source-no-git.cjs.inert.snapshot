'use strict';
const fs=require('node:fs'),path=require('node:path'),crypto=require('node:crypto');
const {launchOwned}=require('../tools/internal/owned-process.cjs');
const root=path.resolve(__dirname,'..');
const previous=path.resolve('F:/work/soui-05-source-validation-b68cc42e-ad9c-49a7-8e5b-20ac5ef05a12');
const source=path.join(previous,'relocated-source');
const hash=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex');
const prior=JSON.parse(fs.readFileSync(path.join(previous,'report.json')));
const expected='e7519638abe291a21f9b03764677dd1ead8f6e27ede7a0df206de7d676477ff9';
const id=require(path.join(source,'tools/internal/delivery-identity.cjs'));
const evidence=require(path.join(source,'tools/internal/build-evidence.cjs'));
if(prior.completed||prior.sourceSha256!==expected||id.source(source).sha256!==expected)
 throw new Error('Prior failure/source identity is not the expected immutable validation attempt');
const attempt=path.join(previous,'continuation-'+crypto.randomUUID());fs.mkdirSync(attempt);
const original=path.join(root,'out/benchmark-protocol/Release/OwnedProcessRunner.exe');
const runnerFolder=path.join(root,'out/validation-bootstrap',hash(original));
const runner=path.join(runnerFolder,'OwnedProcessRunner.exe');
if(hash(runner)!==hash(original))throw new Error('Bootstrap identity');
const ps=path.join(process.env.SystemRoot,'System32/WindowsPowerShell/v1.0/powershell.exe');
const env={...process.env,MSBUILDDISABLENODEREUSE:'1',PSModulePath:path.join(process.env.SystemRoot,'System32/WindowsPowerShell/v1.0/Modules')};
const results=[],consumers=[];
const report={schema:'soui.full-source-no-git-continuation/v1',version:'0.5.0-preview.1',releaseReady:false,
 sourceDeliveryVerified:false,sourceSha256:expected,sourceGitCommit:prior.sourceGitCommit,
 originalSourceManifestSha256:prior.originalSourceManifestSha256,archive:prior.archive,
 archiveSha256:prior.archiveSha256,priorAttempt:previous,priorReportSha256:hash(path.join(previous,'report.json')),
 attempt,source,originalExtractionAbsent:!fs.existsSync(path.join(previous,'extracted-source')),
 priorFailurePreserved:true,
 correction:'Validation consumer now gives the helper its own external workspace/out; source ownership guard stays unchanged.',
 completed:false,results,consumers,
 limitations:['Immutable local validation source ZIP; not a fixed/published SDK/app package.',
  'SDK-only both architectures with WebView2 plus installed external consumer, no generated application startup.',
  'Generic compiler supervision remains separate; no name-only tail exception.',
  'Not offline restoration, target-system, long-load, licensing/signature or formal release acceptance.']};
const save=()=>fs.writeFileSync(path.join(attempt,'report.json'),JSON.stringify(report,null,2)+'\n');
async function run(name,exe,args,cwd,compile=false){
 const folder=path.join(attempt,name);fs.mkdirSync(folder);
 const log=fs.openSync(path.join(folder,'run.log'),'wx');
 const child=launchOwned(exe,args,{runner,cwd,report:path.join(folder,'owned.ndjson'),
  timeoutMs:compile?1200000:180000,drainMs:compile?30000:2000,env,stdout:log,stderr:log});
 const result=await child.finished;fs.closeSync(log);results.push({name,exe,args,cwd,compile,...result});save();
 console.log(JSON.stringify({name,exitCode:result.exitCode,passed:result.passed,
  closureConfirmed:result.closureConfirmed,reason:result.terminal?.reason}));
 if(result.exitCode!==0||!result.closureConfirmed||result.reportError||result.spawnError||result.fallbackUsed||
   (!compile&&!result.passed))throw new Error('Phase failed: '+name);
 return result;
}
function quoted(value){return "'"+value.replace(/'/g,"''")+"'";}
function pe(file){const b=fs.readFileSync(file),o=b.readUInt32LE(0x3c);
 if(b.toString('ascii',o,o+4)!=='PE\0\0')throw new Error('Invalid PE');return b.readUInt16LE(o+4);}
(async()=>{
 console.log('No-Git continuation: '+attempt);save();
 if(hash(prior.archive)!==prior.archiveSha256||hash(path.join(source,'source-manifest.json'))!==prior.originalSourceManifestSha256)
  throw new Error('Archive or manifest changed');
 for(const architecture of ['x86','x64']){
  let sdkRun=prior.results.find(r=>r.name==='sdk-build-x86');
  if(architecture==='x64')sdkRun=await run('sdk-build-x64',ps,['-NoProfile','-ExecutionPolicy','Bypass',
   '-File','tools/Build.ps1','-Architecture','x64','-Configuration','Release','-SdkOnly','-WithWebView2','-Install'],source,true);
  if(!sdkRun||sdkRun.exitCode!==0||!sdkRun.closureConfirmed)throw new Error('SDK compile proof missing');
  const build=evidence.verifyBuild(source,architecture,'Release',true);
  if(build.source.sha256!==expected||!build.optionalLibraries.webview2)throw new Error('SDK identity differs');
  const prefix=path.join(previous,'relocated-installed-'+architecture);
  if(architecture==='x64')fs.renameSync(path.join(source,'out/install/x64'),prefix);
  if(fs.existsSync(path.join(source,'out/install',architecture)))throw new Error('Original SDK prefix still exists');
  const consumerSource=path.join(previous,'external-consumer-source-'+architecture);
  if(architecture==='x64')fs.cpSync(path.join(source,'tests/package-consumer'),consumerSource,
   {recursive:true,errorOnExist:true,force:false});
  const consumerBuild=path.join(consumerSource,'out','consumer-'+architecture);
  const script=path.join(attempt,'consumer-'+architecture+'.ps1');
  fs.writeFileSync(script,["$ErrorActionPreference='Stop'",
   '. '+quoted(path.join(source,'tools/internal/CMake-Configure.ps1')),
   '$consumerWorkspace='+quoted(consumerSource),'$consumerBuild='+quoted(consumerBuild),
   '$cmake=(Get-Command cmake.exe -ErrorAction Stop).Source',
   "$configureArguments=@(Get-SouiCMakeConfigureArguments -CMake $cmake -WorkspaceRoot $consumerWorkspace -SourceDirectory $consumerWorkspace -BuildDirectory $consumerBuild -Architecture '"+architecture+"')",
   '& $cmake @configureArguments '+quoted('-DCMAKE_PREFIX_PATH='+prefix),
   "if($LASTEXITCODE -ne 0){exit $LASTEXITCODE}",
   '& $cmake --build $consumerBuild --config Release --parallel 2',"exit $LASTEXITCODE"].join('\r\n')+'\r\n',{flag:'wx'});
  const compile=await run('consumer-build-'+architecture,ps,['-NoProfile','-ExecutionPolicy','Bypass','-File',script],consumerSource,true);
  const project=path.join(consumerBuild,'soui_consumer.vcxproj');
  const projectText=fs.readFileSync(project,'utf8');
  if(!projectText.includes('<WindowsTargetPlatformVersion>10.0.19041.0</WindowsTargetPlatformVersion>')||
    !projectText.includes('<PlatformToolset>v143</PlatformToolset>'))throw new Error('External SDK selection differs');
  const exe=path.join(consumerBuild,'Release/soui_consumer.exe');
  if(pe(exe)!==(architecture==='x86'?0x14c:0x8664))throw new Error('External PE architecture differs');
  const library=fs.readFileSync(path.join(consumerBuild,'consumer-library-Release.txt'),'utf8').trim();
  if(path.resolve(library)!==path.join(prefix,'lib/Release/soui_sdk.lib'))throw new Error('External library differs');
  const execution=await run('consumer-run-'+architecture,exe,[],path.dirname(exe));
  consumers.push({architecture,buildId:build.buildId,sdkLibrarySha256:hash(library),optionalWebView2Library:build.optionalLibraries.webview2,
   installedPrefixRelocated:true,consumerExeSha256:hash(exe),peMachine:'0x'+pe(exe).toString(16),
   actualWindowsSdk:'10.0.19041.0',actualToolset:'v143',consumerProjectSha256:hash(project),
   sdkCompileCompleted:sdkRun.exitCode===0,sdkGenericSupervisionPassed:sdkRun.passed,
   consumerCompileCompleted:compile.exitCode===0,consumerGenericSupervisionPassed:compile.passed,
   consumerNaturalOwnedClosure:execution.passed});save();
  fs.copyFileSync(path.join(source,'out','sdk-'+architecture,'build-Release.json'),
   path.join(attempt,architecture+'-sdk-build.json'),fs.constants.COPYFILE_EXCL);
 }
 await run('no-git-after',process.execPath,['tools/internal/source-archive.cjs','verify'],source);
 report.sourceInputsUnchanged=id.source(source).sha256===expected;
 if(!report.sourceInputsUnchanged)throw new Error('Build changed source');
 report.completed=true;report.fullArchiveRoundTripVerified=true;report.noGitRelocatedSdkRebuildVerified=true;
 report.allGenericSupervisionPassed=results.every(r=>r.passed)&&prior.results
  .filter(r=>r.name!=='consumer-build-x86').every(r=>r.passed);save();
 console.log(JSON.stringify({completed:true,report:path.join(attempt,'report.json'),
  noGitRelocatedSdkRebuildVerified:true,allGenericSupervisionPassed:report.allGenericSupervisionPassed}));
})().catch(error=>{report.error=error.stack;save();console.error(error.stack);process.exitCode=1;});
