    const identity=await run('case-'+name,executable,[name,path.join(reference,'common/fixture.json')],15000);
    const text=fs.readFileSync(path.join(output,'case-'+name+'.stdout.raw'),'utf8');if(!text.endsWith('\n')||text.trimEnd().split(/\r?\n/).length!==1||identity.stderr.bytes!==0)throw Error('Unique native receipt required');
    const receipt=JSON.parse(text.trim());if(JSON.stringify(Object.keys(receipt).sort())!==JSON.stringify(['case','creationFileTime','passed','pid','qualificationPassed','releaseReady','schema'].sort())||receipt.schema!=='soui.reference-native/1'||receipt.case!==name||receipt.passed!==true||typeof receipt.pid!=='string'||receipt.pid!==String(identity.pid)||typeof receipt.creationFileTime!=='string'||receipt.creationFileTime!==identity.creationFileTime||receipt.qualificationPassed!==false||receipt.releaseReady!==false)throw Error('Actual post-join receipt/Owned identity mismatch');
    receipts.push({name,receipt,identity});
   }
   await run('ctest-four',tools.ctest.path,['--test-dir',build,'-C','Release','--output-on-failure','--no-tests=error','-j','1','--timeout','15','--output-junit',path.join(output,'ctest.junit.xml')],120000);
   const junit=fs.readFileSync(path.join(output,'ctest.junit.xml'),'utf8');if(!/<testsuite\b/.test(junit)||/<(?:failure|error|skipped)\b/.test(junit)||JSON.stringify([...junit.matchAll(/<testcase\b[^>]*name="([^"]+)"/g)].map(m=>m[1]).sort())!==JSON.stringify(packet.cases.map(p=>'reference.native.'+p).sort()))throw Error('Exact successful JUnit4 required');
   for(const p of artifacts)pin(p);sourceCheck();packageCheck();toolCheck();producerCheck();
   json(path.join(output,'summary.json'),{completed:true,mode:'native',architecture:a['--arch'],stages,receipts,directCases:4,registeredCTestCases:4,normalSdkCppCount:24,normalSdkRecompiled:false,installedSdkProducer:'actual-native-v10',actualV3BusinessBytes:true,realBridgeJoinBeforeReceipt:true,sdkGuiControllerRuntimeExercised:false,rendererExercised:false,allGenericPassed:stages.every(p=>p.genericPassed),qualificationPassed:false,releaseReady:false});
   if(stages.some(p=>p.genericPassed!==true))process.exitCode=1;
  console.log(JSON.stringify({completed:true,mode:a['--mode'],output,qualificationPassed:false,releaseReady:false}));
 }catch(error){json(path.join(output,'summary-failed.json'),{completed:false,mode:a['--mode'],architecture:a['--arch'],stages,error:error.message,qualificationPassed:false,releaseReady:false});throw error;}
}
main().catch(error=>{console.error(error.message);process.exitCode=1;});
