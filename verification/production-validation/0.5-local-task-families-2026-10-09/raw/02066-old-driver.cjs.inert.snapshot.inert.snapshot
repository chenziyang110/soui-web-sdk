      write(target + '-' + arch + '-cases.json', {target, architecture: arch, actualCases: cases.length, cases,
        reportSha256: run.summary.reportSha256, contextSha256: run.summary.contextSha256, naturallyCompleted: run.summary.passed,
        privateSeam: target.includes('_prepare_'), realOsOomProven: false, releaseReady: false});
