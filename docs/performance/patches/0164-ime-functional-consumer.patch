+// Dedicated native-API payload replay. No SDK/OS IME packet is manufactured.
+// Application storage, delegate and adapter must outlive normal Runtime drain.
+class ime_api_replay final : public sdk::bridge_adapter {
+  using json=nlohmann::json;
+  using view=void*;
+  using exec=void*;
+  using js_value=std::int64_t; // wkedefine.h: jsValue=__int64, WKE_CALL_TYPE=__cdecl.
+  struct api final {
+    view (__cdecl* current_view)(){};
+    exec (__cdecl* global_exec)(view){};
+    int (__cdecl* view_id)(view){};
+    bool (__cdecl* alive)(int){};
+    HWND (__cdecl* hwnd)(view){};
+    js_value (__cdecl* run_js)(view,const char*){};
+    const char* (__cdecl* string)(exec,js_value){};
+    void (__cdecl* focus)(view){};
+    void (__cdecl* blur)(view){};
+    bool (__cdecl* compose)(view,const wchar_t*,int,int){};
+    bool (__cdecl* confirm)(view,const wchar_t*){};
+  };
+  struct state final {
+    explicit state(std::string run,std::filesystem::path binary)
+      :run(std::move(run)),binary(std::move(binary)),capture_id("ime-api-replay:"+this->run),ui(GetCurrentThreadId()){}
+    std::string run; std::filesystem::path binary; std::string capture_id; DWORD ui{};
+    sdk::dynamic_miniblink_adapter* adapter{}; HWND owner{};
+    std::atomic<sdk::engine_thread*> engine{nullptr};
+    api functions; HMODULE module{};
+    std::atomic<bool> attached{false},started{false},captured{false},recipe_posted{false};
+    std::atomic<bool> cancelled{false},done{false},failed{false};
+    view native_view{}; int native_id{}; std::uint64_t receipt{};
+    DWORD engine_tid{}; // Published before captured.release, never changed afterwards.
+    mutable std::mutex mutex;
+    json capture=json::object(),cases=json::array(); std::string error;
+  };
+  sdk::bridge_adapter& delegate_;
+  std::shared_ptr<state> state_;
+  static void require(bool value,const char* why){if(!value)throw std::runtime_error(why);}
+  static std::uint64_t qpc(){return sdk::diagnostics::input_frame_trace::now_qpc();}
+  static bool hex32(const std::string& s){return s.size()==32&&s.find_first_not_of("0123456789abcdef")==std::string::npos;}
+  static void fail(const std::shared_ptr<state>& s,const char* why) noexcept {
+    try {std::lock_guard<std::mutex> lock(s->mutex);if(s->done.load(std::memory_order_relaxed))return;
+      s->error=std::string(why?why:"E_IME_API_REPLAY_UNKNOWN").substr(0,256);
+      s->failed.store(true,std::memory_order_relaxed);s->done.store(true,std::memory_order_release);
+    }catch(...){s->failed.store(true,std::memory_order_relaxed);s->done.store(true,std::memory_order_release);}
+  }
+  template<class F> static F symbol(HMODULE module,const char* name){
+    const auto p=GetProcAddress(module,name);require(p!=nullptr,"E_IME_API_EXPORT");return reinterpret_cast<F>(p);
+  }
+  static void load_api(state& s){
+    s.module=GetModuleHandleW(s.binary.filename().c_str());require(s.module!=nullptr,"E_IME_API_MODULE");
+    wchar_t path[32768]{};const auto n=GetModuleFileNameW(s.module,path,32768);
+    require(n&&n<32768&&std::filesystem::equivalent(std::filesystem::path(path),s.binary),"E_IME_API_MODULE_IDENTITY");
+    auto& a=s.functions;
+    a.current_view=symbol<decltype(a.current_view)>(s.module,"wkeGetWebViewForCurrentContext");
+    a.global_exec=symbol<decltype(a.global_exec)>(s.module,"wkeGlobalExec");
+    a.view_id=symbol<decltype(a.view_id)>(s.module,"wkeGetWebviewId");
+    a.alive=symbol<decltype(a.alive)>(s.module,"wkeIsWebviewAlive");
+    a.hwnd=symbol<decltype(a.hwnd)>(s.module,"wkeGetHostHWND");
+    a.run_js=symbol<decltype(a.run_js)>(s.module,"wkeRunJS");
+    a.string=symbol<decltype(a.string)>(s.module,"jsToTempString");
+    a.focus=symbol<decltype(a.focus)>(s.module,"wkeSetFocus");
+    a.blur=symbol<decltype(a.blur)>(s.module,"wkeKillFocus");
+    a.compose=symbol<decltype(a.compose)>(s.module,"wkeSetComposition");
+    a.confirm=symbol<decltype(a.confirm)>(s.module,"wkeConfirmComposition");
+  }
+  static void owner(state& s){
+    const auto engine=s.engine.load(std::memory_order_acquire);
+    require(!s.cancelled.load(std::memory_order_acquire),"E_IME_API_CANCELLED");
+    require(engine&&engine->is_owner_thread(),"E_IME_API_ENGINE_OWNER");
+    require(s.adapter&&s.adapter->accepts_execution_context_receipt(s.receipt),"E_IME_API_CONTEXT_REVOKED");
+  }
+  // Fresh state on every step; no exec from the bootstrap callback is retained.
+  static exec checked(state& s){
+    owner(s);auto& a=s.functions;
+    require(s.native_view&&s.native_id&&a.alive(s.native_id),"E_IME_API_VIEW_RETIRED");
+    require(a.view_id(s.native_view)==s.native_id,"E_IME_API_VIEW_ID");
+    const auto e=a.global_exec(s.native_view);
+    require(e&&s.adapter->owns_execution_context(e,s.receipt),"E_IME_API_VIEW_CONTEXT");
+    owner(s);return e;
+  }
+  static json evaluate(state& s,const char* script){
+    require(script&&std::char_traits<char>::length(script)<=8192,"E_IME_API_SCRIPT_BOUND");
+    // wkeRunJS itself wraps its input in a function body. Return the controlled
+    // expression explicitly; an unreturned IIFE would execute yet yield undefined.
+    const std::string returning=std::string("return (")+script+");";
+    const auto e=checked(s);const auto value=s.functions.run_js(s.native_view,returning.c_str());
+    // Do not insert globalExec/opaque getters while the JS value/temp is live.
+    // Receipt/owner checks use native state; copy before the full revalidation.
+    owner(s);const auto bytes=s.functions.string(e,value);
+    require(bytes!=nullptr,"E_IME_API_JS_RESULT");std::size_t count=0;
+    while(count<=16384&&bytes[count])++count;
+    require(count&&count<=16384,"E_IME_API_JS_RESULT_BOUND");
+    const std::string copied(bytes,count);
+    (void)checked(s);return json::parse(copied);
+  }
+  static void phase(state& s,const char* script){
+    const auto result=evaluate(s,script);require(result.is_object()&&result.value("ok",false),"E_IME_API_PHASE");
+  }
+  static const char* setup_script(){return R"JS((function(){
+if(window.__souiImeApiReplay||document.getElementById('__soui_ime_api_probe'))throw Error('probe already exists');
+if(!document.body)throw Error('body unavailable');
+var box=document.createElement('div'),t=document.createElement('textarea');
+box.id='__soui_ime_api_probe';box.style.cssText='position:fixed;right:8px;bottom:8px;z-index:2147483647;background:white;padding:8px;border:1px solid #777';
+t.id='__soui_ime_api_text';t.setAttribute('aria-label','Native IME API replay');t.autocomplete='off';t.spellcheck=false;box.appendChild(t);document.body.appendChild(box);
+var p={area:t,rows:[],seq:0,phase:'setup',case_name:'',overflow:false};
+p.units=function(v,max){if(v.length>max)p.overflow=true;var a=[];for(var i=0;i<v.length&&i<max;i++)a.push(v.charCodeAt(i));return a;};
+p.snapshot=function(events){var r={schema:'soui.ime-api-dom/v1',case_name:p.case_name,phase:p.phase,value_utf16:p.units(t.value,16),selection_start:t.selectionStart,selection_end:t.selectionEnd,active_element:document.activeElement===t,document_has_focus:typeof document.hasFocus==='function'?!!document.hasFocus():null,event_count:p.rows.length,overflow:p.overflow};if(events)r.events=p.rows.slice();return r;};
+function record(e){if(p.rows.length>=32){p.overflow=true;return;}p.rows.push({seq:++p.seq,type:e.type,scope:e.target===window?'window':'textarea',data_utf16:typeof e.data==='string'?p.units(e.data,8):null,value_utf16:p.units(t.value,16),selection_start:t.selectionStart,selection_end:t.selectionEnd,active_element:document.activeElement===t,phase:p.phase});}
+var types=['focus','blur','input','compositionstart','compositionupdate','compositionend'];for(var i=0;i<types.length;i++)t.addEventListener(types[i],record,false);window.addEventListener('focus',record,false);window.addEventListener('blur',record,false);
+window.__souiImeApiReplay=p;return JSON.stringify({ok:true});})())JS";}
+  static const char* reset_script(bool refocus){return refocus?
+    R"JS((function(){var p=window.__souiImeApiReplay;if(!p)throw Error('probe missing');p.rows=[];p.seq=0;p.overflow=false;p.phase='reset';p.case_name='blur-refocus-final';p.area.value='';p.area.setSelectionRange(0,0);p.area.focus();return JSON.stringify({ok:true});})())JS":
+    R"JS((function(){var p=window.__souiImeApiReplay;if(!p)throw Error('probe missing');p.rows=[];p.seq=0;p.overflow=false;p.phase='reset';p.case_name='blur-final';p.area.value='';p.area.setSelectionRange(0,0);p.area.focus();return JSON.stringify({ok:true});})())JS";}
+  static json snapshot(state& s,bool full){
+    auto r=evaluate(s,full?"JSON.stringify(window.__souiImeApiReplay.snapshot(true))":"JSON.stringify(window.__souiImeApiReplay.snapshot(false))");
+    require(r.is_object()&&r.value("schema",std::string{})=="soui.ime-api-dom/v1"&&r.contains("overflow")&&!r.at("overflow").get<bool>(),"E_IME_API_DOM_SNAPSHOT");
+    return r;
+  }
+  static void capture(const std::shared_ptr<state>& s){
+    require(!s->cancelled.load(std::memory_order_acquire),"E_IME_API_CANCELLED");
+    const auto engine=s->engine.load(std::memory_order_acquire);
+    require(engine&&engine->is_owner_thread(),"E_IME_API_CAPTURE_OWNER");
+    require(!s->captured.load(std::memory_order_acquire),"E_IME_API_DUPLICATE_CAPTURE");
+    const auto receipt=s->adapter->execution_context_receipt();
+    require(receipt&&s->adapter->accepts_execution_context_receipt(receipt),"E_IME_API_CAPTURE_RECEIPT");
+    const auto v=s->functions.current_view();require(v!=nullptr,"E_IME_API_NO_CURRENT_VIEW");
+    const auto e=s->functions.global_exec(v);
+    require(e&&s->adapter->owns_execution_context(e,receipt),"E_IME_API_CAPTURE_NOT_OWNED");
+    const auto id=s->functions.view_id(v);require(id&&s->functions.alive(id),"E_IME_API_CAPTURE_NOT_ALIVE");
+    const auto hwnd=s->functions.hwnd(v);DWORD process=0;const auto thread=GetWindowThreadProcessId(hwnd,&process);
+    require(IsWindow(hwnd)&&process==GetCurrentProcessId()&&thread==s->ui&&(hwnd==s->owner||IsChild(s->owner,hwnd)),"E_IME_API_CAPTURE_HWND");
+    require(s->adapter->accepts_execution_context_receipt(receipt),"E_IME_API_CAPTURE_CHANGED");
+    s->native_view=v;s->native_id=id;s->receipt=receipt;s->engine_tid=GetCurrentThreadId();
+    {std::lock_guard<std::mutex> lock(s->mutex);s->capture={{"receipt",std::to_string(receipt)},{"view_id",id},{"hwnd",std::to_string(reinterpret_cast<std::uintptr_t>(hwnd))},{"engine_thread_id",s->engine_tid},{"qpc",std::to_string(qpc())},{"actual_adapter_context_owned",true}};}
+    s->captured.store(true,std::memory_order_release);
+  }
+  static void run_case(const std::shared_ptr<state>& s,bool refocus){
+    json row={{"name",refocus?"blur-refocus-final":"blur-final"},{"preedit_utf16",{110,105}},{"final_payload_utf16",{20320}},{"steps",json::array()}};
+    auto save=[&]{std::lock_guard<std::mutex> lock(s->mutex);s->cases.push_back(row);};
+    auto observed=[&](const char* operation,std::uint64_t begin,json returned,bool query=true){
+      row["steps"].push_back({{"operation",operation},{"qpc_begin",std::to_string(begin)},{"qpc_end",std::to_string(qpc())},{"returned",std::move(returned)}});
+      // Retain the actual call/return even if a later DOM/ownership query fails.
+      if(query)row["steps"].back()["after"]=snapshot(*s,false);
+    };
+    try {
+      phase(*s,reset_script(refocus));
+      phase(*s,"(function(){window.__souiImeApiReplay.phase='focus';return JSON.stringify({ok:true});})()");
+      (void)checked(*s);auto begin=qpc();s->functions.focus(s->native_view);observed("wkeSetFocus",begin,nullptr);
+      phase(*s,"(function(){window.__souiImeApiReplay.phase='preedit';return JSON.stringify({ok:true});})()");
+      (void)checked(*s);begin=qpc();const auto composed=s->functions.compose(s->native_view,L"ni",2,2);observed("wkeSetComposition",begin,composed);
+      require(composed,"E_IME_API_PREEDIT_REJECTED");
+      phase(*s,"(function(){window.__souiImeApiReplay.phase='blur';return JSON.stringify({ok:true});})()");
+      (void)checked(*s);begin=qpc();s->functions.blur(s->native_view);observed("wkeKillFocus",begin,nullptr);
+      if(refocus){
+        phase(*s,"(function(){window.__souiImeApiReplay.phase='refocus';return JSON.stringify({ok:true});})()");
+        (void)checked(*s);begin=qpc();s->functions.focus(s->native_view);observed("wkeSetFocus",begin,nullptr);
+      }
+      phase(*s,"(function(){window.__souiImeApiReplay.phase='confirm';return JSON.stringify({ok:true});})()");
+      (void)checked(*s);begin=qpc();const auto confirmed=s->functions.confirm(s->native_view,L"\x4f60");observed("wkeConfirmComposition",begin,confirmed,false);
+      row["final"]=snapshot(*s,true);row["native_sequence_observed"]=true;save();
+      // Do not reset another case over an unfinalized native composition.
+      require(confirmed,"E_IME_API_FINAL_COMMIT_REJECTED");
+    }catch(...){if(!row.contains("native_sequence_observed")){row["native_sequence_observed"]=false;save();}throw;}
+  }
+ public:
+  ime_api_replay(sdk::bridge_adapter& delegate,std::string run,std::filesystem::path kernel)
+    :delegate_(delegate),state_(std::make_shared<state>(std::move(run),std::move(kernel))){
+    require(hex32(state_->run)&&state_->binary.is_absolute(),"E_IME_API_CONFIG");
+  }
+  ~ime_api_replay() override {cancel();}
+  void attach_adapter(sdk::dynamic_miniblink_adapter& adapter,HWND owner_window){
+    auto& s=*state_;require(GetCurrentThreadId()==s.ui&&!s.attached.load(),"E_IME_API_ATTACH_OWNER");
+    DWORD process=0;require(IsWindow(owner_window)&&GetWindowThreadProcessId(owner_window,&process)==s.ui&&process==GetCurrentProcessId(),"E_IME_API_ATTACH_HWND");
+    s.adapter=&adapter;s.owner=owner_window;s.attached.store(true,std::memory_order_release);
+  }
+  // UI timer only, after document_ready. At most one arm task and one recipe task.
+  void start() noexcept {
+    const auto s=state_;if(s->started.load()||s->done.load())return;
+    try {require(GetCurrentThreadId()==s->ui&&s->attached.load(),"E_IME_API_START_OWNER");
+      require(s->adapter->document_ready(),"E_IME_API_DOCUMENT_NOT_READY");
+      auto engine=sdk::detail::engine_admission::host_engine(*s->adapter);require(engine,"E_IME_API_ENGINE_BORROW");
+      load_api(*s);s->engine.store(engine,std::memory_order_release);s->started.store(true);
+      const auto receipt=s->adapter->execution_context_receipt();require(receipt,"E_IME_API_ARM_RECEIPT");
+      const auto event=json{{"type","soui.ime-api-replay.capture"},{"run_id",s->run},{"request_id",s->capture_id}}.dump();
+      require(engine->post([s,receipt,event]{try{require(!s->cancelled.load()&&s->engine.load()->is_owner_thread()&&s->adapter->accepts_execution_context_receipt(receipt),"E_IME_API_ARM_REVOKED");s->adapter->dispatch_event_now(event);}catch(const std::exception& e){fail(s,e.what());}catch(...){fail(s,"E_IME_API_ARM_UNKNOWN");}}),"E_IME_API_ARM_ADMISSION");
+    }catch(const std::exception& e){fail(s,e.what());}catch(...){fail(s,"E_IME_API_START_UNKNOWN");}
+  }
+  void poll() noexcept {
+    const auto s=state_;if(s->done.load()||!s->captured.load(std::memory_order_acquire)||s->recipe_posted.load())return;
+    try {require(GetCurrentThreadId()==s->ui,"E_IME_API_POLL_OWNER");
+      require(!s->cancelled.load(),"E_IME_API_CANCELLED");s->recipe_posted.store(true);
+      auto engine=s->engine.load();require(engine&&engine==sdk::detail::engine_admission::host_engine(*s->adapter),"E_IME_API_ENGINE_CHANGED");
+      require(engine->post([s]{try{require(GetCurrentThreadId()==s->engine_tid,"E_IME_API_CAPTURE_THREAD_CHANGED");phase(*s,setup_script());run_case(s,false);run_case(s,true);(void)checked(*s);s->done.store(true,std::memory_order_release);}catch(const std::exception& e){fail(s,e.what());}catch(...){fail(s,"E_IME_API_REPLAY_UNKNOWN");}}),"E_IME_API_REPLAY_ADMISSION");
+    }catch(const std::exception& e){fail(s,e.what());}catch(...){fail(s,"E_IME_API_POLL_UNKNOWN");}
+  }
+  void cancel() noexcept {const auto s=state_;if(s->done.load(std::memory_order_acquire))return;s->cancelled.store(true,std::memory_order_release);fail(s,"E_IME_API_CANCELLED");}
+  [[nodiscard]] bool done() const noexcept{return state_->done.load(std::memory_order_acquire);}
+  [[nodiscard]] bool failed() const noexcept{return state_->failed.load(std::memory_order_acquire);}
+  [[nodiscard]] json result() const {
+    const auto s=state_;std::lock_guard<std::mutex> lock(s->mutex);
+    const bool complete=s->done.load()&&!s->failed.load()&&!s->cancelled.load()&&s->cases.size()==2;
+    return {{"schema","soui.ime-api-replay-result/v1"},{"run_id",s->run},{"mode","deterministic-native-api-payload-replay"},{"done",s->done.load()},{"failed",s->failed.load()},{"collectorIndependentComplete",complete},{"error",s->error.empty()?json(nullptr):json(s->error)},{"capture",s->capture},{"cases",s->cases},{"functionalPass",nullptr},{"sdkImePacketPipelineVerified",false},{"realOsImeVerified",false},{"physicalInputLatencyMeasured",false},{"performanceGate",false},{"releaseReady",false}};
+  }
+  std::string handle_json(std::string_view request,bool gesture=false) override {
+    auto response=delegate_.handle_json(request,gesture); // Original authorization/response untouched.
+    const auto s=state_;if(s->done.load()||request.size()>4096)return response;
+    try {const auto r=json::parse(request,nullptr,false);if(r.is_object()&&r.value("method",std::string{})=="bridge.bootstrap"&&r.value("requestId",std::string{})==s->capture_id){
+      require(response.size()<=8192,"E_IME_API_BOOTSTRAP_RESPONSE_BOUND");const auto granted=json::parse(response,nullptr,false);
+      require(granted.is_object()&&granted.value("ok",false)&&granted.value("requestId",std::string{})==s->capture_id,"E_IME_API_BOOTSTRAP_REJECTED");capture(s);
+    }
+    }catch(const std::exception& e){fail(s,e.what());}catch(...){fail(s,"E_IME_API_CAPTURE_UNKNOWN");}
+    return response;
+  }
+  void shutdown_session(const std::string& s) override{delegate_.shutdown_session(s);}
+  void set_owner_window(void* w) noexcept override{delegate_.set_owner_window(w);}
+  void set_event_sink(event_sink f) override{delegate_.set_event_sink(std::move(f));}
+  void record_paint() noexcept override{delegate_.record_paint();}
+  void set_present_count(std::uint64_t n) noexcept override{delegate_.set_present_count(n);}
+  void set_draw_interval(unsigned n) noexcept override{delegate_.set_draw_interval(n);}
+  void set_gpu_active(bool b) noexcept override{delegate_.set_gpu_active(b);}
+  unsigned active_frame_rate() const noexcept override{return delegate_.active_frame_rate();}
+  bool set_backend_frame_rate_limit(unsigned n) noexcept override{return delegate_.set_backend_frame_rate_limit(n);}
+  unsigned requested_frame_rate() const noexcept override{return delegate_.requested_frame_rate();}
+  std::string register_root(const soui::runtime::scan_request_context& c,const std::filesystem::path& p) override{return delegate_.register_root(c,p);}
+};
+} // namespace soui::benchmark
+#endif // SOUI_IME_ENABLE_API_REPLAY
