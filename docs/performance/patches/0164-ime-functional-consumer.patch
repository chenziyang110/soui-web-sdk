+  auto empty=page;empty["events"]=json::array();empty["checkpoints"]=json::array();
+  empty["final"]={{"time_ms",0.0},{"value",""},{"selection_start",nullptr},
+    {"selection_end",nullptr},{"selection_direction",nullptr},{"active_element","none"}};
+  check(ime_report_detail::parse(params(empty),run)==empty,"Unknown unobserved phase was fabricated/rejected");++cases;
+  auto mismatch=page;mismatch["final"]["value"]="observed failure";
+  mismatch["final"]["selection_start"]=16;mismatch["final"]["selection_end"]=16;
+  check(ime_report_detail::parse(params(mismatch),run)==mismatch,"Unexpected observed text was discarded");++cases;
+
+  // Each mutation independently exercises the production schema boundary.
+  for(unsigned failure=0;failure<14;++failure) {
+    auto invalid=page;
+    switch(failure) {
+      case 0:invalid["run_id"]=std::string(32,'d');break;
+      case 1:invalid["events"][1]["seq"]=3;break;
+      case 2:invalid["events"][1]["time_ms"]=0.5;break;
+      case 3:invalid["events"][0]["selection_end"]=4;break;
+      case 4:invalid["events"][0]["selection_start"]=nullptr;break;
+      case 5:invalid["events"][1]["data"]=std::string(65,'x');break;
+      case 6:invalid["final"]["value"]=std::string(129,'x');break;
+      case 7:invalid["overflow"]=true;break;
+      case 8:invalid["performance_verified"]=true;break;
+      case 9:invalid["physical_latency_measured"]=true;break;
+      case 10:invalid["classification"]["native_late_commit"]="verified";break;
+      case 11:invalid["final"]["time_ms"]=2.0;break;
+      case 12:invalid["checkpoints"]=json::array({2});break;
+      case 13:invalid["events"][0]["seq"]=true;break;
+    }
+    rejects([&]{ime_report_detail::parse(params(invalid),run);},"Malformed IME observation was accepted");++cases;
+  }
+  auto excessive=page;excessive["events"]=json::array();excessive["checkpoints"]=json::array();
+  for(unsigned seq=1;seq<=97;++seq) {
+    auto row=page["events"][0];row["seq"]=seq;row["time_ms"]=seq;row["type"]="input";
+    row["data"]=nullptr;row["value"]="";row["selection_start"]=nullptr;row["selection_end"]=nullptr;
+    row["selection_direction"]=nullptr;row["active_element"]="none";row["phase"]="initial";
+    excessive["events"].push_back(row);
+  }
+  excessive["final"]=empty["final"];excessive["final"]["time_ms"]=98;
+  check(params(excessive).size()<=ime_report_detail::byte_limit,"Array-bound contract hit byte limit first");
+  rejects([&]{ime_report_detail::parse(params(excessive),run);},"Unbounded IME event array accepted");++cases;
+  excessive=page;excessive["checkpoints"]=json::array({1,2,3,4,5});
+  rejects([&]{ime_report_detail::parse(params(excessive),run);},"Unbounded checkpoint array accepted");++cases;
+  rejects([&]{ime_report_detail::parse(std::string(24577,' '),run);},"Oversized IME envelope accepted");++cases;
+  const std::string deep="{\"events\":"+std::string(8,'[')+"0"+std::string(8,']')+"}";
+  rejects([&]{ime_report_detail::parse(json{{"snapshot_json",deep}}.dump(),run);},"Deep IME arrays accepted");++cases;
+  const auto raw=page.dump();
+  const auto duplicate=std::string("{\"run_id\":\"")+run+"\","+raw.substr(1);
+  rejects([&]{ime_report_detail::parse(json{{"snapshot_json",duplicate}}.dump(),run);},"Duplicate IME snapshot key folded");++cases;
+  auto row_duplicate=raw;const auto sequence=row_duplicate.find("\"seq\":1");
+  check(sequence!=std::string::npos,"Contract event sequence missing");row_duplicate.insert(sequence,"\"seq\":1,");
+  rejects([&]{ime_report_detail::parse(json{{"snapshot_json",row_duplicate}}.dump(),run);},"Duplicate IME event key folded");++cases;
+  const auto encoded=json(raw).dump();
+  rejects([&]{ime_report_detail::parse("{\"snapshot_json\":"+encoded+",\"snapshot_json\":"+encoded+"}",run);},
+    "Duplicate IME envelope key folded");++cases;
+
+  ime_report_collector accepted(run);
+  const auto receipt=json::parse(accepted.submit(body));
+  check(receipt.at("accepted")==true&&receipt.at("persisted")==false,"IME admission claimed persistence");++cases;
+  rejects([&]{accepted.submit(params(mismatch));},"IME second observation overwrote first admission");++cases;
+  ime_report_collector closed(run);closed.close();
