'use strict';
const fs=require('node:fs'),path=require('node:path'),crypto=require('node:crypto');
const {spawnSync}=require('node:child_process');
const root=path.resolve(__dirname,'..');
const base='verification/production-validation/0.5-maintenance-disposition-2026-10-09/continuation-'+crypto.randomUUID();
const directory=path.join(root,base);fs.mkdirSync(directory,{recursive:true});
if(fs.readdirSync(directory).length)throw new Error('Disposition evidence directory must be new');
const old=JSON.parse(fs.readFileSync(path.join(root,'verification/production-validation/0.5-maintenance-2026-10-08/index.json')));
const gh=spawnSync('where.exe',['gh.exe'],{encoding:'utf8',windowsHide:true});
if(gh.status!==0)throw new Error('GitHub CLI unavailable');
const executable=gh.stdout.trim().split(/\r?\n/)[0];
const sha=b=>crypto.createHash('sha256').update(b).digest('hex');
const files=[],operations=[],alerts=[];
const main='b185bacd224ea8632a2fa21224065971475188c6';
const record={schema:'soui.historical-alert-disposition/v1',repository:'chenziyang110/soui-web-sdk',
 reviewedPolicyCommit:main,policyDocument:old.maintenanceDocument,originalMaintenanceIndexSha256:sha(fs.readFileSync(path.join(root,'verification/production-validation/0.5-maintenance-2026-10-08/index.json'))),
 startedAt:new Date().toISOString(),completed:false,reason:'not_used',files,operations,alerts,
 historicalDependencyPatched:false,originalRawEvidenceModified:false,releaseReady:false};
record.priorFailureIndexSha256=sha(fs.readFileSync(path.join(root,'verification/production-validation/0.5-maintenance-disposition-2026-10-09/index.json')));
record.priorFailure='GitHub rejected the first 300-character disposition comment with HTTP 422 before modifying alert 57; the original response and driver are preserved.';
const save=()=>fs.writeFileSync(path.join(directory,'index.json'),JSON.stringify(record,null,2)+'\n');
function persist(name,bytes){fs.writeFileSync(path.join(directory,name),bytes,{flag:'wx'});
 files.push({path:name,bytes:bytes.length,sha256:sha(bytes)});}
function api(name,args){
 const startedAt=new Date().toISOString();
 const result=spawnSync(executable,['api',...args],{cwd:root,windowsHide:true,maxBuffer:16*1024*1024});
 persist(name+'.stdout.json',result.stdout||Buffer.alloc(0));persist(name+'.stderr.log',result.stderr||Buffer.alloc(0));
 operations.push({name,executable,args:['api',...args],startedAt,finishedAt:new Date().toISOString(),
  exitCode:result.status,signal:result.signal,spawnError:result.error?.message||null});save();
 if(result.status!==0||result.error||result.signal)throw new Error('GitHub operation failed: '+name);
 return JSON.parse(result.stdout.toString('utf8'));
}
function matches(actual,expected){return actual.number===expected.number&&
 actual.dependency?.manifest_path===expected.path&&actual.dependency?.package?.ecosystem==='npm'&&
 actual.dependency?.package?.name==='source-map-js'&&actual.security_advisory?.ghsa_id===expected.ghsa;}
try{
 save();
 const reference=api('main-before',['repos/chenziyang110/soui-web-sdk/git/ref/heads/main']);
 if(reference.object?.sha!==main)throw new Error('Reviewed policy is not the observed main HEAD');
 if(sha(fs.readFileSync(path.join(root,old.maintenanceDocument.path)))!==old.maintenanceDocument.sha256)
  throw new Error('Reviewed policy document differs');
 const before=api('open-before',['repos/chenziyang110/soui-web-sdk/dependabot/alerts?state=open&per_page=100']);
 if(!Array.isArray(before))throw new Error('Unexpected alert list');
 for(const expected of old.alerts){
  const actual=before.find(a=>a.number===expected.number);
  if(!actual||!matches(actual,expected)||actual.state!=='open')throw new Error('Alert identity/state changed: '+expected.number);
  const bytes=fs.readFileSync(path.join(root,expected.path));
  if(bytes.length!==expected.bytes||sha(bytes)!==expected.sha256)throw new Error('Historical evidence differs');
 }
 const comment='Forensic fixture retired from install/build/replay; vulnerable lock bytes preserved. Patched current templates. Policy: https://github.com/chenziyang110/soui-web-sdk/blob/'+main+'/docs/maintenance/historical-source-map-js-evidence.md';
 if(comment.length>280)throw new Error('Disposition comment exceeds API limit');
 for(const expected of old.alerts){
  const request={state:'dismissed',dismissed_reason:'not_used',dismissed_comment:comment};
  const requestName='alert-'+expected.number+'.request.json';persist(requestName,Buffer.from(JSON.stringify(request,null,2)+'\n'));
  const updated=api('alert-'+expected.number+'-patch',['--method','PATCH',
   'repos/chenziyang110/soui-web-sdk/dependabot/alerts/'+expected.number,'--input',path.join(directory,requestName)]);
  if(!matches(updated,expected)||updated.state!=='dismissed'||updated.dismissed_reason!=='not_used'||updated.dismissed_comment!==comment)
   throw new Error('Unexpected disposition response: '+expected.number);
  alerts.push({number:expected.number,path:expected.path,state:updated.state,reason:updated.dismissed_reason,
   dismissedAt:updated.dismissed_at,originalBytes:expected.bytes,originalSha256:expected.sha256});save();
 }
 const after=api('open-after',['repos/chenziyang110/soui-web-sdk/dependabot/alerts?state=open&per_page=100']);
 if(!Array.isArray(after)||after.some(a=>old.alerts.some(x=>x.number===a.number)))throw new Error('Target alert remains open');
 record.observedOpenAlertCountAfter=after.length;
 record.completed=true;record.finishedAt=new Date().toISOString();save();
 console.log(JSON.stringify({completed:true,dismissed:alerts.length,observedOpenAlertsAfter:after.length,record:base+'/index.json'}));
}catch(error){record.error=error.stack;record.finishedAt=new Date().toISOString();save();throw error;}
