-        return 0;
-
-    std::lock_guard<std::mutex> lock(endpoint->mutex);
-    if (!endpoint->active || !endpoint->layerTreeHost)
-        return 0;
-    endpoint->layerTreeHost->setIndependentPresentationEnabled(
-        (flags & WKE_INTERACTION_PRESENT_DIRECT_HWND) != 0);
