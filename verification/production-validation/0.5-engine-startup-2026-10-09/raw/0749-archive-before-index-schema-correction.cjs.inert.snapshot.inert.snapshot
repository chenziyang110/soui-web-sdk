const evidence = require(path.join(continuation, 'toolchain-evidence.cjs'));
const hash = data => crypto.createHash('sha256').update(data).digest('hex');
const canonical = value => path.resolve(value).toLowerCase();
const encoded = value => Buffer.from(JSON.stringify(value, null, 2) + '\n');
function safe(file) {
  assert(path.isAbsolute(file));
  const absolute = path.resolve(file), parsed = path.parse(absolute);
  let current = parsed.root;
  for (const part of absolute.slice(parsed.root.length).split(path.sep).filter(Boolean)) {
    current = path.join(current, part);
    if (!fs.existsSync(current)) break;
    assert(!fs.lstatSync(current).isSymbolicLink(), 'Evidence path traverses a link: ' + current);
  }
  return absolute;
}
function relative(base, name) {
  assert.equal(typeof name, 'string');
  assert(name && !name.includes('\\') && !name.includes(':') && name.split('/').every(value => value && value !== '.' && value !== '..'));
  const file = safe(path.join(base, name));
  assert(canonical(file).startsWith(canonical(base) + path.sep));
  return file;
}
function bytes(file) {
  safe(file);
  const stat = fs.lstatSync(file);
  assert(stat.isFile() && stat.nlink === 1, 'Evidence must be an independent regular file');
  const fd = fs.openSync(file, 'r');
  try {
    const before = fs.fstatSync(fd), value = fs.readFileSync(fd), after = fs.fstatSync(fd);
    assert.equal(before.dev, after.dev); assert.equal(before.ino, after.ino);
    assert.equal(before.size, after.size); assert.equal(before.mtimeMs, after.mtimeMs);
    assert.equal(value.length, before.size); return value;
  } finally { fs.closeSync(fd); }
}
function record(file) { const value = bytes(file); return {path: file, bytes: value.length, sha256: hash(value)}; }
function verify(item) {
  const value = bytes(item.path);
  assert.equal(value.length, item.bytes); assert.equal(hash(value), item.sha256); return value;
}
function write(file, value) {
  safe(file); fs.mkdirSync(path.dirname(file), {recursive: true}); safe(path.dirname(file));
  const data = Buffer.isBuffer(value) ? value : encoded(value);
  const fd = fs.openSync(file, 'wx');
  try { fs.writeFileSync(fd, data); fs.fsyncSync(fd); } finally { fs.closeSync(fd); }
  assert(bytes(file).equals(data));
}
function walk(base) {
  safe(base); const result = [];
  for (const entry of fs.readdirSync(base, {withFileTypes: true})) {
    const file = safe(path.join(base, entry.name));
    if (entry.isDirectory()) result.push(...walk(file));
    else { assert(entry.isFile()); result.push(file); }
  }
  return result.sort((a, b) => a.localeCompare(b, 'en'));
}
const roots = [{name: 'early-unexecuted-preparation', directory: early},
  {name: 'sdk-preparation-and-first-attempt', directory: prepared},
  {name: 'continuation-and-second-attempt', directory: continuation}, {name: 'root-npm-audit', directory: audit}];
const indexProofs = [];
function checkIndex(directory, name, expectedHash, expectedCount) {
  const indexRecord = record(path.join(directory, name));
  if (expectedHash) assert.equal(indexRecord.sha256, expectedHash);
  const index = JSON.parse(verify(indexRecord));
  if (expectedCount !== undefined) assert.equal(index.files.length, expectedCount);
  for (const item of index.files) {
    const name = item.relativePath || (!path.isAbsolute(item.path) ? item.path : null);
    assert(name, 'Index has no relative file mapping');
    const file = relative(directory, name);
    if (path.isAbsolute(item.path)) assert.equal(canonical(file), canonical(item.path));
    verify({...item, path: file});
  }
  indexProofs.push({...indexRecord, payloadCount: index.files.length}); return index;
}
checkIndex(first, 'index.json', '092c59c35d2dcf962a3a3347a1e283980b8ded995f7c6b402a6fa72390c6ac9b', 286);
checkIndex(actual, 'index.json', '26f5f3554f92ba64ec201fa8dde8fdd04896724efda656db6e7b76820b073112', 386);
checkIndex(audit, 'index.json', 'afabd3d484d1626d034301615ee58f8c0dd9ac21462c90fb2b4aaea549696ad7');
checkIndex(continuation, 'prepared-evidence-index.json', '59273c262823a679d9600d615665ae896fb68dc5b875da19f51de593e5c7c805', 14);
