+    rect.intersect(blink::IntRect(blink::IntPoint(), m_layerSize));
+    if (rect.isEmpty())
+        return false;
+
+    const int firstX = rect.x() / kDefaultTileWidth;
+    const int firstY = rect.y() / kDefaultTileHeight;
+    const int lastX = (rect.maxX() - 1) / kDefaultTileWidth;
+    const int lastY = (rect.maxY() - 1) / kDefaultTileHeight;
+    bool ready = true;
+
+    lockTiles();
+    for (int y = firstY; ready && y <= lastY; ++y) {
+        for (int x = firstX; x <= lastX; ++x) {
+            const int index = x + m_numTileX * y;
+            Tile* tile = static_cast<Tile*>(m_tilesAddr->getTileByIndex(index));
+            if (!tile || !tile->bitmap() || !tile->dirtyRect().isEmpty()) {
+                ready = false;
+                break;
+            }
+        }
+    }
+    unlockTiles();
+    return ready;
+}
