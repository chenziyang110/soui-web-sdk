   return{path:file,bytes:fs.statSync(file).size,sha256:digest(file)};
  });
  const consumer=packet.installedConsumer.sourceDirectory,packageDirectory=path.join(relocated,'lib/cmake/SouiSdk');
  await stage('consumer-configure',tools.cmake.path,['-S',consumer,'-B',consumerBuild,'-G','Visual Studio 17 2022','-A',a['--arch']+',version=10.0.19041.0','-DCMAKE_GENERATOR_INSTANCE='+tools.vsInstance,'-T','v143,host=x64,version=14.44.35207','-DCMAKE_SYSTEM_VERSION=10.0.19041.0','-DSouiSdk_DIR:PATH='+packageDirectory,'-DCMAKE_FIND_USE_PACKAGE_REGISTRY=OFF','-DCMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY=OFF','-DCMAKE_VS_GLOBALS=VcpkgEnabled=false;VcpkgEnableManifest=false;ImportDirectoryBuildProps=false;ImportDirectoryBuildTargets=false;UserRootDir='+path.join(directory,'empty-user-props')+path.sep],120000);
  selectedSdkCheck('consumer-configure',consumerBuild);
  const consumerCache=fs.readFileSync(path.join(consumerBuild,'CMakeCache.txt'),'utf8');
  if(!consumerCache.split(/\r?\n/).some(line=>line.startsWith('SouiSdk_DIR:PATH=')&&normalize(line.slice(17))===normalize(packageDirectory)))throw Error('Consumer resolved another SDK package');
  await stage('consumer-build',tools.cmake.path,['--build',consumerBuild,'--config','Release','--target',packet.installedConsumer.target,'--','/m:1','/nr:false','/p:VcpkgEnabled=false','/p:VcpkgEnableManifest=false','/p:VCToolsVersion=14.44.35207','/p:WindowsTargetPlatformVersion=10.0.19041.0','/p:ImportDirectoryBuildProps=false','/p:ImportDirectoryBuildTargets=false','/p:UseEnv=false','/p:UserRootDir='+path.join(directory,'empty-user-props')+path.sep,'/bl:'+path.join(output,'consumer.binlog')],300000);
  selectedSdkCheck('consumer-build',consumerBuild);
  const consumerFiles=list(consumerBuild),consumerExecutables=consumerFiles.filter(file=>path.basename(file).toLowerCase()==='souiendpointconsumer.exe');
  if(consumerExecutables.length!==1)throw Error('Actual unique installed consumer EXE missing');
  const executable=consumerExecutables[0],executablePin={path:executable,bytes:fs.statSync(executable).size,sha256:digest(executable)},consumerPe=inspect(executable);
  if(consumerPe.dll||consumerPe.machine!==expectedMachine)throw Error('Installed consumer architecture differs');
  const consumerCommands=consumerFiles.filter(file=>normalize(file).startsWith(normalize(path.join(consumerBuild,packet.installedConsumer.target+'.dir/Release'))+'/')&&/\.command\..*\.tlog$/i.test(file)).map(file=>{
   const bytes=fs.readFileSync(file);return{path:file,text:bytes[0]===255&&bytes[1]===254?bytes.subarray(2).toString('utf16le'):bytes.toString('utf8')};
  });
  const cl=consumerCommands.filter(p=>/^cl\.command\./i.test(path.basename(p.path))),link=consumerCommands.filter(p=>/^link\.command\./i.test(path.basename(p.path)));
  if(cl.length!==1||link.length!==1)throw Error('Actual installed consumer CL/LINK bindings are missing');
  const clText=cl[0].text.replaceAll('\\','/').toLowerCase(),linkText=link[0].text.replaceAll('\\','/').toLowerCase();
  if(!clText.includes('/ehsc')||!clText.includes('/md')||!clText.includes('/utf-8')||!clText.includes(normalize(path.join(consumer,'main.cpp')))||!clText.includes(normalize(path.join(relocated,'include')))||clText.includes(normalize(path.join(packet.repositoryRoot,'sdk')))||/SOUI_TEST_KIT|SOUI_TASK_FAMILY_TEST_ONLY|SOUI_GPU_COMPOSITOR/.test(cl[0].text))throw Error('Installed consumer did not use independent normal public headers');
  if(!linkText.includes(normalize(path.join(relocated,'lib/Release/soui_sdk.lib')))||linkText.includes(normalize(path.join(build,'sdk'))))throw Error('Consumer link did not bind relocated current installed SDK archive');
  const consumerPins=consumerFiles.filter(file=>/\.(obj|pch|lib|exe|pdb|tlog|vcxproj|cmake)$/i.test(file)).map(file=>({path:file,bytes:fs.statSync(file).size,sha256:digest(file)}));
  for(const p of [...installPins,...relocatedPins,...consumerPins])pin(p);
  json(path.join(output,'installed-consumer-bindings.json'),{installPins,relocatedPins,currentBuildSdkArchive:builtSdk[0],executablePin,consumerPe,consumerCommands,consumerPins,sourceConsumer:packet.installedConsumer,currentNormalSdkArchiveMatches:true,relocatedInstalledBytesMatch:true,sourceSdkCompiledAgainByConsumer:false,completeToolchainProvenance:false,qualificationPassed:false,releaseReady:false});
  await stage('consumer-runtime',executable,[],45000);
  if(fs.readFileSync(path.join(output,'consumer-runtime.stdout.raw'),'utf8').trim()!==packet.installedConsumer.expectedStdout)throw Error('Actual installed consumer stopped-factory receipt differs');
  for(const p of [...artifactPins,...installPins,...relocatedPins,...consumerPins])pin(p);
  packageCheck();toolCheck();
  json(path.join(output,'summary.json'),{schema:packet.schema,completed:true,packageSha256:a['--package-sha'],architecture:a['--arch'],stages,registeredTests:packet.expectedTests.length,nativeExecutableTargets:packet.expectedTargets.length,requestClosePublicInstalled:true,requestCloseCases:11,workerLifetimePublicInstalled:true,workerLifetimeCases:12,windowsPeerIdentityPublicInstalled:true,windowsPeerIdentityCases:1,dragDataCases:11,ctorShellCases:7,legacyDragLeafCases:3,legacyDefaultLeafApplied:true,generatedFiniteSourceCopies:25,publicFixtureExactSourceRanges:21,normalSdkCppCount:24,optionalUiaCppCount:1,uiaPublicInstalled:true,uiaCases:8,localEndpointPublicInstalled:true,localEndpointCases:20,localTaskFamilyCases:2,jsonBridgeFactoryPublicInstalled:true,jsonBridgeFactoryCases:6,installedConsumerExecuted:true,installedConsumerRelocated:true,installedConsumerNaturalClosed:true,currentSnapshotNotHostRootCauseFix:true,taskFamilyPreparationSeamOnlyItsOwnTarget:true,expectedFatalCasesDoNotProveNaturalResourceCleanup:true,requestCloseFragmentsMatchLiveWholeSource:true,demoTaskQueryCases:5,normalSdkSources:true,souiTestKitDefined:false,webview2BackendBuilt:false,nativeGuiAppBuilt:false,allRegisteredUnitTestsPassed:true,actualGeneratedProjectSdkVersionsMatch:true,selectedWindowsSdk:'10.0.19041.0',actualFullDllStartupCloseQualified:false,engineStartupNativeBoundaryUnitOnly:true,allPerTestPidFiletimeIndependentlyObserved:false,actualCompilerInputBindingComplete:false,targetOsQualification:false,guiRenderingQualification:false,performanceQualification:false,qualificationPassed:false,releaseReady:false,allGenericPassed:stages.every(p=>p.genericPassed)});
  json(path.join(output,'installed-consumer-summary.json'),{completed:true,publicJsonBridgeFactoryCases:6,currentBuiltNormalSdkArchiveMatches:true,relocatedInstallBytesMatch:true,installedConsumerExecuted:true,installedConsumerNaturalClosed:true,currentSnapshotNotHostRootCauseFix:true,allGenericPassed:stages.every(p=>p.genericPassed),qualificationPassed:false,releaseReady:false});
  console.log(JSON.stringify({completed:true,output,architecture:a['--arch'],registeredUnitTests:packet.expectedTests.length,installedConsumerExecuted:true,qualificationPassed:false,releaseReady:false}));
 }catch(error){json(path.join(output,'summary-failed.json'),{schema:packet.schema,completed:false,architecture:a['--arch'],stages,error:error.message,qualificationPassed:false,releaseReady:false});throw error;}
}
main().catch(error=>{console.error(error.message);process.exitCode=1;});
