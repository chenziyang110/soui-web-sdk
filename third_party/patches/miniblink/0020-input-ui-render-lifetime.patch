+    auto event = renderTraceContext();
+    event.why = trace::reason::invalid;
+    event.value = static_cast<unsigned>(reason);
+    event.related_id = RasterCandidateBudget::maximumBytes;
+    recordRenderStage(trace::stage::resource_wait, event);
