+  window.addEventListener('blur', function () { record('window-blur', null); }, false);
+  doc.addEventListener('selectionchange', function () { record('selectionchange', null); }, false);
+  window.addEventListener('unload', function () { disposed = true; }, false);
+  phaseButton.addEventListener('click', function () {
+    if (['initial','preedit-observed','after-focus-return','final'].indexOf(phaseName.value) < 0) { failObservation('unknown phase'); return; }
