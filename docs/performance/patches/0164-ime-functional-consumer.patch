+      code = text.charCodeAt(index);
+      if (code < 128) count += 1;
+      else if (code < 2048) count += 2;
+      else if (code >= 55296 && code <= 56319 && index + 1 < text.length && text.charCodeAt(index + 1) >= 56320 && text.charCodeAt(index + 1) <= 57343) { count += 4; index += 1; }
