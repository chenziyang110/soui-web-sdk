const vendorRoots = ['C:/Program Files/CMake/share', path.join(msvc, 'include'), path.join(msvc, 'lib/x64'), path.join(msvc, 'lib/x86'),
  path.join(sdk, 'Include/10.0.19041.0'), path.join(sdk, 'Lib/10.0.19041.0/ucrt/x64'),
  path.join(sdk, 'Lib/10.0.19041.0/ucrt/x86'), path.join(sdk, 'Lib/10.0.19041.0/um/x64'), path.join(sdk, 'Lib/10.0.19041.0/um/x86')];
const vendorInputs = vendorRoots.flatMap(walk).map(file);
const beforeReads = new Map([...actualInputs.files.map(row => file(identity.safePath(root, row.path))), ...tools, ...vendorInputs]
  .map(row => [row.resolvedPath.toLowerCase(), row]));
write('reviewed-inputs.json', reviewedBytes);
write('prepared-inputs.json', preparedBytes);
write('toolchain-evidence.cjs.inert.snapshot', fs.readFileSync(path.join(__dirname, 'toolchain-evidence.cjs')));
write('driver.cjs.inert.snapshot', fs.readFileSync(__filename));
write('frozen-inputs.json', {schema: 'soui.local-task-family-native-inputs/v1', reviewedSourceSha256: reviewed.sourceSha256,
  source, rawSource, actualInputs, tools, vendorInputs, vendorInputsHashOnly: true,
  configuration: {architectures: ['x64', 'x86'], toolset: 'v143,version=14.44.35207,host=x64', sdk: '10.0.19041.0',
    productionSeam: false, privateSeamTarget: 'soui_local_task_family_prepare_tests',
    privateSeamSources: ['task_service.cpp', 'task_store.cpp', 'bridge_transport.cpp'], sharedWorkers: 2},
  noGui: true, noPipe: true, noOsIdentity: true, compilerTailAcceptance: false, releaseReady: false});
fs.mkdirSync(path.join(base, 'source-raw'));
const sourceMap = actualInputs.files.map((row, index) => {
  const bytes = fs.readFileSync(identity.safePath(root, row.path));
  need(bytes.length === row.bytes && hash(bytes) === row.sha256, 'Source input changed before launch');
  const archive = 'source-raw/' + String(index).padStart(4, '0') + '-' + path.basename(row.path) + '.inert.snapshot';
  write(archive, bytes); return {...row, archive};
});
write('source-raw-map.json', sourceMap);
const env = {...process.env, MSBUILDDISABLENODEREUSE: '1'}, removedEnvironmentNames = [];
const compilerOverrides = new Set(['CL', '_CL_', 'LINK', '_LINK_', 'INCLUDE', 'LIB', 'LIBPATH', 'CLTOOLPATH', 'CLTOOLEXE',
  'LINKTOOLPATH', 'LINKTOOLEXE', 'VCTOOLSVERSION', 'VCTOOLSINSTALLDIR', 'WINDOWSSDKDIR', 'WINDOWSSDKVERSION']);
for (const key of Object.keys(env)) if (/(token|secret|password|passwd|api_?key|credential)/i.test(key) || compilerOverrides.has(key.toUpperCase())) {
  removedEnvironmentNames.push(key); delete env[key];
}
write('environment-guard.json', {removedEnvironmentNames, valuesNeverWritten: true, parentEnvironmentUnchanged: true,
  MSBUILDDISABLENODEREUSE: env.MSBUILDDISABLENODEREUSE, binlogsPrivateOnly: true});
const records = [], outputs = [], architectureEvidence = [];
function verifyInputs() {
  verifyPreparation();
  verifyReviewed();
  need(identity.snapshot(root, inputNames).sha256 === actualInputs.sha256, 'Prepared project inputs changed');
  need(tools.every(row => JSON.stringify(file(row.path)) === JSON.stringify(row)), 'Actual tool/alias bytes changed');
}
async function phase(name, exe, args, timeoutMs, allowClosedCompileTail = false) {
  verifyInputs();
  const directory = path.join(base, name); fs.mkdirSync(directory);
  const stdout = [], stderr = [];
  const inputs = {name, executable: file(exe), runner: file(runner), client: file(client), args: [...args], cwd: root,
    timeoutMs, drainMs: 3000, sourceSha256: source.sha256, actualInputsSha256: actualInputs.sha256,
    reviewedSourceSha256: reviewed.sourceSha256, compilerTailAcceptance: false,
    allowClosedCompileTailForContinuationOnly: allowClosedCompileTail};
  fs.writeFileSync(path.join(directory, 'inputs.json'), encode(inputs), {flag: 'wx'});
  const owned = launchOwned(exe, args, {runner, cwd: root, report: path.join(directory, 'owned.ndjson'),
    timeoutMs, drainMs: 3000, env, stdout: 'pipe', stderr: 'pipe'});
  owned.child.stdout.on('data', bytes => stdout.push(bytes)); owned.child.stderr.on('data', bytes => stderr.push(bytes));
  let ready = null, readyError = null;
  try { ready = await owned.ready; } catch (error) { readyError = error.message; }
  const finished = await owned.finished, out = Buffer.concat(stdout), err = Buffer.concat(stderr);
  const stdoutPath=path.join(directory,'stdout.bin'), stderrPath=path.join(directory,'stderr.bin');
  fs.writeFileSync(stdoutPath, out, {flag: 'wx'}); fs.writeFileSync(stderrPath, err, {flag: 'wx'});
  const contextPath=finished.report+'.context.json';
  const contextRow=fs.existsSync(contextPath)?file(contextPath):null, reportRow=fs.existsSync(finished.report)?file(finished.report):null;
  const summary = {...finished, ready, readyError, contextSha256: contextRow?.sha256 ?? null,
    stdoutSha256: hash(out), stderrSha256: hash(err), compilerTailAcceptance: false, releaseReady: false};
  const record = {name, directory: path.relative(base, directory).replaceAll('\\','/'), inputs, summary,
    raw: {report:reportRow,context:contextRow,stdout:file(stdoutPath),stderr:file(stderrPath)}};
  fs.writeFileSync(path.join(directory, 'finished.json'), encode(record), {flag: 'wx'});
  records.push(record);
  console.log(JSON.stringify({base, name, rootExitCode: finished.exitCode, supervisorExitCode: finished.supervisorExitCode,
    genericSupervisionPassed: finished.passed, closureConfirmed: finished.closureConfirmed}));
  evidence.assertContinuation(record, prepared, allowClosedCompileTail);
  verifyInputs();
  return {summary, stdout: out, record};
}
async function evaluatedToolchain(build, arch, compiled) {
  const checked = checkBuild(build, arch);
  const actual = evidence.readToolchain(build, arch, prepared, compiled.record, targets);
  const evaluatedProjects=[];
  for (const [index, item] of actual.projects.entries()) {
    const result = await phase('evaluate-'+arch+'-'+index, prepared.tools.msbuild.path,
      [item.project.path, '-nologo', '-v:q', '-nr:false', '-p:Configuration=Release',
        '-p:Platform='+(arch==='x64'?'x64':'Win32'), '-getProperty:'+evidence.propertyNames.join(',')], 60000);
    evaluatedProjects.push({target:item.target, phase:result.record.name, reportSha256:result.summary.reportSha256,
      contextSha256:result.summary.contextSha256, ...evidence.readProperties(result.stdout,prepared,arch)});
  }
  for (const row of actual.generated) evidence.verify(row);
  return {...actual, evaluatedProjects, prelaunchReadBinding:checked,
    compilationCompleted:true, compilationGenericSupervisionPassed:compiled.summary.passed,
    compilerTailAcceptance:false};
}
function coff(name, arch) {
  const bytes = fs.readFileSync(name), offset = bytes.readUInt32LE(60);
  need(bytes.readUInt32LE(offset) === 0x4550 && bytes.readUInt16LE(offset + 4) === (arch === 'x86' ? 332 : 34404), 'Wrong actual executable COFF');
  return {...file(name), architecture: arch, coff: bytes.readUInt16LE(offset + 4)};
}
function text(name) {
  const bytes = fs.readFileSync(name);
  return bytes[0] === 0xff && bytes[1] === 0xfe ? bytes.subarray(2).toString('utf16le') : bytes.toString('utf8').replace(/^\uFEFF/, '');
}
function checkBuild(build, arch) {
  const projects = ['sdk/soui_sdk.vcxproj', ...targets.map(name => 'tests/native/' + name + '.vcxproj')];
  const projectRecords = projects.map(relative => {
    const name = path.join(build, relative), body = text(name);
    need(body.includes('<WindowsTargetPlatformVersion>10.0.19041.0</WindowsTargetPlatformVersion>') &&
      body.includes('<PlatformToolset>v143</PlatformToolset>'), 'Actual project SDK/toolset differs: ' + relative);
    return file(name);
  });
  const files = walk(build), sdkCommands = files.filter(name => name.includes('soui_sdk.dir') && /CL\.command\..*\.tlog$/i.test(name));
  const normalCommands = files.filter(name => name.includes('soui_local_task_family_tests.dir') && /CL\.command\..*\.tlog$/i.test(name));
  const seamCommands = files.filter(name => name.includes('soui_local_task_family_prepare_tests.dir') && /CL\.command\..*\.tlog$/i.test(name));
  need(sdkCommands.length && normalCommands.length && seamCommands.length, 'Actual compiler command tlogs missing');
  need([...sdkCommands, ...normalCommands].every(name => !text(name).includes('SOUI_TASK_FAMILY_TEST_ONLY')) &&
    seamCommands.every(name => text(name).includes('SOUI_TASK_FAMILY_TEST_ONLY')), 'Actual production/private seam compilation differs');
  const compilerFile = files.find(name => /CMakeCXXCompiler\.cmake$/i.test(name));
  need(compilerFile, 'Actual CMake C++ compiler identity missing');
  const compilerText = text(compilerFile), compilerMatch = compilerText.match(/set\(CMAKE_CXX_COMPILER "([^"]+)"\)/);
  const compilerVersion = compilerText.match(/set\(CMAKE_CXX_COMPILER_VERSION "([^"]+)"\)/)?.[1];
  const expectedCL = file(path.join(msvc, 'bin/Hostx64', arch, 'cl.exe'));
  need(compilerMatch && compilerVersion && file(compilerMatch[1]).resolvedPath.toLowerCase() === expectedCL.resolvedPath.toLowerCase(),
    'Actual compiler path differs from the frozen architecture tool');
  const cache = text(path.join(build, 'CMakeCache.txt'));
  need(cache.includes('CMAKE_GENERATOR_TOOLSET:INTERNAL=v143,version=14.44.35207,host=x64'), 'Actual generator toolset cache differs');
  const readTlogs = files.filter(name => /\.(read)\.\d+\.tlog$/i.test(name));
  need(readTlogs.length > 0, 'Actual compiler/linker read tlogs missing');
  const reads = new Map();
  for (const tlog of readTlogs) for (const line of text(tlog).split(/\r?\n/)) {
    if (!line || line.startsWith('^') || !path.isAbsolute(line)) continue;
    need(fs.existsSync(line) && fs.statSync(line).isFile(), 'Actual compiler read is unavailable: ' + line);
    const row = file(line), key = row.resolvedPath.toLowerCase(), before = beforeReads.get(key);
    const generatedThisRun = row.resolvedPath.toLowerCase().startsWith(fs.realpathSync.native(base).toLowerCase() + path.sep);
    need(before || generatedThisRun, 'Actual compiler read was not in prelaunch inputs: ' + line);
    if (before) need(row.sha256 === before.sha256 && row.bytes === before.bytes, 'Actual compiler read changed: ' + line);
    reads.set(key, {...row, prelaunchBound: !!before, generatedThisRun});
  }
  need(reads.size > 0, 'Actual compiler read evidence was empty');
  return {architecture: arch, projects: projectRecords, compiler: file(compilerFile), compilerExecutable: expectedCL,
    compilerVersion, cache: file(path.join(build, 'CMakeCache.txt')), commandTlogs: [...sdkCommands, ...normalCommands, ...seamCommands].map(file),
    readTlogs: readTlogs.map(file), actualCompilerReads: [...reads.values()], vcToolsVersionLiteralNotAssumed: true};
}
function evidenceIndex() {
  const files = walk(base).filter(name => path.basename(name) !== 'index.json').map(name =>
    ({...file(name), path: path.relative(base, name).replaceAll('\\', '/')}));
  write('index.json', {schema: 'soui.local-task-family-native-evidence/v1', files, releaseReady: false});
}
(async () => {
  const version = await phase('cmake-version', cmake, ['--version'], 30000);
  const match = version.stdout.toString('utf8').match(/^cmake version (\d+)\.(\d+)\./);
  need(match && (Number(match[1]) > 3 || Number(match[1]) === 3 && Number(match[2]) >= 27),
    'This actual driver uses the reviewed explicit platform SDK parameter for CMake >=3.27; SDK minimum remains 3.24');
  for (const arch of ['x64', 'x86']) {
    const build = path.join(base, 'b-' + arch);
    await phase('configure-' + arch, cmake, ['-S', root, '-B', build, '--fresh', '-G', 'Visual Studio 17 2022', '-A',
      (arch === 'x86' ? 'Win32' : 'x64') + ',version=10.0.19041.0', '-T', 'v143,version=14.44.35207,host=x64',
      '-DCMAKE_GENERATOR_INSTANCE=' + vs, '-DCMAKE_SYSTEM_VERSION=10.0.19041.0',
      '-DCMAKE_PROJECT_TOP_LEVEL_INCLUDES:STRING=' + path.join(root, 'cmake/SouiWindowsSdk.cmake').replaceAll('\\', '/'),
      '-DSOUI_BUILD_TEMPLATE=OFF', '-DSOUI_BUILD_DEMOS=OFF', '-DSOUI_BUILD_TESTS=ON', '-DSOUI_BUILD_WEBVIEW2=OFF'], 120000, true);
    const compiled = await phase('compile-' + arch, cmake, ['--build', build, '--config', 'Release', '--target', 'soui_sdk', ...targets,
      '--parallel', '2', '--', '/nr:false', '/m:2', '/verbosity:normal', '/p:VcpkgEnabled=false',
      '/p:VCPkgLocalAppDataDisabled=true', '/bl:' + path.join(base, 'compile-' + arch + '.binlog')], 600000, true);
    const actual = await evaluatedToolchain(build, arch, compiled); architectureEvidence.push(actual);
    outputs.push(...actual.projects.map(item => ({...item.output, architecture:arch, target:item.target, testOnlySeamEnabled:item.macroEnabled})));
    write('actual-build-' + arch + '.json', actual);
    const listed = await phase('ctest-list-' + arch, ctest, ['--test-dir', build, '-C', 'Release', '-R', testPattern, '--show-only=json-v1'], 30000);
    const list = JSON.parse(listed.stdout), expected = new Set(targets.map(name => name === 'soui_sdk_contract_tests' ? 'sdk.native.contract' :
      'sdk.native.' + name.slice(5, -6).replaceAll('_', '-')));
    need(list.tests.length === expected.size && list.tests.every(test => {
      const item=actual.projects.find(item=>item.target!== 'soui_sdk' &&
        test.name===('sdk.native.'+(item.target==='soui_sdk_contract_tests'?'contract':item.target.slice(5,-6).replaceAll('_','-'))));
      return item && Array.isArray(test.command) && test.command.length===1 &&
        evidence.canonical(test.command[0])===evidence.canonical(item.output.path) && expected.delete(test.name);
    }) && expected.size === 0,
      'The selected current CTest set is not the exact eleven target group');
    const tested = await phase('ctest-' + arch, ctest, ['--test-dir', build, '-C', 'Release', '--output-on-failure', '-R', testPattern], 180000);
    need(tested.stdout.toString('utf8').includes('100% tests passed, 0 tests failed out of ' + list.tests.length), 'Current selected CTest result differs');
    for (const [target, planned] of [['soui_local_task_family_tests', 13], ['soui_local_task_family_prepare_tests', 14]]) {
      const exe = path.join(build, 'tests/native/Release', target + '.exe');
      const run = await phase(target + '-' + arch, exe, [], 90000), lines = run.stdout.toString('utf8').trim().split(/\r?\n/);
      const cases = lines.filter(line => line.startsWith('PASS '));
      need(cases.length === planned && lines.length === planned + 1 &&
