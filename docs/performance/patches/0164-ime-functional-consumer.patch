+
+  const auto remaining=[] {return std::chrono::seconds(2);};
+  const ime_persistence_authority allowed{true,true};
+  ime_report_collector not_closed(run);not_closed.submit(body);bool premature_write=false;
+  rejects([&]{persist_ime_report(not_closed,identity,run,allowed,remaining,
+    [&](const std::string&){premature_write=true;});},"IME persistence silently closed a live collector");
+  check(!premature_write,"IME persistence wrote before explicit close");++cases;
+  for(const auto authority:{ime_persistence_authority{false,true},ime_persistence_authority{true,false}}) {
+    ime_report_collector unauthorized(run);unauthorized.submit(body);unauthorized.close();bool wrote=false;
+    rejects([&]{persist_ime_report(unauthorized,identity,run,authority,remaining,
+      [&](const std::string&){wrote=true;});},"IME persistence accepted missing shutdown/quiescence authority");
+    check(!wrote,"Unauthorized IME persistence reached writer");++cases;
+  }
+  ime_report_collector expired(run);expired.submit(body);expired.close();bool expired_write=false;
+  rejects([&]{persist_ime_report(expired,identity,run,allowed,[]{return std::chrono::milliseconds(0);},
+    [&](const std::string&){expired_write=true;});},"IME expired close budget accepted");
+  check(!expired_write,"Expired IME persistence reached writer");++cases;
+  ime_report_collector write_failure(run);write_failure.submit(body);write_failure.close();
+  rejects([&]{persist_ime_report(write_failure,identity,run,allowed,remaining,
+    [](const std::string&){throw std::runtime_error("injected write/flush failure");});},"IME writer failure reported persistence");++cases;
+
+  const auto file=root/L"ime-functional-result.json";
+  const auto writer=[&](const std::string& bytes) {
+    const auto handle=CreateFileW(file.c_str(),GENERIC_WRITE,0,nullptr,CREATE_NEW,FILE_ATTRIBUTE_NORMAL,nullptr);
+    check(handle!=INVALID_HANDLE_VALUE,"IME contract CREATE_NEW failed");DWORD count{};
+    const bool complete=WriteFile(handle,bytes.data(),static_cast<DWORD>(bytes.size()),&count,nullptr)
+      &&count==bytes.size()&&FlushFileBuffers(handle);
