function(soui_llvm22_verify_project)
    _soui_llvm_inputs(current_identity)
    if(NOT current_identity STREQUAL SOUI_LLVM_INPUT_IDENTITY)
        message(FATAL_ERROR "LLVM profile inputs changed while enabling languages")
    endif()
    get_property(_soui_in_try_compile GLOBAL PROPERTY IN_TRY_COMPILE)
    get_property(languages GLOBAL PROPERTY ENABLED_LANGUAGES)
    set(found_language FALSE)
    foreach(language C CXX)
        if(language IN_LIST languages)
            # ABI children inherit the global language list, but only their
            # enabled languages load compiler information in this scope.
            if(_soui_in_try_compile AND NOT CMAKE_${language}_COMPILER_LOADED)
                continue()
            endif()
            set(found_language TRUE)
            string(STRIP "${CMAKE_${language}_FLAGS_INIT}" expected_flags)
            if(NOT "${CMAKE_${language}_FLAGS}" STREQUAL "${expected_flags}")
                message(FATAL_ERROR "LLVM profile refuses an override of common ${language} compiler flags")
            endif()
            foreach(pair "COMPILER_ID|Clang" "COMPILER_VERSION|22.1.3" "COMPILER_FRONTEND_VARIANT|MSVC"
                    "SIMULATE_ID|MSVC" "SIMULATE_VERSION|19.29" "COMPILER_ARCHITECTURE_ID|${_soui_llvm_arch_id}"
                    "COMPILER_TARGET|${_soui_llvm_target}" "SIZEOF_DATA_PTR|${_soui_llvm_pointer_bytes}"
                    "COMPILER|${SOUI_LLVM_ROOT}/bin/clang-cl.exe")
                string(REPLACE "|" ";" fields "${pair}")
                list(GET fields 0 suffix)
                list(GET fields 1 expected)
                if(suffix STREQUAL "COMPILER")
                    _soui_llvm_assert_tool_path("CMAKE_${language}_${suffix}" "${CMAKE_${language}_${suffix}}" "${expected}")
                elseif(suffix STREQUAL "SIZEOF_DATA_PTR" AND _soui_in_try_compile
                        AND "${CMAKE_${language}_${suffix}}" STREQUAL "")
                    # CMake parses the ABI binary after this child project returns.
                    # Known child values and every normal project remain strict.
                    continue()
                elseif(NOT "${CMAKE_${language}_${suffix}}" STREQUAL "${expected}")
                    message(FATAL_ERROR "LLVM observed ${language}.${suffix}=${CMAKE_${language}_${suffix}}; expected ${expected}")
                endif()
            endforeach()
        endif()
    endforeach()
    if(NOT found_language)
        message(FATAL_ERROR "LLVM profile requires a real C or CXX language discovery; LANGUAGES NONE is not evidence")
    endif()
    foreach(pair "LINKER|${SOUI_LLVM_ROOT}/bin/lld-link.exe" "AR|${SOUI_LLVM_ROOT}/bin/llvm-lib.exe"
            "RC_COMPILER|${SOUI_WINDOWS_SDK_ROOT}/bin/10.0.19041.0/x64/rc.exe"
            "MT|${SOUI_WINDOWS_SDK_ROOT}/bin/10.0.19041.0/x64/mt.exe" "MAKE_PROGRAM|${SOUI_NINJA_EXECUTABLE}" "LINKER_TYPE|LLD")
        string(REPLACE "|" ";" fields "${pair}")
        list(GET fields 0 suffix)
        list(GET fields 1 expected)
        if(suffix STREQUAL "LINKER_TYPE")
            if(NOT "${CMAKE_${suffix}}" STREQUAL "${expected}")
                message(FATAL_ERROR "LLVM observed tool changed: CMAKE_${suffix}")
            endif()
        else()
            _soui_llvm_assert_tool_path("CMAKE_${suffix}" "${CMAKE_${suffix}}" "${expected}")
        endif()
    endforeach()
    message(STATUS "LLVM22MSVC142 observed language identity verified; target=${_soui_llvm_target}; SDK files=10.0.19041.0; linker=${CMAKE_LINKER}; librarian=${CMAKE_AR}")
endfunction()

# A generated one-line post-project hook calls the real verifier above. It is not
# a substitute compiler or cached result; project() still performs real discovery.
set(_soui_hook "${CMAKE_BINARY_DIR}/CMakeFiles/SouiLLVM22-Verify.cmake")
set(_soui_hook_content "soui_llvm22_verify_project()")
_soui_llvm_path("${CMAKE_BINARY_DIR}" DIRECTORY checked_build_root)
if(EXISTS "${CMAKE_BINARY_DIR}/CMakeFiles")
    _soui_llvm_path("${CMAKE_BINARY_DIR}/CMakeFiles" DIRECTORY checked_hook_directory)
endif()
if(EXISTS "${_soui_hook}")
    _soui_llvm_path("${_soui_hook}" FILE checked_hook)
    file(SIZE "${_soui_hook}" existing_hook_size)
    string(LENGTH "${_soui_hook_content}" expected_hook_size)
    if(NOT existing_hook_size EQUAL expected_hook_size)
        message(FATAL_ERROR "LLVM post-project hook length changed")
    endif()
    file(READ "${_soui_hook}" existing_hook)
    if(NOT existing_hook STREQUAL _soui_hook_content)
        message(FATAL_ERROR "LLVM post-project hook changed")
    endif()
else()
    file(WRITE "${_soui_hook}" "${_soui_hook_content}")
endif()
_soui_llvm_bind(CMAKE_PROJECT_INCLUDE "${_soui_hook}" FILEPATH)
