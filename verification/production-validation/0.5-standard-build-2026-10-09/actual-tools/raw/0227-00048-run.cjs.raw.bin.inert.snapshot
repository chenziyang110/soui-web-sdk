const fs=require('node:fs'),path=require('node:path'),crypto=require('node:crypto'),vm=require('node:vm');const root='F:/work/sm05-build-caller',folder=__dirname;
const client='F:/work/sm05/tools/internal/owned-process.cjs',runner='F:/work/sm05/out/benchmark-protocol/Release/OwnedProcessRunner.exe',exe=path.join(process.env.SystemRoot,'System32/WindowsPowerShell/v1.0/powershell.exe');
const sha=f=>crypto.createHash('sha256').update(fs.readFileSync(f)).digest('hex');const sources=['tools/internal/standard-build.cjs','tools/Test.ps1','tools/Collect-Verification.cjs','tools/internal/Build-ValidationTools.ps1'];
fs.writeFileSync(path.join(folder,'inputs.json'),JSON.stringify({cwd:root,executable:exe,executableSha256:sha(exe),runner,runnerSha256:sha(runner),client,clientSha256:sha(client),sources:sources.map(name=>({path:name,sha256:sha(path.join(root,name))})),metadataOnly:true},null,2)+'\n',{flag:'wx'});
(async()=>{const owned=require(client).launchOwned(exe,['-NoProfile','-NonInteractive','-ExecutionPolicy','Bypass','-File',path.join(folder,'inspect.ps1'),'-Root',root,'-Probe',path.join(folder,'probe.ps1')],{runner,cwd:root,report:path.join(folder,'owned.ndjson'),timeoutMs:30000,drainMs:2000,stdout:'pipe',stderr:'pipe'});const out=[],err=[];owned.child.stdout.on('data',b=>out.push(b));owned.child.stderr.on('data',b=>err.push(b));const result=await owned.finished;fs.writeFileSync(path.join(folder,'stdout.bin'),Buffer.concat(out),{flag:'wx'});fs.writeFileSync(path.join(folder,'stderr.bin'),Buffer.concat(err),{flag:'wx'});fs.writeFileSync(path.join(folder,'finished.json'),JSON.stringify(result,null,2)+'\n',{flag:'wx'});if(!result.passed)throw Error('AST owned Job failed');
const source=fs.readFileSync(path.join(root,'tools/Collect-Verification.cjs'),'utf8'),start=source.indexOf('const unit={'),end=source.indexOf('\n};',start)+3;const module={};vm.runInNewContext(source.slice(start,end)+';out.unit=unit',{out:module,run:(name,executable,args)=>({name,executable,args}),process:{execPath:process.execPath},path,root});
for(const [name,kind,arch] of [['compilerTailProtocol','tail-protocol','x64'],['nativeCompilerTailX64','tail-native','x64'],['nativeCompilerTailX86','tail-native','x86']]){const args=module.unit[name].args;if(JSON.stringify(args)!==JSON.stringify(['tools/internal/measurement-validation.cjs',kind,arch]))throw Error('Collect delta mismatch');}
fs.writeFileSync(path.join(folder,'collect-projection.json'),JSON.stringify(module.unit,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({folder,passed:true,metadataOnly:true,sourceChecks:sources.length}));})().catch(e=>{console.error(e);process.exitCode=1});