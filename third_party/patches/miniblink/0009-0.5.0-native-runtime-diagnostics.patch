+// #endif
+int open_readonly(const char * filename, int flag)
+{
+    wchar_t* filenameW = 0;
+
+    int fp = -1;
+
+    if (userOpenFile)
+        return (int)userOpenFile(filename);
+
+    filenameW = utf8_to_wide_char(filename);
+    fp = _wopen(filenameW, flag);
+
+    free(filenameW);
+
+    if (-1 != fp)
+        return fp;
+
+    fp = _open(filename, flag);
+    return fp;
+}
