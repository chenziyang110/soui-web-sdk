'use strict';
// Inert until Root reviews and launches through the leased guard.
const fs=require('node:fs'),path=require('node:path'),crypto=require('node:crypto');
const directory=__dirname,sha=b=>crypto.createHash('sha256').update(b).digest('hex');
const digest=file=>sha(fs.readFileSync(file)),json=(file,value)=>fs.writeFileSync(file,JSON.stringify(value,null,2)+'\n',{flag:'wx'});
function normalize(file){return path.resolve(file).replaceAll('\\','/').toLowerCase();}
function list(root){return fs.readdirSync(root,{withFileTypes:true}).flatMap(e=>{const file=path.join(root,e.name);if(e.isSymbolicLink())throw Error('Symlink refused');if(e.isDirectory())return list(file);if(!e.isFile())throw Error('Nonregular input refused');return[file];}).sort();}
function pin(p){if(!p||!path.isAbsolute(p.path)||!Number.isSafeInteger(p.bytes)||p.bytes<0||!/^[a-f0-9]{64}$/.test(p.sha256)||!fs.lstatSync(p.path).isFile()||fs.statSync(p.path).size!==p.bytes||digest(p.path)!==p.sha256)throw Error('Input/tool pin mismatch: '+p?.path);return p;}
function parse(argv){const a={};for(let n=0;n<argv.length;n+=2){if(!/^--[a-z-]+$/.test(argv[n])||argv[n+1]===undefined||a[argv[n]]!==undefined)throw Error('Invalid arguments');a[argv[n]]=argv[n+1];}return a;}
async function main(){
 const a=parse(process.argv.slice(2));
 if(a['--root-gate']!=='ROOT_W6_REFERENCE_V3_PURE'||a['--mode']!=='pure'||a['--arch']!=='x64'||!/^[a-f0-9]{64}$/.test(a['--package-sha']||'')||Object.keys(a).some(k=>!['--root-gate','--package-sha','--mode','--arch'].includes(k)))throw Error('Root mode/arguments invalid');
 const packageFile=path.join(directory,'package.json');if(digest(packageFile)!==a['--package-sha'])throw Error('Package pin mismatch');
 const packet=JSON.parse(fs.readFileSync(packageFile,'utf8'));
 if(packet.schema!=='private-w6-reference-v3-pure/1'||packet.owner!=='Root only'||packet.payloads.length!==41||packet.readInputs.length!==30||packet.pureNames.length!==38||packet.releaseReady!==false||packet.qualificationPassed!==false)throw Error('Finite contract changed');
 function packageCheck(){
  if(digest(packageFile)!==a['--package-sha'])throw Error('Package changed');
  for(const p of [...packet.packageFiles,packet.readInputs,packet.payloads].flat())pin(p);
  pin(packet.candidateCopyPlan);
  if(JSON.stringify(list(directory).map(file=>path.relative(directory,file).replaceAll('\\','/')).sort())!==JSON.stringify(packet.membership))throw Error('Packet membership/user props changed');
 }
 packageCheck();const tools=JSON.parse(fs.readFileSync(path.join(directory,'tools.json'),'utf8'));
 const toolPins=[tools.node,tools.runner,tools.ownedClient,tools.cmake,tools.ctest,tools.msbuild,tools.dumpbin,tools.cmd,tools.rc,tools.mt,tools.vsDevCmd,tools.ml64,...tools.toolImages];
 const toolCheck=()=>{for(const p of toolPins)pin(p);};toolCheck();
 const output=path.join(packet.outputParent,a['--mode']==='pure'?'pure':a['--arch']);
 if(fs.lstatSync(packet.outputParent).isSymbolicLink()||normalize(fs.realpathSync.native(packet.outputParent))!==normalize(packet.outputParent)||fs.existsSync(output)||!normalize(output).startsWith(normalize(packet.repositoryRoot)+'/out/'))throw Error('Fresh real private output required');
 const contract=packet.architectures.find(p=>p.architecture===a['--arch']);
 const env={};for(const name of packet.environmentAllowlist)if(process.env[name]!==undefined)env[name]=process.env[name];
 const windows=env.SYSTEMROOT||'C:\\Windows';
 env.PATH=[contract.compilerToolDirectory,contract.sdkToolDirectory,path.dirname(tools.msbuild.path),path.dirname(tools.cmake.path),path.join(windows,'System32'),windows].join(';');
 env.CL='/MP2';env.VcpkgEnabled='false';env.VcpkgEnableManifest='false';env.VCPkgLocalAppDataDisabled='true';
 env.TEMP=path.join(output,'temp');env.TMP=env.TEMP;env.USERPROFILE=path.join(output,'profile');env.APPDATA=path.join(output,'profile/roaming');env.LOCALAPPDATA=path.join(output,'profile/local');env.NO_COLOR='1';
 const {launchOwned}=require(tools.ownedClient.path),stages=[];
 fs.mkdirSync(output);for(const file of [env.TEMP,env.USERPROFILE,env.APPDATA,env.LOCALAPPDATA])fs.mkdirSync(file,{recursive:true});
 const source=path.join(output,'source'),reference=path.join(source,'demos/reference-workbench');
 let generatedPins=[];
 for(const p of packet.payloads){const file=path.join(source,p.relative);fs.mkdirSync(path.dirname(file),{recursive:true});fs.copyFileSync(p.path,file,fs.constants.COPYFILE_EXCL);pin({...p,path:file});}
 function sourceCheck(){
  for(const p of packet.payloads)pin({...p,path:path.join(source,p.relative)});
  for(const p of generatedPins)pin(p);
  const expected=packet.payloads.map(p=>p.relative).concat(generatedPins.map(p=>path.relative(source,p.path).replaceAll('\\','/'))).sort();
  if(JSON.stringify(list(source).map(file=>path.relative(source,file).replaceAll('\\','/')).sort())!==JSON.stringify(expected))throw Error('Private source membership changed');
 }
 sourceCheck();
 async function stage(name,exe,args,timeoutMs){
  packageCheck();toolCheck();
  const raw=path.join(output,name+'.owned.jsonl'),out=fs.createWriteStream(path.join(output,name+'.stdout.raw'),{flags:'wx'}),err=fs.createWriteStream(path.join(output,name+'.stderr.raw'),{flags:'wx'}),streamErrors=[];
  out.on('error',e=>streamErrors.push(e.message));err.on('error',e=>streamErrors.push(e.message));const closes=[new Promise(r=>out.once('close',r)),new Promise(r=>err.once('close',r))];
  let owned;try{owned=launchOwned(exe,args,{runner:tools.runner.path,cwd:output,report:raw,timeoutMs,drainMs:2000,env,stdout:'pipe',stderr:'pipe'});}catch(error){out.end();err.end();await Promise.all(closes);throw error;}
  owned.child.stdout.pipe(out);owned.child.stderr.pipe(err);
  const heartbeat=setInterval(()=>console.log(JSON.stringify({stage:name,pid:owned.pid,stdoutBytes:out.bytesWritten,stderrBytes:err.bytesWritten,pending:true})),15000);
  void owned.ready.then(identity=>json(path.join(output,name+'.pending.json'),{name,...identity,timeoutMs,rawJob:raw}),error=>console.error('Owned identity unavailable: '+error.message));
  const finished=await owned.finished;clearInterval(heartbeat);await Promise.all(closes);json(path.join(output,name+'.finished.json'),finished);
  const entry={name,executable:exe,args,cwd:output,pid:finished.pid,creationFileTime:finished.creationFileTime,rootExitCode:finished.exitCode,supervisorExitCode:finished.supervisorExitCode,genericPassed:finished.passed,closureConfirmed:finished.closureConfirmed,rawJob:raw,rawSha256:digest(raw),context:{path:raw+'.context.json',bytes:fs.statSync(raw+'.context.json').size,sha256:digest(raw+'.context.json')},stdout:{path:path.join(output,name+'.stdout.raw'),bytes:fs.statSync(path.join(output,name+'.stdout.raw')).size,sha256:digest(path.join(output,name+'.stdout.raw'))},stderr:{path:path.join(output,name+'.stderr.raw'),bytes:fs.statSync(path.join(output,name+'.stderr.raw')).size,sha256:digest(path.join(output,name+'.stderr.raw'))},streamErrors};stages.push(entry);json(path.join(output,name+'.stage.json'),entry);
  packageCheck();toolCheck();
  const text=fs.readFileSync(raw,'utf8');if(!text.endsWith('\n'))throw Error('Truncated owned report');const rows=text.trimEnd().split('\n').map(JSON.parse),start=rows[0],terminal=rows.at(-1),context=JSON.parse(fs.readFileSync(raw+'.context.json','utf8'));
  if(start.event!=='start'||terminal.event!=='terminal'||rows.filter(p=>p.event==='terminal').length!==1||!Number.isSafeInteger(start.pid)||start.pid<=0||start.pid!==finished.pid||start.creationFileTime!==finished.creationFileTime||typeof start.creationFileTime!=='string'||!/^[1-9]\d{0,19}$/.test(start.creationFileTime)||!start.jobAssignedBeforeResume||start.breakawayAllowed!==false||!terminal.closureConfirmed||terminal.activeProcesses!==0||!terminal.rootExited||JSON.stringify(terminal)!==JSON.stringify(finished.terminal)||context.executable!==exe||context.executableSha256!==digest(exe)||context.runnerSha256!==tools.runner.sha256||JSON.stringify(context.args)!==JSON.stringify(args)||context.cwd!==output)throw Error('Exact raw Owned identity mismatch: '+name);
  const compilePartial=false;
  json(path.join(output,name+'.partial-verdict.json'),{genericPassed:finished.passed,closedCompileContinuation:compilePartial,originalGenericVerdictRetained:true,qualificationPassed:false,releaseReady:false});
  if(finished.spawnError||finished.reportError||finished.signal||finished.stopRequested||finished.fallbackUsed||streamErrors.length||!finished.closureConfirmed||finished.exitCode!==0||(!compilePartial&&(finished.passed!==true||finished.supervisorExitCode!==0||terminal.terminatedOwnedJob!==false)))throw Error('Owned stage failed: '+name);
  return entry;
 }
 const run=async(...args)=>{sourceCheck();const value=await stage(...args);sourceCheck();return value;};
 try{
   const pureIdentity=await run('pure-38',tools.node.path,['--test','--test-reporter=tap',...packet.pureFiles.map(file=>path.join(reference,file))],120000);
   if(pureIdentity.stderr.bytes!==0)throw Error('Pure test stderr must be empty');
   const tap=fs.readFileSync(path.join(output,'pure-38.stdout.raw'),'utf8');
   const matches=[...tap.matchAll(/^ok (\d+) - ([^\r\n]+)$/gm)];
   if(matches.length!==38||matches.some((m,index)=>Number(m[1])!==index+1)||JSON.stringify(matches.map(m=>m[2]).sort())!==JSON.stringify(packet.pureNames)||/^not ok\b/m.test(tap)||/^(?:ok|not ok)\b.*#\s*(?:SKIP|TODO)/mi.test(tap)||!/^1\.\.38\r?$/m.test(tap))throw Error('Exact38 TAP positive set required');
   for(const [key,value]of Object.entries({tests:38,pass:38,fail:0,cancelled:0,skipped:0,todo:0}))if(!new RegExp('^# '+key+' '+value+'\\r?$','m').test(tap))throw Error('TAP count changed: '+key);
   packageCheck();toolCheck();sourceCheck();
   json(path.join(output,'summary.json'),{completed:true,mode:'pure',pureTests:38,stages,actualV3SourceBytes:true,sdkGuiControllerRuntimeExercised:false,nativeBusinessExercised:false,allGenericPassed:true,qualificationPassed:false,releaseReady:false});
  console.log(JSON.stringify({completed:true,mode:'pure',output,qualificationPassed:false,releaseReady:false}));
 }catch(error){json(path.join(output,'summary-failed.json'),{completed:false,mode:'pure',stages,error:error.message,qualificationPassed:false,releaseReady:false});throw error;}
}
main().catch(error=>{console.error(error.message);process.exitCode=1;});
