{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@soui-sdk": [
        "../../../sdk/web/src/index.ts"
      ],
      "react": [
        "node_modules/@types/react"
      ],
      "react/*": [
        "node_modules/@types/react/*"
      ],
      "react-dom/*": [
        "node_modules/@types/react-dom/*"
      ]
    }
  },
  "include": [
    "src",
    "env.d.ts",
    "../common/controller.ts",
    "../common/react-view.tsx",
    "../common/parity-scenario.ts",
    "../common/*.d.mts",
    "../web/src/generated/actions.ts"
  ]
}
