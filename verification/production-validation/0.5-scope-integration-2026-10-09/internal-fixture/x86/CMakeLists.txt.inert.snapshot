cmake_minimum_required(VERSION 3.24)
project(SouiScopeIntegration LANGUAGES CXX)
find_package(SouiSdk CONFIG REQUIRED)
add_executable(task_scope_tests "F:/work/sm05-scopes/tests/native/task_scope_tests.cpp")
target_link_libraries(task_scope_tests PRIVATE Soui::Sdk Soui::ActionJson)
target_compile_options(task_scope_tests PRIVATE /utf-8 /W4 /U_DEBUG)
set_property(TARGET task_scope_tests PROPERTY MSVC_RUNTIME_LIBRARY MultiThreadedDLL)
add_executable(task_service_tests "F:/work/sm05-scopes/tests/native/task_service_tests.cpp")
target_link_libraries(task_service_tests PRIVATE Soui::Sdk Soui::ActionJson)
target_compile_options(task_service_tests PRIVATE /utf-8 /W4 /U_DEBUG)
set_property(TARGET task_service_tests PROPERTY MSVC_RUNTIME_LIBRARY MultiThreadedDLL)
