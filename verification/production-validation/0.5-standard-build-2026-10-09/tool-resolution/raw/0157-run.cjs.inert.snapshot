if(phase==='red'){
 const original=fs.readFileSync(path.join(base,'standard-build.cjs.before.bin'),'utf8');const originalFile=path.join(root,'tools/internal/standard-build.cjs');
 const adapter="'use strict';const fs=require('node:fs');const {createRequire}=require('node:module');const moduleObject={exports:{}};const code=fs.readFileSync("+JSON.stringify(path.join(base,'standard-build.cjs.before.bin'))+",'utf8')+'\\nmodule.exports.inspectTool=file;module.exports.verifyTool=value=>{need(isDeepStrictEqual(file(value.path),value),\\\"Tool identity differs\\\");return true;};';new Function('require','module','exports','__filename','__dirname',code)(createRequire("+JSON.stringify(originalFile)+"),moduleObject,moduleObject.exports,"+JSON.stringify(originalFile)+","+JSON.stringify(path.dirname(originalFile))+");module.exports=moduleObject.exports;";
 put(path.join(folder,'old-adapter.cjs'),Buffer.from(adapter));let tests=fs.readFileSync(path.join(root,'tests/sdk/standard-build.test.cjs'),'utf8');
 for(const [old,newPath]of [['../benchmark/tail-evidence-fixtures.cjs',path.join(root,'tests/benchmark/tail-evidence-fixtures.cjs')],['../../tools/internal/standard-build.cjs',path.join(folder,'old-adapter.cjs')],['../../tools/internal/delivery-identity.cjs',path.join(root,'tools/internal/delivery-identity.cjs')],['../../tools/internal/build-evidence.cjs',path.join(root,'tools/internal/build-evidence.cjs')]])tests=tests.replaceAll("require('"+old+"')",'require('+JSON.stringify(newPath)+')');
 put(path.join(folder,'red-standard-build.test.cjs'),Buffer.from(tests));args=['--test','--test-reporter=tap',path.join(folder,'red-standard-build.test.cjs')];
}else if(phase==='green')args=['--test','--test-reporter=tap','tests/sdk/standard-build.test.cjs'];else args=['tools/internal/measurement-validation.cjs','tail-protocol',phase.endsWith('x86')?'x86':'x64'];
const sourceNames=['tools/internal/standard-build.cjs','tests/sdk/standard-build.test.cjs','docs/adr/0033-standard-owned-build-caller.md','docs/standard-build.md'];const source=sourceNames.map(name=>({path:name,sha256:sha(fs.readFileSync(path.join(root,name)))}));put(path.join(folder,'inputs.json'),{phase,cwd:root,executable:process.execPath,requestedPath:process.execPath,resolvedPath:fs.realpathSync.native(process.execPath),executableSha256:sha(fs.readFileSync(process.execPath)),args,provider,source,oldAdapterExposesOriginalFileWithoutChangingOldImplementation:phase==='red',noSdkBuild:true,noGui:true,compilerTailPolicyRequested:false});
(async()=>{const run=require(provider.client).launchOwned(process.execPath,args,{runner:provider.runner,cwd:root,report:path.join(folder,'owned.ndjson'),timeoutMs:180000,drainMs:3000,stdout:'pipe',stderr:'pipe',env:{...process.env,MSBUILDDISABLENODEREUSE:'1'}});const out=[],err=[];run.child.stdout.on('data',b=>out.push(b));run.child.stderr.on('data',b=>err.push(b));const finished=await run.finished;put(path.join(folder,'stdout.bin'),Buffer.concat(out));put(path.join(folder,'stderr.bin'),Buffer.concat(err));put(path.join(folder,'finished.json'),finished);for(const row of source)if(sha(fs.readFileSync(path.join(root,row.path)))!==row.sha256)throw Error('Source changed while test running');const text=Buffer.concat(out).toString('utf8');let summary;if(phase.startsWith('tail-'))summary=JSON.parse(text);else {const counts={};for(const name of ['tests','pass','fail','cancelled','skipped','todo']){const m=new RegExp('^# '+name+' (\\d+)\\r?$','m').exec(text);if(!m)throw Error('Missing TAP '+name);counts[name]=Number(m[1]);}summary={counts,expectedRegressionRed:phase==='red'};}put(path.join(folder,'summary.json'),summary);console.log(JSON.stringify({folder,rootExitCode:finished.exitCode,supervisorExitCode:finished.supervisorExitCode,genericPassed:finished.passed,closureConfirmed:finished.closureConfirmed,counts:summary.counts}));process.exitCode=phase==='red'?(finished.exitCode===1&&finished.closureConfirmed&&summary.counts.fail===5?0:1):(finished.passed?0:1);})().catch(e=>{console.error(e);process.exitCode=1});