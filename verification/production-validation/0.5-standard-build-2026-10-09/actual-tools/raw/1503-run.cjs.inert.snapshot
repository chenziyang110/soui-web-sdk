'use strict';const fs=require('node:fs'),path=require('node:path'),crypto=require('node:crypto');const root='F:/work/sm05-build-caller',base=__dirname,phase=process.argv[2],arch=process.argv[3];if(!['x86','x64'].includes(arch)||!['build','protocol','native','tail-protocol','tail-native'].includes(phase))throw Error('Invalid phase');
const sha=bytes=>crypto.createHash('sha256').update(bytes).digest('hex');const frozen=JSON.parse(fs.readFileSync(path.join(base,'frozen-inputs.original.json')));const check=()=>{for(const f of frozen.files)if(sha(fs.readFileSync(path.join(root,f.path)))!==f.sha256)throw Error('Source changed: '+f.path);};check();
const provider=JSON.parse(fs.readFileSync(path.join(base,'provider.json')));if(sha(fs.readFileSync(provider.runner))!==provider.runnerSha256||sha(fs.readFileSync(provider.client))!==provider.clientSha256)throw Error('Provider changed');
const folder=path.join(base,phase+'-'+arch+'-'+crypto.randomUUID());fs.mkdirSync(folder);const exe=phase==='build'?path.join(process.env.SystemRoot,'System32/WindowsPowerShell/v1.0/powershell.exe'):process.execPath;
const args=phase==='build'?['-NoProfile','-NonInteractive','-ExecutionPolicy','Bypass','-File',path.join(root,'tools/internal/Build-ValidationTools.ps1'),'-Architecture',arch,'-FreshConfigure']:['tools/internal/measurement-validation.cjs',phase,arch];
const env={...process.env,MSBUILDDISABLENODEREUSE:'1'};const keys=Object.keys(env);for(const key of keys)if(key.toLowerCase()==='psmodulepath')delete env[key];env.PSModulePath=path.join(process.env.SystemRoot,'System32/WindowsPowerShell/v1.0/Modules');
fs.writeFileSync(path.join(folder,'inputs.json'),JSON.stringify({phase,architecture:arch,cwd:root,executable:exe,executableSha256:sha(fs.readFileSync(exe)),args,provider,frozenInputSha256:sha(fs.readFileSync(path.join(base,'frozen-inputs.original.json'))),MSBUILDDISABLENODEREUSE:'1',PSModulePath:env.PSModulePath,noGui:true,compilerTailPolicyRequested:false,releaseReady:false},null,2)+'\n',{flag:'wx'});
(async()=>{const owned=require(provider.client).launchOwned(exe,args,{runner:provider.runner,cwd:root,report:path.join(folder,'owned.ndjson'),timeoutMs:phase==='build'?600000:180000,drainMs:phase==='build'?30000:3000,stdout:'pipe',stderr:'pipe',env});const out=[],err=[];let size=0;const collect=(target,b)=>{size+=b.length;if(size>16*1024*1024){owned.stop();throw Error('Output too large');}target.push(b);};owned.child.stdout.on('data',b=>collect(out,b));owned.child.stderr.on('data',b=>collect(err,b));const result=await owned.finished;fs.writeFileSync(path.join(folder,'stdout.bin'),Buffer.concat(out),{flag:'wx'});fs.writeFileSync(path.join(folder,'stderr.bin'),Buffer.concat(err),{flag:'wx'});fs.writeFileSync(path.join(folder,'finished.json'),JSON.stringify(result,null,2)+'\n',{flag:'wx'});check();
let summary;if(phase==='build'){const setup=require(path.join(root,'tools/internal/measurement-validation.cjs')).prepared(arch);summary={phase,architecture:arch,compileCompleted:result.exitCode===0,prepared:setup.report,genericSupervisionPassed:result.passed,closureConfirmed:result.closureConfirmed,compilerTailAcceptance:false,releaseReady:false};}else{summary=JSON.parse(Buffer.concat(out).toString('utf8'));if(!result.passed)throw Error('Outer group Job failed');}
fs.writeFileSync(path.join(folder,'summary.json'),JSON.stringify(summary,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({folder,phase,architecture:arch,rootExitCode:result.exitCode,supervisorExitCode:result.supervisorExitCode,genericPassed:result.passed,closureConfirmed:result.closureConfirmed,innerCounts:summary.counts??null}));process.exitCode=phase==='build'?(result.exitCode===0&&result.closureConfirmed?0:1):0;
})().catch(error=>{console.error(error);process.exitCode=1});