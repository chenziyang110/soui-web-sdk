
'use strict';
const fs=require('node:fs'),path=require('node:path'),os=require('node:os'),cp=require('node:child_process'),assert=require('node:assert/strict');
const root=path.resolve(__dirname,'../..'),out=path.join(__dirname,'external-consumer'),identity=require(path.join(root,'tools/internal/delivery-identity.cjs')),gui=require(path.join(root,'tools/sdk/gui-bindings-delivery.cjs')),sdk=require(path.join(root,'tools/sdk/soui-sdk.cjs'));
fs.mkdirSync(out,{recursive:true});const temp=fs.mkdtempSync(path.join(os.tmpdir(),'soui-gui-actioncore-proof-')),commands=[];
function run(name,program,args,cwd){const r=cp.spawnSync(process.execPath,[program,...args],{cwd,encoding:'utf8',timeout:60000,windowsHide:true});fs.writeFileSync(path.join(out,name+'.stdout.log'),r.stdout||'',{flag:'wx'});fs.writeFileSync(path.join(out,name+'.stderr.log'),r.stderr||'',{flag:'wx'});const record={cwd,executable:process.execPath,args:[program,...args],exitCode:r.status,error:r.error?.message||null};commands.push(record);if(r.status!==0)throw Error(name+' failed: '+r.stderr);return r.stdout;}
try{
 const version=gui.metadata(root),before=gui.verify(root),packed=path.join(temp,'packed'),installed=path.join(temp,'installed'),moved=path.join(temp,'relocated');sdk.pack(root,packed,version,{withGuiBindings:true});const manifest=sdk.readPackage(packed);sdk.install(packed,installed);fs.renameSync(installed,moved);const lock=sdk.readLock(moved);assert.equal(gui.verify(moved).output.sha256,before.output.sha256);fs.writeFileSync(path.join(out,'sdk-manifest.json'),identity.encoded(manifest),{flag:'wx'});fs.writeFileSync(path.join(out,'sdk-lock.json'),identity.encoded(lock),{flag:'wx'});
 const npm=path.join(path.dirname(process.execPath),'node_modules/npm/bin/npm-cli.js'),tarballs=[],deps={};for(const entry of gui.packages){const packedMeta=JSON.parse(run('pack-'+entry.name.replaceAll('/','-'),npm,['pack',path.join(moved,entry.root),'--pack-destination',out,'--json','--ignore-scripts'],moved))[0];assert.equal(packedMeta.version,version);const filename=path.join(out,packedMeta.filename),data=fs.readFileSync(filename);assert.ok(packedMeta.files.some(file=>file.path===entry.import));assert.ok(packedMeta.files.some(file=>file.path===entry.types));tarballs.push({name:entry.name,version,filename:packedMeta.filename,bytes:data.length,sha256:identity.hash(data),npm:packedMeta});deps[entry.name]='file:'+filename.replaceAll('\\','/');}
 const consumer=path.join(temp,'consumer');fs.mkdirSync(consumer);const metadata=JSON.parse(fs.readFileSync(path.join(root,'tests/gui-bindings/package.json')));Object.assign(deps,{react:metadata.dependencies.react,'react-dom':metadata.dependencies['react-dom'],vue:metadata.dependencies.vue,'@types/react':metadata.devDependencies['@types/react'],'@types/react-dom':metadata.devDependencies['@types/react-dom'],typescript:metadata.devDependencies.typescript});fs.writeFileSync(path.join(consumer,'package.json'),identity.encoded({name:'actual-actioncore-gui-consumer',version:'0.1.0',private:true,type:'module',dependencies:deps}));for(const name of ['consumer.ts','tsconfig.json'])fs.copyFileSync(path.join(root,'tests/gui-bindings',name),path.join(consumer,name));run('consumer-install',npm,['install','--offline','--ignore-scripts','--no-audit','--no-fund'],consumer);
 for(const entry of gui.packages){const dir=path.join(consumer,'node_modules',entry.name);assert.equal(fs.lstatSync(dir).isSymbolicLink(),false);assert.equal(JSON.parse(fs.readFileSync(path.join(dir,'package.json'))).version,version);if(entry.framework){assert.equal(fs.existsSync(path.join(dir,'node_modules/@soui/native-sdk')),false);for(const file of identity.walk(dir,'dist').filter(name=>name.endsWith('.js'))){const text=fs.readFileSync(path.join(dir,file),'utf8');assert.equal(/from\s*['"]@soui\/native-sdk['"]/.test(text),false,'Bindings must not create SDK runtime imports');}}}
 run('consumer-types',path.join(consumer,'node_modules/typescript/bin/tsc'),['-p',path.join(consumer,'tsconfig.json')],consumer);fs.writeFileSync(path.join(consumer,'imports.mjs'),"import * as sdk from '@soui/native-sdk'; import {useSouiGuiNode as react} from '@soui/gui-react'; import {useSouiGuiNode as vue} from '@soui/gui-vue'; if([sdk.SouiGui,sdk.readSouiActionContract,sdk.validateSouiActionInput,react,vue].some(value=>typeof value!=='function')) throw Error('Missing ActionCore or GUI imports'); console.log('ActionCore and GUI imports passed');\n");run('consumer-imports',path.join(consumer,'imports.mjs'),[],consumer);
 for(const name of ['package.json','package-lock.json','consumer.ts','tsconfig.json','imports.mjs'])fs.copyFileSync(path.join(consumer,name),path.join(out,name));for(const entry of gui.packages)fs.writeFileSync(path.join(out,entry.name.replaceAll('/','-')+'-installed-package.json'),fs.readFileSync(path.join(consumer,'node_modules',entry.name,'package.json')),{flag:'wx'});
 const after=gui.verify(root);assert.equal(after.source.sha256,before.source.sha256);assert.equal(after.output.sha256,before.output.sha256);fs.writeFileSync(path.join(out,'result.json'),identity.encoded({passed:true,version,commands,tarballs,sourceSha256:before.source.sha256,outputSha256:before.output.sha256,manifestSha256:identity.hash(identity.encoded(manifest)),sdkLockSha256:identity.hash(identity.encoded(lock)),packagedRelocatedWithoutRebuilding:true,actualActionCoreImports:true,noSourceAlias:true,noSecondSdkRuntime:true,desktopValidated:false}),{flag:'wx'});console.log(JSON.stringify({out,passed:true,version,tarballs:tarballs.map(({name,bytes,sha256})=>({name,bytes,sha256}))}));
}finally{assert.ok(fs.realpathSync(temp).startsWith(fs.realpathSync(os.tmpdir())+path.sep));fs.rmSync(temp,{recursive:true,force:true});}
