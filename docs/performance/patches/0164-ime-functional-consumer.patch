+  };
+  accepted.close();const auto saved=persist_ime_report(accepted,identity,run,allowed,remaining,writer);
+  check(saved.at("persisted")==true&&saved.at("page_snapshot")==page
+    &&saved.at("functional_pass").is_null()&&saved.at("os_ime_coverage")=="unknown"
+    &&saved.at("native_late_commit_coverage")=="unknown"&&saved.at("native_dual_flags_coverage")=="unknown"
+    &&saved.at("performanceGate")==false&&saved.at("releaseReady")==false,
+    "IME first observation was lost or admission became qualification");++cases;
+  rejects([&]{accepted.take(identity,run);},"IME collector observation was taken twice");++cases;
+  const auto read_file=[&] {
+    std::ifstream input(file,std::ios::binary);check(input.good(),"IME persisted contract file missing");
+    return std::string(std::istreambuf_iterator<char>(input),{});
+  };
+  const auto first=read_file();ime_report_collector collision(run);collision.submit(body);collision.close();
+  rejects([&]{persist_ime_report(collision,identity,run,allowed,remaining,writer);},"IME CREATE_NEW collision reported success");
+  check(read_file()==first,"IME persistence collision overwrote evidence");++cases;
+  ime_report_collector unsubmitted(run);unsubmitted.close();std::string absent_bytes;
+  const auto absent=persist_ime_report(unsubmitted,identity,run,allowed,remaining,
+    [&](const std::string& bytes){absent_bytes=bytes;});
+  check(absent.at("submission")=="unsubmitted"&&absent.at("persisted")==false
+    &&absent.at("page_snapshot").is_null()&&!absent_bytes.empty(),"Missing IME observation was fabricated");++cases;
+  std::cout<<"IME report contracts: "<<cases<<"; parser/collector only, no Blink/OS IME/GUI\n";
+  return cases;
+}
+}
