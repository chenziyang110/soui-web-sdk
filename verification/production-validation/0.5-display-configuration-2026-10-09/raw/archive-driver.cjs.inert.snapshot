'use strict';
const fs=require('node:fs'),path=require('node:path'),crypto=require('node:crypto'),os=require('node:os');
const root='F:/work/sm05-scopes',output=__dirname;
const archive=path.join(root,'verification/production-validation/0.5-display-configuration-2026-10-09');
const runner='F:/work/sm05/out/benchmark-protocol/Release/OwnedProcessRunner.exe';
const sets=[
 {name:'native',directory:path.join(root,'out/display-calibration-final-9222515f-d05e-4048-bb2c-9986610848a9'),index:'index.json',key:'relativePath',count:566,sha256:'e93ad06ff204961290a1f3d1d05765fa728faf78bc6a58b3405e3007305f9033'},
 {name:'standard',directory:path.join(root,'out/display-standard-integration-8ca5ea8c-73db-40c9-9dda-a5bb0671d7c9'),index:'index-complete.json',key:'path',count:1892,sha256:'a02b4d01c786b8cb9a1a3c2b5dfe493851ca70f8e1f6b3b0a50eb00f4f0f76a9'}
];
const hash=b=>crypto.createHash('sha256').update(b).digest('hex'),enc=v=>Buffer.from(JSON.stringify(v,null,2)+'\n');
const need=(x,m)=>{if(!x)throw Error(m);};
const normalized=x=>path.resolve(x).toLowerCase();
function safeAbsolute(file){
 need(path.isAbsolute(file),'Path not absolute');const full=path.resolve(file),parsed=path.parse(full);let cursor=parsed.root;
 for(const part of full.slice(parsed.root.length).split(path.sep).filter(Boolean)){cursor=path.join(cursor,part);if(!fs.existsSync(cursor))break;need(!fs.lstatSync(cursor).isSymbolicLink(),'Linked path '+cursor);}
 return full;
}
function relative(base,name){
 need(typeof name==='string'&&name&&!name.includes('\\')&&!name.includes(':')&&name.split('/').every(x=>x&&x!=='.'&&x!=='..'),'Unsafe relative path');
 const full=safeAbsolute(path.join(base,name));need(normalized(full).startsWith(normalized(base)+path.sep),'Path escapes base');return full;
}
function read(file){
 safeAbsolute(file);const st=fs.lstatSync(file);need(st.isFile()&&st.nlink===1,'Not independent regular '+file);const fd=fs.openSync(file,'r');
 try{const a=fs.fstatSync(fd),b=fs.readFileSync(fd),z=fs.fstatSync(fd);need(a.dev===z.dev&&a.ino===z.ino&&a.size===z.size&&a.mtimeMs===z.mtimeMs&&b.length===a.size,'Changed read '+file);return b;}finally{fs.closeSync(fd);}
}
function meta(file){const b=read(file);return {path:file,bytes:b.length,sha256:hash(b)};}
function check(file,row){const b=read(file);need(b.length===row.bytes&&hash(b)===row.sha256,'Changed original '+file);return b;}
function write(file,b){
 safeAbsolute(file);need(normalized(file).startsWith(normalized(output)+path.sep)||normalized(file).startsWith(normalized(archive)+path.sep),'Write outside ownership');
 fs.mkdirSync(path.dirname(file),{recursive:true});safeAbsolute(path.dirname(file));const fd=fs.openSync(file,'wx');try{fs.writeFileSync(fd,b);fs.fsyncSync(fd);}finally{fs.closeSync(fd);}need(read(file).equals(Buffer.isBuffer(b)?b:Buffer.from(b)),'Write differs');
}
function json(file){return JSON.parse(read(file));}
function tool(file){const resolvedPath=fs.realpathSync(file),b=read(resolvedPath);return {path:path.resolve(file),resolvedPath,bytes:b.length,sha256:hash(b)};}
function recheckTool(row){need(normalized(fs.realpathSync(row.path))===normalized(row.resolvedPath),'Tool resolution changed');check(row.resolvedPath,row);}
function binaryKind(name,b){
 // Do not trust renaming: a vendor/compiler PE remains binary in an inert file.
 if(b.length>=64&&b.readUInt16LE(0)===0x5a4d){const off=b.readUInt32LE(60);if(off>=64&&off+24<=b.length&&b.readUInt32LE(off)===0x4550)return 'pe-image-magic';}
 if(b.subarray(0,8).equals(Buffer.from('!<arch>\n')))return 'coff-library-magic';
 if(b.subarray(0,24).toString('ascii').startsWith('Microsoft C/C++ MSF'))return 'pdb-magic';
 let bare=path.basename(name).replace(/\.inert\.(?:snapshot|binary)$/i,'');
 if(/\.(?:exe|dll|obj|lib|pdb|pch|idb|ilk|ipdb|iobj|res)(?:\.renamed)?$/i.test(bare))return 'compiled-binary-name';
 if(/\.binlog(?:\.gz)?$/i.test(bare))return 'private-binlog-body';
 return null;
}
function scan(base){
 const rows=[];function walk(dir){for(const name of fs.readdirSync(dir).sort()){const full=path.join(dir,name),st=fs.lstatSync(full);need(!st.isSymbolicLink(),'Archive/private directory linked');if(st.isDirectory())walk(full);else {need(st.isFile()&&st.nlink===1,'Not regular archive file');const b=read(full);rows.push({path:path.relative(base,full).replace(/\\/g,'/'),bytes:b.length,sha256:hash(b)});}}}walk(base);return rows;
}
function preflight(){
 for(const set of sets){const b=read(path.join(set.directory,set.index));need(hash(b)===set.sha256,'Frozen index changed '+set.name);set.data=JSON.parse(b);need(set.data.payload.length===set.count,'Count differs '+set.name);set.indexBytes=b;
  const seen=new Set();for(const row of set.data.payload){const name=row[set.key];need(!seen.has(name),'Duplicate indexed path');seen.add(name);check(relative(set.directory,name),row);}
 }
}
async function audit(){
 const client=path.join(root,'tools/internal/owned-process.cjs'),cli=path.join(path.dirname(fs.realpathSync(process.execPath)),'node_modules/npm/bin/npm-cli.js');
 const tools=[tool(process.execPath),tool(cli),tool(runner),tool(client)];
 need(tools[2].sha256==='1a4cb4bea83a70ac06efb9c50e26a5c3345aab589f9c2e1306b244f68b09713f'&&tools[3].sha256==='8ccec5802c793b45990d2d7585f2c29fb618a7b170adebd5d270a7c291757ce7','Audit providers changed');
 need(fs.existsSync(path.join(root,'sdk/web/node_modules/typescript')),'Existing dependencies missing; no installation permitted');
 const directory=path.join(output,'audit');fs.mkdirSync(directory);
 const usr=path.join(directory,'empty-user.npmrc'),global=path.join(directory,'empty-global.npmrc');write(usr,Buffer.alloc(0));write(global,Buffer.alloc(0));
 const packageInputs=['sdk/web/package.json','sdk/web/package-lock.json'].map(name=>({name,...meta(relative(root,name))}));
 packageInputs.forEach((item,i)=>write(path.join(directory,'package-'+i+'.json.inert.snapshot'),read(item.path)));
 const env={...process.env},removedEnvironmentNames=[];
 for(const key of Object.keys(env))if(/token|secret|password|passwd|credential|auth|api.?key|private.?key|access.?key|^gh_|^github_|^npm_config_|^(?:http|https|all)_proxy$/i.test(key)){removedEnvironmentNames.push(key);delete env[key];}
 env.MSBUILDDISABLENODEREUSE='1';
 const args=[cli,'--prefix','sdk/web','--cache',path.join(directory,'npm-cache'),'--userconfig',usr,'--globalconfig',global,'--registry','https://registry.npmjs.org','--ignore-scripts','audit','--json'];
 const npmPackage=json(path.join(path.dirname(fs.realpathSync(process.execPath)),'node_modules/npm/package.json'));
 write(path.join(directory,'inputs.json'),enc({schema:'soui.display-archive-audit-inputs/v1',requestedCommand:'npm --prefix sdk/web audit --json',executable:process.execPath,args,cwd:root,tools,packageInputs,npmVersion:npmPackage.version,nodeVersion:process.version,removedEnvironmentNames:removedEnvironmentNames.sort(),isolatedConfigs:true,noInstall:true,noTailPolicy:true,timeoutMs:120000,drainMs:3000}));
 const stdout=fs.openSync(path.join(directory,'stdout.bin'),'wx'),stderr=fs.openSync(path.join(directory,'stderr.bin'),'wx');let done;
 try{const job=require(client).launchOwned(process.execPath,args,{runner,cwd:root,report:path.join(directory,'owned.ndjson'),timeoutMs:120000,drainMs:3000,env,stdout,stderr});await job.ready;done=await job.finished;}finally{fs.closeSync(stdout);fs.closeSync(stderr);}
 write(path.join(directory,'finished.json'),enc(done));tools.forEach(recheckTool);packageInputs.forEach(row=>check(row.path,row));
 const data=json(path.join(directory,'stdout.bin')),raw=read(path.join(directory,'owned.ndjson')),rows=raw.toString('utf8').trimEnd().split('\n').map(JSON.parse),terminal=rows.at(-1);
 const summary={rootExitCode:done.exitCode,supervisorExitCode:done.supervisorExitCode,genericPassed:done.passed,naturalClosure:done.passed&&terminal.reason==='completed'&&terminal.activeProcesses===0&&terminal.terminatedOwnedJob===false,closureConfirmed:done.closureConfirmed,reportSha256:hash(raw),vulnerabilities:data.metadata?.vulnerabilities,auditVersion:data.auditReportVersion,npmVersion:npmPackage.version,nodeVersion:process.version,noInstall:true,noTailPolicy:true,environmentValuesPublished:false};
 write(path.join(directory,'summary.json'),enc(summary));need(summary.naturalClosure&&done.exitCode===0&&done.supervisorExitCode===0&&data.metadata?.vulnerabilities?.total===0,'Audit failed; private raw retained');
 return {directory,summary};
}
async function main(){
 need(!fs.existsSync(archive),'Public archive exists: create-only');preflight();
 const standardResult=json(path.join(sets[1].directory,'sealed-b5ce66c8-bfd3-452a-8a00-4293f1885a2f/results-final.json'));
 const nativeResult=json(path.join(sets[0].directory,'result-final.json'));
 const nativeFrozen=json(path.join(sets[0].directory,'frozen-inputs-final.json'));
 need(nativeResult.counts.total===48&&nativeResult.counts.genericFalse===15&&nativeResult.counts.genericTrue===33,'Native historical outcomes differ');
 need(standardResult.sourceFiles.length===42&&standardResult.compilerFingerprint.files.length===17&&standardResult.groupResults.length===10&&standardResult.phaseResults.length===21,'Standard historical scope differs');
 const x86=standardResult.phaseResults.find(x=>x.phase==='build'&&x.architecture==='x86');need(x86.rootExitCode===0&&x86.supervisorExitCode===124&&x86.genericPassed===false&&x86.closureConfirmed,'x86 failure was altered');
 const before=sets.map(set=>({name:set.name,index:meta(path.join(set.directory,set.index)),payload:set.count}));
 write(path.join(output,'preflight.json'),enc({originals:before,sourceClaim:'frozen historical source only; no new current-source/OS/performance claim',noTailPolicy:true}));
 const auditResult=await audit();preflight();fs.mkdirSync(archive);safeAbsolute(archive);
 const mapping=[],privateArtifacts=[];
 function importFile(set,row,i){
  const name=row[set.key],original=relative(set.directory,name),b=check(original,row),kind=binaryKind(name,b);
  const record={cohort:set.name,originalPath:original,originalRelativePath:name,historicalSourceAbsolutePath:row.sourceAbsolutePath||null,bytes:row.bytes,sha256:row.sha256};
  if(kind){record.disposition='hash-only-private-binary';record.binaryKind=kind;mapping.push(record);privateArtifacts.push(record);return;}
  const leaf=path.basename(name),suffix=leaf.endsWith('.inert.snapshot')?'':'.inert.snapshot';
  record.archivePath='raw/'+set.name+'/'+String(i).padStart(5,'0')+'-'+leaf+suffix;record.disposition='byte-exact-copy';write(relative(archive,record.archivePath),b);mapping.push(record);
 }
 for(const set of sets){set.data.payload.forEach((row,i)=>importFile(set,row,i));
  const name='raw/original-'+set.name+'-index.json.inert.snapshot';write(relative(archive,name),set.indexBytes);mapping.push({cohort:set.name,originalPath:path.join(set.directory,set.index),originalRelativePath:set.index,archivePath:name,bytes:set.indexBytes.length,sha256:set.sha256,disposition:'byte-exact-copy'});
 }
 // The previous standard seal intentionally left 100 real build/fixture outputs private.
 const priorMap=json(path.join(sets[1].directory,'sealed-b5ce66c8-bfd3-452a-8a00-4293f1885a2f/current-map.json'));
 for(const row of priorMap.privateArtifacts){check(row.path,row);privateArtifacts.push({...row,cohort:'standard-current-map-private',disposition:'hash-only-private-artifact'});}
 need(priorMap.privateArtifacts.length===100&&priorMap.links.length===2,'Previous private dispositions changed');
 for(const row of scan(auditResult.directory).filter(row=>!row.path.startsWith('npm-cache/'))){
  const original=relative(auditResult.directory,row.path),b=check(original,row);need(!binaryKind(row.path,b),'Unexpected audit binary');const target='raw/audit/'+row.path+'.inert.snapshot';write(relative(archive,target),b);mapping.push({cohort:'audit',originalPath:original,archivePath:target,bytes:row.bytes,sha256:row.sha256,disposition:'byte-exact-copy'});
 }
 const driver=read(__filename),driverPath='raw/archive-driver.cjs.inert.snapshot';write(relative(archive,driverPath),driver);mapping.push({cohort:'archive-driver',originalPath:__filename,archivePath:driverPath,bytes:driver.length,sha256:hash(driver),disposition:'byte-exact-copy'});
 write(relative(archive,'byte-exact-map.json'),enc({schema:'soui.display-archive-map/v1',originals:before,records:mapping,links:priorMap.links,originalIndexPathsAreNotArchivePaths:true,releaseReady:false}));
 write(relative(archive,'private-artifacts.json'),enc({schema:'soui.display-private-artifacts/v1',files:privateArtifacts,compiledBinaryBytesPublished:false,vendorPeBytesPublished:false,binlogBodyPublished:false,realByteMagicChecked:true,linksFollowed:false,releaseReady:false}));
 const summary={schema:'soui.display-configuration-archive/v1',archivedAt:new Date().toISOString(),sdkVersionHistory:'0.5.0-preview.1',hostObservation:{platform:process.platform,release:os.release(),version:os.version(),arch:process.arch},originals:before,native:{baseline:nativeFrozen.baseline,counts:nativeResult.counts,pureReader:nativeResult.pureReader,directoryFixture:nativeResult.directoryFixture,collectors:nativeResult.collectors,historicalLimitations:nativeResult.historicalLimitations},standard:{baseline:standardResult.baseline,sourceIdentity:standardResult.sourceIdentity,sourceFiles:42,compilerFingerprint:standardResult.compilerFingerprint,outerJobCount:21,innerJobCount:10,phaseResults:standardResult.phaseResults,groupResults:standardResult.groupResults,additionalReadOnlyVerifierRetained:true,actualEntryProjectionRetained:true},audit:auditResult.summary,
  copiedOriginals:mapping.filter(x=>x.archivePath&&['native','standard'].includes(x.cohort)).length,originalBinaryHashOnly:mapping.filter(x=>!x.archivePath).length,priorPrivateArtifactCount:100,displayConfigurationAccepted:true,configuredRate:{numerator:14850000,denominator:247500,hz:60,scope:'os-reported-configured-target-only'},physicalPresentation:false,opticalCalibration:false,highRefreshValidated:false,performanceGate:false,releaseReady:false,guiValidated:false,fullCollectValidated:false,newOsMatrixValidated:false,win7PeValidated:false,noEtw:true,noSendInput:true,noVm:true,compilerTailAcceptance:false,currentSourceCertification:false,sameUserRewriteAuthenticated:false};
 write(relative(archive,'archive-summary.json'),enc(summary));
 write(relative(archive,'README.md'),Buffer.from(`# 0.5 显示配置与标准测量接入：历史原件归档\n\n本目录逐字保存两套冻结证据：原生显示切片566项（原索引 SHA256 ${sets[0].sha256}）及标准接入1892项（${sets[1].sha256}）。版本历史为0.5.0-preview.1；原生切片基于4fc8c199，标准接入基于41a8435e。它们是不同构建时间的来源与工具身份，不合并成新的当前源码或正式验收。原始索引也完整保留；其中路径属于原私有来源目录，不是本归档文件路径。未复制项须查 byte-exact-map.json 和 private-artifacts.json。\n\n原生来源保留48次 Job（33 generic true、15 false，48 closure confirmed）、45/45纯 reader、两架构各9个TEST_ONLY系统目录/API fixture，以及所有早期错误、失败收集和修订记录。初始 Buffer 快照曾编码为JSON、初始 summary误读 member 字段、早期纯测试缺少预先固定的client字节副本，以及两次历史x86 collector拒绝均如实保留；修正原件单独存在，不追认旧失败。TEST_ONLY返回值并非真实目标系统/驱动测试。\n\n标准接入绑定42输入、17项实际编译fingerprint（${standardResult.compilerFingerprint.sha256}）、9个工具与18个真实PE身份，实际工程/Cache/Compiler CMake/tlog对应SDK19041、v143和C++17。标准21外层、10内层Job、额外只读验证与4个PowerShell入口投影原件均保留，含原始RED、早期测试夹具失败、修后105/105。两架构各protocol 147项/146通过/1既有serializer跳过、native16/16、tail-protocol157/157、tail-native21/21；实际负向Tail夹具Job的失败不被改成通用通过。x64 preparation自然完成；x86编译本体root0，但vctip尾进程清理后generic=false、supervisor124、closure=true。没有应用或追认compiler-tail例外。默认标准入口仅做纯reader回归，真实配置读取需显式选项；仅验证实际AST/Collect块投影，没有执行FullTest/FullCollect。\n\n双架构当前显示记录按本轮native PID/精确FILETIME、context、原始报告/输出及EXE散列绑定。OS报告当前HDMI配置，刷新分数14850000/247500=60Hz。60Hz配置读取不等于实际present/scanout、物理面板认证、高刷新率、输入延迟、帧时间或性能通过。所有physicalPresentation、opticalCalibration、performanceGate、releaseReady及新OS矩阵结论保持false；没有GUI、ETW、SendInput、VM、Win7/PE或长期运行验证。将来也不能把组件缺失或非WDDM的unavailable诊断标为性能通过。\n\n真实编译EXE/OBJ/LIB/PDB、外部Node/CL/MSBuild/User32等PE以及binlog正文没有发布，仅保留原路径、大小、SHA256和已有架构元数据。按字节magic检测已改名的PE，包含标准切片两个pinned-helper.exe.renamed，仍为hash-only；不能以inert名字将真实工具当源码发布。所有公开导入文件（含脚本、CMake、vcxproj、tlog、原始日志）均以.inert.snapshot结尾，字节和换行未归一化。两个TEST_ONLY junction仅有元数据，未跟随。\n\n额外执行真实Node/npm CLI的npm --prefix sdk/web audit --json：现有依赖、无安装/更新、隔离空user/global配置和私有cache、child环境移除凭据相关名字而不输出值，vulnerabilities.total=0、root/supervisor0、generictrue、自然闭合。raw/audit保存实际命令/工具/包锁身份与原始Job输出。\n\nindex.json逐项索引归档文件（不含自身）；byte-exact-map.json关联冻结原件与新文件散列。SHA用于发现本地意外不一致，不认证能够重写整套证据的同权限攻击者。Root后续负责Git中的-text属性、忽略文件显式纳入、逐项HEAD blob核验、文档与清单；本归档本身不宣称完成这些Git步骤。\n`));
 preflight();for(const row of mapping){check(row.originalPath,row);if(row.archivePath)check(relative(archive,row.archivePath),row);}
 const files=scan(archive);for(const row of files)need(!binaryKind(row.path,check(relative(archive,row.path),row)),'Public binary detected '+row.path);
 write(relative(archive,'index.json'),enc({schema:'soui.display-configuration-persistent-file-index/v1',files,bytes:files.reduce((n,x)=>n+x.bytes,0),releaseReady:false}));
 files.forEach(row=>check(relative(archive,row.path),row));const index=meta(path.join(archive,'index.json'));
 const completion={archive,indexedFiles:files.length,archiveFiles:files.length+1,indexSha256:index.sha256,indexBytes:index.bytes,payloadBytes:files.reduce((n,x)=>n+x.bytes,0),totalArchiveBytes:files.reduce((n,x)=>n+x.bytes,0)+index.bytes,mappingRecords:mapping.length,copies:mapping.filter(x=>x.archivePath).length,originalBinaryHashOnly:mapping.filter(x=>!x.archivePath).length,privateArtifacts:privateArtifacts.length,allOriginalsUnchanged:true,audit:auditResult.summary};
 write(path.join(output,'completion.json'),enc(completion));console.log(JSON.stringify(completion,null,2));
}
main().catch(error=>{console.error(error.stack);process.exitCode=1;});
