@@ -0,0 +1,155 @@
+(function () {
+  'use strict';
+  var config = window.souiImeFunctionalConfig, doc = window.document;
+  if (!config || !/^[a-f0-9]{32}$/.test(config.run) || /^0+$/.test(config.run) ||
+      typeof config.apiReplay !== 'boolean') throw new Error('Explicit IME functional run required');
+  var input = doc.getElementById('test-input'), finish = doc.getElementById('finish'), phaseButton = doc.getElementById('phase');
+  var phaseName = doc.getElementById('phase-name'), statusNode = doc.getElementById('status'), summary = doc.getElementById('summary');
+  var events = [], checkpoints = [], phase = 'initial', overflow = false;
+  var disposed = false, submitted = false, submissionAttempt = 0, finalCheckpointAdded = false, origin, lastTime = 0;
+  if (!input || !finish || !phaseButton || !phaseName || !statusNode || !summary ||
+      !window.performance || typeof window.performance.now !== 'function') throw new Error('IME observation controls/clock unavailable');
+  origin = window.performance.now();
+  function status(text) { if (!disposed) statusNode.textContent = text; }
+  function failObservation(reason) { overflow = true; finish.disabled = true; phaseButton.disabled = true; status('记录无效：' + reason + '。请正常关窗，原生端不得认定通过。'); }
+  function now() {
+    var value = window.performance.now() - origin;
+    if (!isFinite(value) || value < lastTime || value < 0 || value > 180000) throw new Error('DOM clock invalid');
+    lastTime = value; return value;
+  }
+  function active() {
+    var value = doc.activeElement;
+    return !value ? 'none' : value === input ? 'test-input' : value === finish ? 'finish' :
+      value === phaseButton || value === phaseName ? 'phase' : 'other';
+  }
+  function snapshot() {
+    var value = input.value, start = input.selectionStart, end = input.selectionEnd, direction = input.selectionDirection;
+    if (typeof value !== 'string' || value.length > 128) throw new Error('test text limit');
+    if (start == null && end == null) { start = end = direction = null; }
+    else if (typeof start !== 'number' || typeof end !== 'number' || start % 1 || end % 1 || start < 0 || end < start || end > value.length ||
+        (direction !== 'forward' && direction !== 'backward' && direction !== 'none')) throw new Error('selection unavailable/invalid');
+    return {time_ms:now(), value:value, selection_start:start, selection_end:end, selection_direction:direction, active_element:active()};
+  }
+  function record(type, data) {
+    if (disposed || submitted || overflow) return null;
+    try {
+      if (events.length >= 96) throw new Error('event capacity');
+      if (data != null && (typeof data !== 'string' || data.length > 64)) throw new Error('event text limit');
+      var value = snapshot();
+      var row = {seq:events.length + 1, time_ms:value.time_ms, type:type, data:data == null ? null : data, value:value.value,
+        selection_start:value.selection_start, selection_end:value.selection_end, selection_direction:value.selection_direction,
+        active_element:value.active_element, phase:phase};
+      events.push(row); summary.textContent = '事件 ' + events.length + ' / 96；阶段 ' + phase + '；本框值：' + value.value +
+        '\nselection ' + value.selection_start + '..' + value.selection_end + ' / ' + value.selection_direction + '；active ' + value.active_element;
+      return row;
+    } catch (error) { failObservation(String(error && error.message || error)); return null; }
+  }
+  function checkpoint(name) {
+    if (checkpoints.length >= 4) { failObservation('checkpoint capacity'); return false; }
+    phase = name; var row = record('checkpoint', null);
