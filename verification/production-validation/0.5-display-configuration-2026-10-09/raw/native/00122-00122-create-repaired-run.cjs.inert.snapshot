'use strict';
const fs=require('node:fs'),path=require('node:path'),crypto=require('node:crypto');
const root='F:/work/sm05-scopes',prior=__dirname;
const out=path.join(root,'out/display-calibration-repaired-'+crypto.randomUUID());
const sha=bytes=>crypto.createHash('sha256').update(bytes).digest('hex');
const write=(name,value)=>fs.writeFileSync(path.join(out,name),typeof value==='string'||Buffer.isBuffer(value)?value:JSON.stringify(value,null,2)+'\n',{flag:'wx'});
fs.mkdirSync(out);fs.mkdirSync(path.join(out,'provider'));fs.mkdirSync(path.join(out,'consumer'));fs.mkdirSync(path.join(out,'frozen-sources'));
fs.copyFileSync(path.join(prior,'provider/owned-process.cjs'),path.join(out,'provider/owned-process.cjs'),fs.constants.COPYFILE_EXCL);
const previous=JSON.parse(fs.readFileSync(path.join(root,'out/display-calibration-validation-88094002-6a88-4ea0-91de-6be83902ef41/frozen-inputs-final.json')));
const sources=previous.sources.map((item,index)=>{const bytes=fs.readFileSync(path.join(root,item.relativePath));
 const snapshot='frozen-sources/'+index+'.inert.snapshot';write(snapshot,bytes);return{relativePath:item.relativePath,bytes:bytes.length,sha256:sha(bytes),snapshot};});
write('frozen-inputs-prebuild.json',{schema:previous.schema,baseline:previous.baseline,sources,
 priorFreezeSha256:sha(fs.readFileSync(path.join(root,'out/display-calibration-validation-88094002-6a88-4ea0-91de-6be83902ef41/frozen-inputs-final.json'))),
 nativeCompiled:false,actualDisplayCollected:false,physicalPresentation:false,releaseReady:false});
let driver=fs.readFileSync(path.join(prior,'run.cjs'),'utf8');
driver=driver.replace("path.join(root,'out/display-calibration-validation-88094002-6a88-4ea0-91de-6be83902ef41/frozen-inputs-final.json')","path.join(__dirname,'frozen-inputs-prebuild.json')");
driver=driver.replace("if (!['build','collect'].includes(phase))", "if (!['build','collect','pure'].includes(phase))");
driver=driver.replace("if(phase==='build') {", "if(phase==='pure') { const checked=await owned('pure',process.execPath,['--test',path.join(root,'tests/benchmark/display-calibration.test.cjs')],30000,2000); if(!checked.result.passed) throw new Error('Pure reader regression failed'); } else if(phase==='build') {");
driver=driver.replace("observedBy:'read-only Get-Process before isolated build'", "observedBy:'read-only Get-Process immediately before this repaired run setup'");
driver=driver.replace("'--parallel','2'", "'DisplaySystemDirectoryFixture','--parallel','2'");
driver=driver.replace("const exe=path.join(build,'Release/DisplayCalibration.exe');", "const fixture=path.join(build,'Release/DisplaySystemDirectoryFixture.exe'); const fixtureArtifact=pe(fixture,arch==='x64'?0x8664:0x14c); const fixtureResult=await owned('fixture-'+arch,fixture,[],10000,2000); if(!fixtureResult.result.passed) throw new Error('Directory fixture failed '+arch); write(path.join(__dirname,'fixture-'+arch+'.json'),{fixtureArtifact,testOnly:true,syntheticApiCases:true,result:fixtureResult.result}); const exe=path.join(build,'Release/DisplayCalibration.exe');");
write('run.cjs',driver);
let cmake=fs.readFileSync(path.join(prior,'consumer/CMakeLists.txt'),'utf8');
cmake+='\nadd_executable(DisplaySystemDirectoryFixture "'+path.join(out,'consumer/system-directory-fixture.cpp').replace(/\\/g,'/')+'")\n';
cmake+='target_compile_features(DisplaySystemDirectoryFixture PRIVATE cxx_std_17)\ntarget_compile_definitions(DisplaySystemDirectoryFixture PRIVATE WINVER=0x0601 _WIN32_WINNT=0x0601)\ntarget_compile_options(DisplaySystemDirectoryFixture PRIVATE /W4 /utf-8 /EHsc)\nset_property(TARGET DisplaySystemDirectoryFixture PROPERTY MSVC_RUNTIME_LIBRARY MultiThreadedDLL)\n';
write('consumer/CMakeLists.txt',cmake);
write('consumer/system-directory-fixture.cpp',String.raw`// TEST_ONLY authored API returns exercise the actual bounded directory helper.
// These are not Windows/API/OS acceptance. The collector runs separately.
#define main display_collector_main
#include "F:/work/sm05-scopes/benchmarks/protocol/display-calibration.cpp"
#undef main
#include <functional>
namespace {
using api=soui::benchmark::display::api;
std::wstring value;
enum class result_kind { valid, zero, embedded_nul, missing_nul, excessive, max_boundary, growing };
result_kind kind=result_kind::valid;
unsigned calls=0;
UINT WINAPI query(WCHAR* buffer,UINT size) {
  ++calls;
  if(kind==result_kind::zero) return 0;
  if(kind==result_kind::excessive) return 0xffffffffU;
  if(kind==result_kind::max_boundary) return 32768;
  if(kind==result_kind::growing) return size+1;
  if(kind==result_kind::embedded_nul) {buffer[0]=L'x';buffer[1]=0;buffer[2]=L'y';return 3;}
  if(kind==result_kind::missing_nul) {std::fill(buffer,buffer+size,L'x');return 1;}
  if(value.size()>=size) return static_cast<UINT>(value.size()+1);
  std::copy(value.begin(),value.end(),buffer);buffer[value.size()]=0;return static_cast<UINT>(value.size());
}
void require(bool condition,const char* message) {if(!condition) throw std::runtime_error(message);}
void denied(result_kind next,const char* expected) {
  kind=next;calls=0;
  try { (void)api::system_directory(&query); } catch(const std::runtime_error& error) {
    require(std::string(error.what())==expected,"Incorrect bounded failure"); return;
  }
  throw std::runtime_error("Invalid directory admitted");
}
}
int main() {
  try {
    kind=result_kind::valid;value=L"C:\\Windows\\SysWOW64";calls=0;
    require(api::system_directory(&query)==value&&calls==1,"Valid directory changed");
    value=std::wstring(300,L'a');calls=0;
    require(api::system_directory(&query)==value&&calls==2,"Required-size growth changed");
    value=std::wstring(32766,L'a');calls=0;
    require(api::system_directory(&query)==value&&calls==2,"Exact capacity ceiling changed");
    denied(result_kind::zero,"system-directory-unavailable");
    denied(result_kind::embedded_nul,"invalid-system-directory-result");
    denied(result_kind::missing_nul,"invalid-system-directory-result");
    denied(result_kind::excessive,"system-directory-limit");
    denied(result_kind::max_boundary,"system-directory-limit");
    denied(result_kind::growing,"system-directory-growth-limit");
    require(calls==3,"Directory growth exceeded its attempt bound");
    std::cout << "TEST_ONLY system-directory helper 9/9; synthetic API returns, not OS acceptance\n";
    return 0;
  } catch(const std::exception& error) {std::cerr << error.what() << '\n';return 1;}
}
`);
write('setup.json',{prior,cpp:sources[0].sha256,providerClient:sha(fs.readFileSync(path.join(out,'provider/owned-process.cjs'))),
 inputs:['run.cjs','consumer/CMakeLists.txt','consumer/system-directory-fixture.cpp'].map(name=>({name,sha256:sha(fs.readFileSync(path.join(out,name)))})),
 noProductionCmakeChanges:true,foreignProcessesUntouched:true});
console.log(out);
