    assert(ready && !readyError, 'Owned audit never published a valid ready identity');
    subject = native(directory, archivedFinished, {cwd: root, args, executable: tools[0], runner: tools[2], timeoutMs: inputs.timeoutMs, drainMs: inputs.drainMs});
    natural = true;
  } catch (error) { supervisionError = error.message; /* A generic failure remains failure. */ }
  const summary = {schema: 'soui.local-dispatch-audit-result/v1', rootExitCode: finished.exitCode,
    supervisorExitCode: finished.supervisorExitCode, genericPassed: finished.passed, closureConfirmed: finished.closureConfirmed,
    naturalClosure: natural, subject, vulnerabilities: auditJson?.metadata?.vulnerabilities || null,
    auditReportVersion: auditJson?.auditReportVersion || null, parseError, readyError, supervisionError,
    auditAccepted: natural && auditJson?.metadata?.vulnerabilities?.total === 0, reportSha256: finished.reportSha256,
    noInstall: true, noDependencyBuildClaim: true, noTailPolicy: true};
