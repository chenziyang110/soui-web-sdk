cmake_minimum_required(VERSION 3.24)
# This entry also verifies the actual source bytes before every build.
if(NOT DEFINED SOUI_DISTRIBUTION_ROOT OR SOUI_DISTRIBUTION_ROOT STREQUAL "")
  get_filename_component(SOUI_DISTRIBUTION_ROOT "${CMAKE_CURRENT_LIST_DIR}/../../../.." ABSOLUTE)
endif()
if(NOT IS_ABSOLUTE "${SOUI_DISTRIBUTION_ROOT}")
  message(FATAL_ERROR "legacy_drag: an absolute distribution root is required")
endif()
set(public_legacy_drag_payload_pins
  "legacy_drag_leaf_tests.cpp|10852|c9aa58c99d5eb2ba536d1e533ac803e8335a3e26007334d57bc7506a6ae938d0"
  "source-map.json|1532|09d0a5a13bad961a58ff4aa929e38f1f4b51b2fbb980298c13ef764a5646ac01"
  ".gitattributes|111|5780f6856e58fc66e7e3760ba9a9795514847b2f11de5acfa28edd079b9680aa"
)
foreach(record IN LISTS public_legacy_drag_payload_pins)
  string(REPLACE "|" ";" fields "${record}")
  list(GET fields 0 relative)
  list(GET fields 1 expected_bytes)
  list(GET fields 2 expected_sha)
  set(input "${CMAKE_CURRENT_LIST_DIR}/${relative}")
  file(SIZE "${input}" actual_bytes)
  file(SHA256 "${input}" actual_sha)
  if(NOT actual_bytes EQUAL expected_bytes OR NOT actual_sha STREQUAL expected_sha)
    message(FATAL_ERROR "legacy_drag: payload bytes changed: ${relative}")
  endif()
endforeach()
file(READ "${CMAKE_CURRENT_LIST_DIR}/source-map.json" source_map)
foreach(key IN ITEMS drag check)
  string(JSON relative GET "${source_map}" sources ${key} relative)
  set(${key}_input "${SOUI_DISTRIBUTION_ROOT}/${relative}")
  string(JSON expected_bytes GET "${source_map}" sources ${key} bytes)
  string(JSON expected_sha GET "${source_map}" sources ${key} sha256)
  file(SIZE "${${key}_input}" actual_bytes)
  file(SHA256 "${${key}_input}" actual_sha)
  if(NOT actual_bytes EQUAL expected_bytes OR NOT actual_sha STREQUAL expected_sha)
    message(FATAL_ERROR "legacy_drag: actual source bytes changed: ${relative}")
  endif()
  file(READ "${${key}_input}" ${key}_hex HEX)
  string(TOLOWER "${${key}_hex}" ${key}_hex)
endforeach()
set(fixture "${CMAKE_CURRENT_LIST_DIR}/legacy_drag_leaf_tests.cpp")
file(READ "${fixture}" fixture_hex HEX)
string(TOLOWER "${fixture_hex}" fixture_hex)
string(JSON range_count LENGTH "${source_map}" ranges)
if(NOT range_count EQUAL 3)
  message(FATAL_ERROR "legacy_drag: the three actual byte intervals are required")
endif()
foreach(index RANGE 0 2)
  foreach(field IN ITEMS source sourceStart sourceEnd fixtureStart fixtureEnd bytes)
    string(JSON ${field} GET "${source_map}" ranges ${index} ${field})
  endforeach()
  if(NOT source STREQUAL "drag" AND NOT source STREQUAL "check")
    message(FATAL_ERROR "legacy_drag: unknown interval source")
  endif()
  math(EXPR source_offset "${sourceStart} * 2")
  math(EXPR fixture_offset "${fixtureStart} * 2")
  math(EXPR source_length "(${sourceEnd} - ${sourceStart}) * 2")
  math(EXPR fixture_length "(${fixtureEnd} - ${fixtureStart}) * 2")
  math(EXPR expected_length "${bytes} * 2")
  if(source_length LESS_EQUAL 0 OR NOT source_length EQUAL fixture_length OR NOT source_length EQUAL expected_length)
    message(FATAL_ERROR "legacy_drag: invalid byte interval ${index}")
  endif()
  string(SUBSTRING "${${source}_hex}" ${source_offset} ${source_length} source_body)
  string(SUBSTRING "${fixture_hex}" ${fixture_offset} ${fixture_length} fixture_body)
  if(NOT source_body STREQUAL fixture_body)
    message(FATAL_ERROR "legacy_drag: fixture differs from actual source interval ${index}")
  endif()
endforeach()
if(SOUI_VENDOR_LIFETIME_VERIFY_ONLY)
  return()
endif()
if(CMAKE_SOURCE_DIR STREQUAL CMAKE_CURRENT_SOURCE_DIR)
  project(SouiVendorLegacyDragTests LANGUAGES CXX)
  enable_testing()
endif()
if(NOT WIN32 OR NOT MSVC)
  message(FATAL_ERROR "Vendor legacy drag regressions require Windows and MSVC")
endif()
foreach(input IN ITEMS "${drag_input}" "${check_input}" "${fixture}" "${CMAKE_CURRENT_LIST_DIR}/source-map.json")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${input}")
endforeach()
add_custom_target(soui_vendor_legacy_drag_leaf_tests_source_bytes
  COMMAND "${CMAKE_COMMAND}" "-DSOUI_VENDOR_LIFETIME_VERIFY_ONLY=ON"
    "-DSOUI_DISTRIBUTION_ROOT=${SOUI_DISTRIBUTION_ROOT}"
    -P "${CMAKE_CURRENT_LIST_FILE}" VERBATIM)
add_executable(soui_vendor_legacy_drag_leaf_tests legacy_drag_leaf_tests.cpp)
target_compile_features(soui_vendor_legacy_drag_leaf_tests PRIVATE cxx_std_17)
target_compile_options(soui_vendor_legacy_drag_leaf_tests PRIVATE /EHsc /utf-8 /W4)
target_compile_definitions(soui_vendor_legacy_drag_leaf_tests PRIVATE UNICODE _UNICODE NOMINMAX WINVER=0x0601 _WIN32_WINNT=0x0601)
set_property(TARGET soui_vendor_legacy_drag_leaf_tests PROPERTY MSVC_RUNTIME_LIBRARY MultiThreadedDLL)
target_link_libraries(soui_vendor_legacy_drag_leaf_tests PRIVATE user32)
add_dependencies(soui_vendor_legacy_drag_leaf_tests soui_vendor_legacy_drag_leaf_tests_source_bytes)
foreach(case IN ITEMS task-allocation-fails synchronous-success synchronous-consumer-fails)
  add_test(NAME kernel.native.lifetime.legacy_drag-${case} COMMAND soui_vendor_legacy_drag_leaf_tests "${case}")
  set_tests_properties(kernel.native.lifetime.legacy_drag-${case} PROPERTIES TIMEOUT 10)
endforeach()
