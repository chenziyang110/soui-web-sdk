$cmake=(Get-Command cmake.exe -ErrorAction Stop).Source
$args=@(Get-SouiCMakeConfigureArguments -CMake $cmake -WorkspaceRoot $workspaceRoot -SourceDirectory $consumerSource -BuildDirectory $consumerBuild -Architecture 'x86')
