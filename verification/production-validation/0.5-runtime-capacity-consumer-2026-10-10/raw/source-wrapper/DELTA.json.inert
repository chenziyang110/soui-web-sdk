      "spans": [
        {
          "purpose": "describe actual supervisor substitution",
          "before": "This is a fresh Root-only test protocol for Debug/Release × x64/Win32. It does not change production SDK or consumer source, telemetry settings, the original 4640-byte driver, the Owned client/runner, or owned-tail-evidence.cjs.",
          "after": "This is a fresh Root-only test protocol for Debug/Release × x64/Win32. It preserves production SDK and consumer source, telemetry settings, the original 4640-byte driver, the Owned client and owned-tail-evidence.cjs. This derivative selects an existing supported supervisor binary; the consumer driver, binding algorithm and policy remain the parent raw bytes.",
          "count": 1,
          "beforeByteOffsets": [
            50
          ],
          "beforeWhole": {
            "bytes": 3386,
            "sha256": "1a4d3fa9147885984124c5a2a9049774ce9596b52e109d0c40b5f89854a96eaa"
