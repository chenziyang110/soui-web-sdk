'use strict';
const fs=require('node:fs'), path=require('node:path'), crypto=require('node:crypto');
const cwd=path.resolve(__dirname,'../..'), client=path.join(cwd,'tools/internal/owned-process.cjs');
const {launchOwned}=require(client);
const runner='F:/work/sm05/out/benchmark-protocol/Release/OwnedProcessRunner.exe';
const root=path.join(__dirname,'native-'+crypto.randomUUID());fs.mkdirSync(root);
fs.copyFileSync(__filename,path.join(root,'harness.cjs'));
const hash=b=>crypto.createHash('sha256').update(b).digest('hex');
const inputs=['benchmarks/protocol/run-one.cjs','benchmarks/protocol/check-pair-runs.cjs',
 'benchmarks/protocol/owned-trace-subject.cjs','benchmarks/protocol/summarize-series.cjs',
 'benchmarks/protocol/check-run-traces.cjs','benchmarks/protocol/trace-identity.h',
 'benchmarks/protocol/process-tree-sampler.cpp','benchmarks/protocol/input-trace.cpp',
 'benchmarks/protocol/CMakeLists.txt','tests/benchmark/native-trace-identity.cpp',
 'tests/benchmark/run-one-cleanup.test.cjs','tests/benchmark/owned-trace-subject.test.cjs',
 'tests/benchmark/process-tree-sampler.test.cjs','tests/benchmark/run-traces.test.cjs',
 'tests/benchmark/series-summary.test.cjs','tests/benchmark/pair-preflight.test.cjs'];
function identity(file){const bytes=fs.readFileSync(file);let coff=null;
 if(bytes[0]===77&&bytes[1]===90){const pe=bytes.readUInt32LE(60);if(bytes.toString('latin1',pe,pe+4)==='PE\0\0')coff=bytes.readUInt16LE(pe+4);}
 return {path:file,bytes:bytes.length,sha256:hash(bytes),coff};}
const source=inputs.map(name=>({...identity(path.join(cwd,name)),path:name}));
const env={...process.env,MSBUILDDISABLENODEREUSE:'1',PSModulePath:'C:/Windows/system32/WindowsPowerShell/v1.0/Modules'};
const tools={client:identity(client),runner:identity(runner),node:identity(process.execPath)};
const exes=[];for(const arch of ['x86','x64'])for(const name of ['ProcessTreeSampler','InputTrace','NativeTraceIdentity'])
 exes.push({arch,name,...identity(`F:/work/sm05-measure/out/collector-${arch}/Release/${name}.exe`)});
fs.writeFileSync(path.join(root,'inputs.json'),JSON.stringify({baseline:'2154ed80',source,tools,exes,
 localEnvironment:{MSBUILDDISABLENODEREUSE:'1',PSModulePath:env.PSModulePath}},null,2)+'\n');
const results=[];
(async()=>{for(const arch of ['x86','x64']){
 const folder=path.join(root,arch);fs.mkdirSync(folder);
 const target=`F:/work/sm05-measure/out/collector-${arch}/Release`;
 const args=['--test','tests/benchmark/run-traces.test.cjs','tests/benchmark/run-one-cleanup.test.cjs',
 'tests/benchmark/process-tree-sampler.test.cjs','tests/benchmark/owned-trace-subject.test.cjs',
 'tests/benchmark/pair-preflight.test.cjs','tests/benchmark/series-summary.test.cjs'];
 const owned=launchOwned(process.execPath,args,{runner,cwd,timeoutMs:90000,drainMs:3000,
  report:path.join(folder,'owned.ndjson'),stdout:'pipe',stderr:'pipe',env:{...env,
  PROCESS_TREE_SAMPLER_EXE:target+'/ProcessTreeSampler.exe',BENCHMARK_INPUT_TRACE_EXE:target+'/InputTrace.exe',
  BENCHMARK_IDENTITY_FIXTURE_EXE:target+'/NativeTraceIdentity.exe',BENCHMARK_OWNED_CLIENT:client,
  BENCHMARK_OWNED_RUNNER_EXE:runner}});
 const out=[],err=[];owned.child.stdout.on('data',b=>out.push(b));owned.child.stderr.on('data',b=>err.push(b));
 const ready=await owned.ready;const finished=await owned.finished;
 const stdout=Buffer.concat(out),stderr=Buffer.concat(err);
 fs.writeFileSync(path.join(folder,'stdout.bin'),stdout);fs.writeFileSync(path.join(folder,'stderr.bin'),stderr);
 fs.writeFileSync(path.join(folder,'finished.json'),JSON.stringify(finished,null,2)+'\n');
 const artifacts=['owned.ndjson','owned.ndjson.context.json','stdout.bin','stderr.bin','finished.json'].map(name=>identity(path.join(folder,name)));
 const text=stdout.toString();const pass=finished.passed && /(?:# |ℹ )fail 0/.test(text) && /(?:# |ℹ )skipped 0/.test(text);
 results.push({arch,args,ready,finished,pass,artifacts});console.log(JSON.stringify({arch,pass,code:finished.exitCode,
 reason:finished.terminal?.reason,active:finished.terminal?.activeProcesses,root}));
 if(!pass)throw new Error('Native integration suite failed '+arch);
 }
 for(const entry of source){if(identity(path.join(cwd,entry.path)).sha256!==entry.sha256)throw new Error('Source changed during validation: '+entry.path);}
 for(const entry of exes){if(identity(entry.path).sha256!==entry.sha256)throw new Error('Reused EXE changed during validation');}
 fs.writeFileSync(path.join(root,'summary.json'),JSON.stringify({passed:true,results,noDesktop:true,noSendInput:true,
 sourceAfterMatches:true,noBuild:true},null,2)+'\n');
})().catch(error=>{fs.writeFileSync(path.join(root,'failure.json'),JSON.stringify({error:error.stack,results},null,2)+'\n');
 console.error(error.stack);process.exitCode=1;});
