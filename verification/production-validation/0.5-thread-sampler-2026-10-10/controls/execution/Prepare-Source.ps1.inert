$taskDriver=Pin (Join-Path $taskRoot 'run-root.cjs')
if($taskDriver.bytes-ne4640-or$taskDriver.sha256-cne'139b305e97e075ab45793999785f05bccc0ec6e47b66498ac86054ee0bb1c350'){throw 'Strict driver differs'}
$taskCompilerOriginal=Join-Path $taskRepo 'out/live-capacity-integration-root-3350b8e9-52e6-4826-96fa-db82d6d457bf/fixed-compiler.cmake'
$taskCompilerText=[IO.File]::ReadAllText($taskCompilerOriginal)
$taskOld='v143,host=x64,version=14.44.35207';$taskNew='v143,version=14.44.35207,host=x64'
if([regex]::Matches($taskCompilerText,[regex]::Escape($taskOld)).Count-ne1){throw 'Compiler string unique span differs'}
[IO.File]::WriteAllText((Join-Path $taskRoot 'fixed-compiler.cmake'),$taskCompilerText.Replace($taskOld,$taskNew),$taskUtf8)
$taskCompiler=Pin (Join-Path $taskRoot 'fixed-compiler.cmake')
