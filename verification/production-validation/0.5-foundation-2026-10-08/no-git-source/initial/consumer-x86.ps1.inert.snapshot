$ErrorActionPreference='Stop'
. 'F:\work\soui-05-source-validation-b68cc42e-ad9c-49a7-8e5b-20ac5ef05a12\relocated-source\tools\internal\CMake-Configure.ps1'
$workspaceRoot='F:\work\soui-05-source-validation-b68cc42e-ad9c-49a7-8e5b-20ac5ef05a12\relocated-source'
$consumerSource='F:\work\soui-05-source-validation-b68cc42e-ad9c-49a7-8e5b-20ac5ef05a12\external-consumer-source-x86'
