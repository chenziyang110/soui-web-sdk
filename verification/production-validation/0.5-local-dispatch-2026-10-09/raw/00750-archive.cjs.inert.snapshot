      assert.equal(binaryMagic(b), 'DOS/PE-image'); assert.equal(b.readUInt32LE(b.readUInt32LE(60)), 0x4550);
      assert.equal(b.readUInt16LE(b.readUInt32LE(60) + 4), item.architecture === 'x64' ? 0x8664 : 0x14c);
