const cmake = 'C:/Program Files/CMake/bin/cmake.exe', ctest = 'C:/Program Files/CMake/bin/ctest.exe';
const vs = 'C:/Program Files/Microsoft Visual Studio/2022/Community';
const msvc = path.join(vs, 'VC/Tools/MSVC/14.44.35207');
const sdk = 'C:/Program Files (x86)/Windows Kits/10';
const toolPaths = [process.execPath, runner, client, cmake, ctest,
  path.join(root, 'tools/internal/delivery-identity.cjs'), path.join(root, 'tools/internal/CMake-Configure.ps1'),
  path.join(vs, 'MSBuild/Current/Bin/MSBuild.exe'), path.join(vs, 'MSBuild/Current/Bin/amd64/MSBuild.exe'),
  ...['x64', 'x86'].flatMap(arch => ['cl.exe', 'link.exe', 'lib.exe'].map(name => path.join(msvc, 'bin/Hostx64', arch, name)))];
const tools = toolPaths.map(file);
const base = identity.safePath(__dirname, 'actual-' + crypto.randomUUID());
fs.mkdirSync(base, {recursive: false});
function write(name, value) {
  fs.writeFileSync(identity.safePath(base, name), Buffer.isBuffer(value) ? value : encode(value), {flag: 'wx'});
}
function walk(directory) {
  need(!fs.lstatSync(directory).isSymbolicLink(), 'Linked directory: ' + directory);
  return fs.readdirSync(directory, {withFileTypes: true}).sort((a, b) => a.name.localeCompare(b.name)).flatMap(entry => {
    const full = path.join(directory, entry.name), stat = fs.lstatSync(full);
    need(!stat.isSymbolicLink(), 'Linked file: ' + full);
    return stat.isDirectory() ? walk(full) : stat.isFile() ? [full] : [];
  });
}
const testNames = ['sdk_contract', 'action_contract', 'session_renewal', 'task_service', 'task_store_capacity',
  'task_scope', 'task_operation_query', 'local_authorization', 'local_action_dispatch', 'local_task_family'];
const targets = testNames.map(name => 'soui_' + name + '_tests').concat('soui_local_task_family_prepare_tests');
const testPattern = '^sdk\\.native\\.(contract|action-contract|session-renewal|task-service|task-store-capacity|task-scope|task-operation-query|local-authorization|local-action-dispatch|local-task-family|local-task-family-prepare)$';
const source = identity.source(root), rawSource = identity.snapshot(root, source.files.map(row => row.path));
const inputNames = source.files.filter(row => row.path.startsWith('sdk/include/') || row.path.startsWith('sdk/src/') ||
  row.path.startsWith('cmake/') || ['CMakeLists.txt', 'VERSION', 'sdk/CMakeLists.txt', 'sdk/cmake/SouiSdkConfig.cmake.in',
    'tools/runtime-doctor/CMakeLists.txt', 'tests/native/CMakeLists.txt', 'third_party/include/json/json.hpp',
    ...testNames.map(name => 'tests/native/' + name + '_tests.cpp')].includes(row.path)).map(row => row.path);
const actualInputs = identity.snapshot(root, inputNames);
// Hash-only prelaunch inventory covers vendor headers/libraries read by the
