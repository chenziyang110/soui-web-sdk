  assert.deepEqual(identity.snapshot(root, frozen.rawSource.files.map(f => f.path)), frozen.rawSource); assert.equal(frozen.rawSource.sha256, expected.raw);
  assert.deepEqual(identity.snapshot(root, frozen.actualInputs.files.map(f => f.path)), frozen.actualInputs);
  assert.equal(frozen.actualInputs.sha256, expected.nativeInputs);
  const sourceMap = json(path.join(original, 'source-raw-map.json')); assert.equal(sourceMap.length, frozen.actualInputs.files.length);
  const sourceSeen = new Set(); for (const row of sourceMap) {
    assert(!sourceSeen.has(row.path)); sourceSeen.add(row.path); assert(row.archive.endsWith('.inert.snapshot'));
    const input = frozen.actualInputs.files.find(x => x.path === row.path); assert(input); assert.equal(row.sha256, input.sha256); assert.equal(row.bytes, input.bytes);
    check(bounded(original, row.archive), input);
  }
  for (const item of frozen.tools) repin(item);
  const environment = json(path.join(original, 'environment-guard.json'));
  assert(environment.valuesNeverWritten && environment.parentEnvironmentUnchanged && environment.binlogsPrivateOnly);
  assert.deepEqual(environment.childCredentialLikeNames, []);
  const jobs = [];
  for (const record of results.records) {
    const dir = bounded(original, record.directory), inputs = json(path.join(dir, 'inputs.json')), finished = json(path.join(dir, 'finished.json'));
    assert.deepEqual(record.summary, finished); assert.equal(inputs.sourceSha256, expected.source);
    for (const item of [inputs.executable, inputs.runner, inputs.client]) repin(item);
    const subject = native(dir, finished, inputs);
    assert.equal(hash(read(path.join(dir, 'stdout.bin'))), finished.stdoutSha256);
    assert.equal(hash(read(path.join(dir, 'stderr.bin'))), finished.stderrSha256);
    jobs.push({name: record.name, ...subject});
  }
  const counts = [];
  for (const arch of ['x64', 'x86']) {
    const ctest = read(path.join(original, 'ctest-' + arch, 'stdout.bin')).toString('utf8');
    const complete = /100% tests passed, 0 tests failed out of (\d+)/.exec(ctest); assert(complete);
    const count = Number(complete[1]); assert.equal(count, results.selectedTestsPerArchitecture);
    const passedNames = [...ctest.matchAll(/Test\s+#\d+:\s+(\S+)\s+\.{2,}.*?Passed/g)].map(x => x[1]);
    assert.equal(passedNames.length, count); assert.equal(new Set(passedNames).size, count);
    assert(passedNames.includes('sdk.native.local-action-dispatch') && passedNames.includes('sdk.native.local-authorization'));
    const cases = read(path.join(original, 'dispatch-cases-' + arch, 'stdout.bin')).toString('utf8');
    const names = cases.trim().split(/\r?\n/); assert(names.every(x => x.startsWith('PASS ')));
    assert.equal(names.length, results.localDispatchCasesPerArchitecture); assert.equal(new Set(names).size, names.length);
    counts.push({architecture: arch, ctestCount: count, ctestNames: passedNames, directCases: names.length});
    const build = path.join(original, 'b-' + arch), cache = read(path.join(build, 'CMakeCache.txt')).toString('utf8');
    assert(cache.includes('CMAKE_HOME_DIRECTORY:INTERNAL=' + root));
    assert(cache.includes('CMAKE_GENERATOR_PLATFORM:INTERNAL=' + (arch === 'x64' ? 'x64' : 'Win32') + ',version=10.0.19041.0'));
    assert(cache.includes('CMAKE_GENERATOR_TOOLSET:INTERNAL=v143,version=14.44.35207,host=x64'));
    for (const output of results.outputs.filter(o => o.architecture === arch && /\.exe$/i.test(o.path))) {
      const project = path.join(build, 'tests/native', path.basename(output.path, '.exe') + '.vcxproj'), text = read(project).toString('utf8');
      assert(text.includes('<WindowsTargetPlatformVersion>10.0.19041.0</WindowsTargetPlatformVersion>'));
      assert(text.includes('<PlatformToolset>v143</PlatformToolset>'));
