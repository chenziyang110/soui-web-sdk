$taskUtf8=[Text.UTF8Encoding]::new($false)
function Pin([string]$taskPath){$taskFile=Get-Item -LiteralPath $taskPath -Force;if($taskFile.PSIsContainer-or($taskFile.Attributes-band[IO.FileAttributes]::ReparsePoint)){throw 'Not plain file'};[ordered]@{path=$taskFile.FullName.Replace('\','/');bytes=$taskFile.Length;sha256=(Get-FileHash -LiteralPath $taskPath -Algorithm SHA256).Hash.ToLowerInvariant()}}
function Json([string]$taskName,$taskValue){$taskPath=Join-Path $taskRoot $taskName;if(Test-Path -LiteralPath $taskPath){throw 'Output already exists'};[IO.File]::WriteAllText($taskPath,($taskValue|ConvertTo-Json -Depth 16)+[char]10,$taskUtf8)}
